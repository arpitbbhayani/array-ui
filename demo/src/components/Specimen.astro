---
import Card from "../../../src/astro/Card.astro";

interface Props {
  id: string;
  name: string;
  description?: string;
  shadcnName?: string;
  usage?: string;
  reactUsage?: string;
  astroUsage?: string;
  shadcnUsage?: string;
  span?: 1 | 2;
  tone?: "default" | "page";
  className?: string;
}

const {
  id,
  name,
  description,
  shadcnName,
  usage,
  reactUsage = usage,
  astroUsage,
  shadcnUsage,
  span = 1,
  tone = "default",
  className = "",
} = Astro.props;

// Strip HTML wrapper tags if needed for raw string
const derivedHtml = usage
  ? usage
      .replace(/<([A-Z][A-Za-z0-9]*)/g, "<div class=\"aui-$1\"")
      .toLowerCase()
  : "";
---

<section class={`aui-stack aui-stack-xs ${span === 2 ? "spec-wide" : ""} ${className}`} id={id} style="min-width: 0;">
  <header class="aui-row-between" style="margin-bottom: 0.25rem;">
    <div class="aui-row aui-row-xs">
      <h3 class="aui-h3" style="font-size: 0.95rem;">{name}</h3>
      <a href={`#${id}`} class="aui-font-mono" style="font-size: 0.8rem; color: var(--aui-text-muted); opacity: 0.4; text-decoration: none;">#</a>
    </div>

    <div class="aui-row aui-row-xs" style="gap: 0.35rem;">
      {usage && (
        <button
          type="button"
          class="aui-btn aui-btn-secondary aui-btn-sm aui-font-mono spec-toggle-btn"
          style="font-size: 0.72rem; padding: 0.15rem 0.55rem; height: auto; display: inline-flex; align-items: center; gap: 0.35rem;"
          title="View and copy code"
          onclick={`
            const root = this.closest('section');
            const bar = root.querySelector('.spec-usage-bar');
            if (!bar) return;
            const isHidden = bar.style.display === 'none' || getComputedStyle(bar).display === 'none';
            bar.style.display = isHidden ? 'flex' : 'none';
            this.classList.toggle('is-active', isHidden);
            const label = this.querySelector('.spec-toggle-label');
            if (label) label.textContent = isHidden ? 'Hide Code' : 'Code';
          `}
        >
          <span style="font-size: 0.72rem; opacity: 0.8;">&lt;/&gt;</span>
          <span class="spec-toggle-label">Code</span>
        </button>
      )}

      {shadcnName && (
        <a
          href={`/r/${shadcnName}.json`}
          target="_blank"
          class="aui-btn aui-btn-secondary aui-btn-sm aui-font-mono"
          style="font-size: 0.7rem; padding: 0.15rem 0.4rem; height: auto;"
          title={`View schema: /r/${shadcnName}.json`}
        >
          JSON
        </a>
        <button
          type="button"
          class="aui-btn aui-btn-secondary aui-btn-sm aui-font-mono"
          style="font-size: 0.72rem; padding: 0.15rem 0.5rem; height: auto;"
          title={`Copy CLI command: npx shadcn@latest add @aui/${shadcnName}`}
          onclick={`navigator.clipboard.writeText('npx shadcn@latest add @aui/${shadcnName}'); const t=this.querySelector('.spec-shadcn-btn-text'); if(t) t.textContent='Copied!'; setTimeout(() => { if(t) t.textContent='add @aui/${shadcnName}'; }, 1600);`}
        >
          <span>⚡</span>
          <code class="spec-shadcn-btn-text" style="font-family: inherit; border: none; background: transparent; padding: 0;">add @aui/{shadcnName}</code>
        </button>
      )}
    </div>
  </header>
  {description && <p class="aui-editorial-sub" style="margin: 0; font-size: 0.88rem;">{description}</p>}

  <Card hoverable={false} style={tone === "page" ? "padding: 0; overflow: hidden; background-color: var(--aui-bg-primary);" : "padding: 1.1rem 1.25rem; background-color: var(--aui-bg-secondary);"}>
    <slot />
  </Card>

  {usage && (
    <div
      class="spec-usage-bar aui-stack aui-stack-xs"
      style="display: none; background-color: var(--aui-code-bg); border: 1px solid var(--aui-border-color); border-radius: var(--aui-radius-md); padding: 0.6rem 0.85rem; gap: 0.45rem; min-width: 0; margin-top: 0.5rem;"
      data-nextjs={reactUsage}
      data-react={reactUsage}
      data-astro={astroUsage}
      data-html={derivedHtml || usage}
      data-shadcn={shadcnUsage || reactUsage}
    >
      <div class="aui-row-between" style="width: 100%; border-bottom: 1px solid var(--aui-border-color); padding-bottom: 0.35rem;">
        <span class="aui-font-mono" style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--aui-text-muted);">Usage Snippet</span>
        <div class="aui-row aui-row-xs" style="gap: 0.35rem;">
          <button
            type="button"
            class="aui-btn aui-btn-secondary aui-btn-sm spec-copy-btn aui-font-mono"
            style="padding: 0.18rem 0.55rem; height: auto; font-size: 0.72rem; display: inline-flex; align-items: center; gap: 0.35rem;"
            title="Copy snippet"
            data-usage={reactUsage}
            onclick={`navigator.clipboard.writeText(this.dataset.usage); const orig=this.innerHTML; this.innerHTML='<span style=\"color:var(--aui-success);\">✓</span> Copied!'; setTimeout(() => this.innerHTML=orig, 1600);`}
          >
            <span>⎘</span>
            <span>Copy Code</span>
          </button>
          <button
            type="button"
            class="aui-btn aui-btn-ghost aui-btn-sm aui-font-mono"
            style="padding: 0.18rem 0.4rem; height: auto; font-size: 0.72rem; color: var(--aui-text-muted);"
            title="Close code preview"
            onclick={`
              const root = this.closest('section');
              const bar = root.querySelector('.spec-usage-bar');
              if (bar) bar.style.display = 'none';
              const btn = root.querySelector('.spec-toggle-btn');
              if (btn) {
                btn.classList.remove('is-active');
                const label = btn.querySelector('.spec-toggle-label');
                if (label) label.textContent = 'Code';
              }
            `}
          >
            ✕
          </button>
        </div>
      </div>
      <pre
        class="spec-code-pre"
        style="margin: 0; padding: 0.4rem 0 0.2rem 0; background: transparent; border: none; box-shadow: none; overflow-x: auto; max-height: 260px; overflow-y: auto; flex-grow: 1; white-space: pre; font-family: var(--aui-font-mono); font-size: 0.84rem; line-height: 1.6; color: var(--aui-code-text);"
      ><code class="spec-code-text" style="font-family: inherit; color: inherit; background: transparent;">{reactUsage}</code></pre>
    </div>
  )}
</section>
