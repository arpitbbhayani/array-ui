---
import Card from "../../../src/astro/Card.astro";
import Badge from "../../../src/astro/Badge.astro";
import PingStatus from "../../../src/astro/PingStatus.astro";
import Button from "../../../src/astro/Button.astro";
import Terminal from "../../../src/astro/Terminal.astro";
import Toast from "../../../src/astro/Toast.astro";
---

<Card className="aui-stack aui-stack-sm" hoverable={false}>
  <div slot="header" class="aui-row-between" style="border-bottom: 1px solid var(--aui-border-color); padding-bottom: 0.6rem;">
    <div class="aui-row aui-row-sm">
      <span style="width: 7px; height: 7px; border-radius: 50%; background-color: var(--aui-primary); display: inline-block;"></span>
      <span class="aui-font-mono" style="font-size: 0.78rem; font-weight: 600; color: var(--aui-text-secondary);">~/production/telemetry</span>
    </div>
    <PingStatus status="operational" size="sm" label="16/16 Live" />
  </div>

  <div class="aui-grid aui-grid-cols-4" style="gap: 0.5rem; background-color: var(--aui-bg-secondary); padding: 0.6rem 0.85rem; border: 1px solid var(--aui-border-color); border-radius: var(--aui-radius-sm);">
    <div class="aui-stack" style="gap: 0.2rem;">
      <span class="aui-font-mono" style="font-size: 0.72rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--aui-text-muted);">Service</span>
      <span style="font-size: 0.88rem; font-weight: 600; color: var(--aui-text-secondary);">edge-gateway</span>
    </div>
    <div class="aui-stack" style="gap: 0.2rem;">
      <span class="aui-font-mono" style="font-size: 0.72rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--aui-text-muted);">Region</span>
      <span style="font-size: 0.88rem; font-weight: 600; color: var(--aui-text-secondary);">us-east-1</span>
    </div>
    <div class="aui-stack" style="gap: 0.2rem;">
      <span class="aui-font-mono" style="font-size: 0.72rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--aui-text-muted);">Latency</span>
      <span style="font-size: 0.88rem; font-weight: 600; color: var(--aui-text-secondary);"><strong style="color: var(--aui-text-primary);">14ms</strong> p99</span>
    </div>
    <div class="aui-stack" style="gap: 0.2rem;">
      <span class="aui-font-mono" style="font-size: 0.72rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--aui-text-muted);">Status</span>
      <div><Badge variant="green">Healthy</Badge></div>
    </div>
  </div>

  <Terminal
    title="bash"
    lines={[
      "kubectl get pods -n prod",
      { text: "pod/api-gateway-7f9    1/1 Running   42ms p99", kind: "ok" },
      { text: "pod/ledger-engine-01   1/1 Running   14ms p99", kind: "ok" },
      { text: "mesh: 16 edge nodes active · 0 errors", kind: "out" }
    ]}
  />

  <div class="aui-row" style="margin-top: 0.25rem;">
    <Button variant="primary" size="sm" id="hero-btn-deploy">Deploy canary</Button>
    <Button variant="secondary" size="sm" id="hero-btn-rollback">Rollback</Button>
  </div>

  <div id="hero-toast-wrap" style="display: none; margin-top: 0.5rem;">
    <Toast id="hero-toast" variant="success" title="Canary Deployed" description="All 16 nodes report healthy telemetry" />
  </div>
</Card>

<script>
  let toastTimer: number | null = null;

  function showToast(title: string, desc: string, variant: "success" | "info" = "success") {
    const wrap = document.getElementById("hero-toast-wrap");
    const toast = document.getElementById("hero-toast");
    if (!wrap || !toast) return;

    const tTitle = toast.querySelector(".aui-toast-title");
    const tDesc = toast.querySelector(".aui-toast-desc");
    if (tTitle) tTitle.textContent = title;
    if (tDesc) tDesc.textContent = desc;

    wrap.style.display = "block";

    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      wrap.style.display = "none";
    }, 2400);
  }

  document.getElementById("hero-btn-deploy")?.addEventListener("click", () => {
    showToast("Canary Deployed", "16 nodes updated with zero packet drop", "success");
  });

  document.getElementById("hero-btn-rollback")?.addEventListener("click", () => {
    showToast("Rollback requested", "Routing traffic back to previous release snapshot", "info");
  });
</script>
