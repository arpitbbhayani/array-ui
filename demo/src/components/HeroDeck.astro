---
import Button from "../../../src/astro/Button.astro";
import Badge from "../../../src/astro/Badge.astro";
import PingStatus from "../../../src/astro/PingStatus.astro";
import Kbd from "../../../src/astro/Kbd.astro";

const snippet = `<div class="cluster-card">
  <div class="header">
    <PingStatus status="operational" label="Operational" />
    <Badge variant="light">v0.1.0</Badge>
  </div>
  
  <div class="controls">
    <Switch label="Auto-scaling" defaultChecked />
    <Checkbox label="Edge SSR" defaultChecked />
  </div>

  <Input placeholder="Search tokens..." shortcut="⌘K" />

  <Button variant="primary">Deploy canary</Button>
</div>`;
---

<div class="aui-hero-deck aui-corner-ticks" id="aui-hero-deck">
  {/* Deck Header */}
  <div class="aui-deck-header">
    <div class="aui-deck-dots" style="font-family:var(--aui-font-mono);font-size:0.75rem;font-weight:700;color:var(--aui-primary);letter-spacing:0.06em;display:flex;align-items:center;gap:0.35rem;">
      <span style="display:inline-block;width:6px;height:6px;background-color:var(--aui-primary);border-radius:1px;"></span>
      <span>[00]//SYS_CANVAS</span>
    </div>
    <div class="aui-deck-tabs">
      <button type="button" class="aui-deck-tab is-active" id="hero-tab-preview" data-deck-tab="preview">
        Interactive UI
      </button>
      <button type="button" class="aui-deck-tab" id="hero-tab-code" data-deck-tab="code">
        Generated Code
      </button>
    </div>
    <div class="aui-deck-status">
      <PingStatus status="operational" size="sm" label="Live" />
    </div>
  </div>

  {/* Mode 1: Interactive Live Canvas */}
  <div class="aui-deck-canvas" id="hero-view-preview">
    {/* Top Status & Metrics Strip */}
    <div class="aui-deck-status-strip">
      <div class="aui-deck-meta-left">
        <span class="aui-deck-title">Production Mesh</span>
        <Badge variant="light">us-east-1</Badge>
      </div>
      <div class="aui-deck-meta-right">
        <span class="aui-deck-stat">P99: <strong>14ms</strong></span>
        <span class="aui-deck-stat">Pods: <strong id="hero-pod-count">16/16</strong></span>
      </div>
    </div>

    {/* Interactive Form Controls: 2026 Switches & Checkboxes */}
    <div class="aui-deck-controls-grid">
      <div class="aui-deck-control-card">
        <label class="aui-switch-label">
          <span class="aui-switch">
            <input type="checkbox" role="switch" checked id="hero-switch-autoscale" />
            <span class="aui-switch-track"></span>
          </span>
          <span>Auto-scaling</span>
        </label>
      </div>
      <div class="aui-deck-control-card">
        <label class="aui-switch-label">
          <span class="aui-switch">
            <input type="checkbox" role="switch" checked id="hero-switch-strict" />
            <span class="aui-switch-track"></span>
          </span>
          <span>Strict mode</span>
        </label>
      </div>
      <div class="aui-deck-control-card">
        <label class="aui-checkbox-label">
          <input type="checkbox" class="aui-checkbox" checked id="hero-check-ssr" />
          <span>Edge SSR</span>
        </label>
      </div>
      <div class="aui-deck-control-card">
        <label class="aui-checkbox-label">
          <input type="checkbox" class="aui-checkbox" checked id="hero-check-zero" />
          <span>Zero-runtime</span>
        </label>
      </div>
    </div>

    {/* Search Box Input */}
    <div class="aui-deck-input-row">
      <div class="aui-form-group" style="margin-bottom: 0;">
        <div class="aui-input-wrapper aui-input-has-right-icon">
          <input
            type="text"
            class="aui-input"
            id="hero-input-filter"
            placeholder="Filter nodes or route..."
          />
          <span class="aui-input-shortcut">⌘K</span>
        </div>
      </div>
    </div>

    {/* Buttons Deck */}
    <div class="aui-deck-actions">
      <button type="button" class="aui-btn aui-btn-primary aui-btn-sm" id="hero-btn-deploy">
        <span>Deploy canary</span>
      </button>
      <button type="button" class="aui-btn aui-btn-secondary aui-btn-sm" id="hero-btn-rollback">
        <span>Rollback</span>
      </button>
      <button type="button" class="aui-btn aui-btn-ghost aui-btn-sm" id="hero-btn-health">
        <span>Healthcheck</span>
      </button>
    </div>
  </div>

  {/* Mode 2: Real-time Generated Code */}
  <div class="aui-deck-code-view" id="hero-view-code" style="display: none;">
    <div class="aui-deck-code-bar">
      <span class="aui-deck-code-file">App.tsx</span>
      <button
        type="button"
        class="aui-deck-copy-btn"
        id="hero-deck-copy"
        aria-label="Copy code"
      >
        <svg class="spec-copy-icon icon-copy" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span class="hero-copy-text" style="margin-left: 0.25rem;">Copy</span>
      </button>
    </div>
    <pre class="aui-deck-pre"><code>{snippet}</code></pre>
  </div>

  {/* Interactive Live Toast Container */}
  <div class="aui-hero-toast" id="hero-toast" style="display: none;">
    <span class="aui-toast-icon" aria-hidden="true" id="hero-toast-icon">✓</span>
    <div class="aui-toast-body">
      <p class="aui-toast-title" id="hero-toast-title">Canary Deployed</p>
      <p class="aui-toast-desc" id="hero-toast-desc">12 edge regions updated · 0 dropped packets</p>
    </div>
  </div>
</div>

<script>
  let deployCounter = 14;
  let toastTimer: number | null = null;

  function showHeroToast(title: string, desc: string, icon = "✓") {
    const toast = document.getElementById("hero-toast");
    const tTitle = document.getElementById("hero-toast-title");
    const tDesc = document.getElementById("hero-toast-desc");
    const tIcon = document.getElementById("hero-toast-icon");
    if (!toast || !tTitle || !tDesc || !tIcon) return;

    tTitle.textContent = title;
    tDesc.textContent = desc;
    tIcon.textContent = icon;
    toast.style.display = "flex";
    toast.classList.add("is-visible");

    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.classList.remove("is-visible");
      setTimeout(() => {
        toast.style.display = "none";
      }, 200);
    }, 2800);
  }

  // Tab switching
  const tabPreview = document.getElementById("hero-tab-preview");
  const tabCode = document.getElementById("hero-tab-code");
  const viewPreview = document.getElementById("hero-view-preview");
  const viewCode = document.getElementById("hero-view-code");

  tabPreview?.addEventListener("click", () => {
    tabPreview.classList.add("is-active");
    tabCode?.classList.remove("is-active");
    if (viewPreview) viewPreview.style.display = "flex";
    if (viewCode) viewCode.style.display = "none";
  });

  tabCode?.addEventListener("click", () => {
    tabCode.classList.add("is-active");
    tabPreview?.classList.remove("is-active");
    if (viewPreview) viewPreview.style.display = "none";
    if (viewCode) viewCode.style.display = "flex";
  });

  // Action buttons
  document.getElementById("hero-btn-deploy")?.addEventListener("click", () => {
    deployCounter++;
    showHeroToast(`Deployment #00${deployCounter} live`, "12 edge regions updated · 0 dropped packets", "✓");
  });

  document.getElementById("hero-btn-rollback")?.addEventListener("click", () => {
    showHeroToast("Rollback requested", "Traffic safely routed to previous stable snapshot", "↺");
  });

  document.getElementById("hero-btn-health")?.addEventListener("click", () => {
    showHeroToast("Telemetry healthy", "All 16 nodes report p99 latency under 15ms", "i");
  });

  // Autoscale switch listener
  document.getElementById("hero-switch-autoscale")?.addEventListener("change", (e) => {
    const el = document.getElementById("hero-pod-count");
    if (el) {
      el.textContent = (e.target as HTMLInputElement).checked ? "16/16" : "8/8";
    }
  });

  // Copy button
  const copyBtn = document.getElementById("hero-deck-copy");
  copyBtn?.addEventListener("click", async () => {
    const pre = document.querySelector(".aui-deck-pre code");
    if (pre && pre.textContent) {
      await navigator.clipboard.writeText(pre.textContent);
      const textSpan = copyBtn.querySelector(".hero-copy-text");
      if (textSpan) textSpan.textContent = "Copied!";
      setTimeout(() => {
        if (textSpan) textSpan.textContent = "Copy";
      }, 1600);
    }
  });
</script>

<style>
  .aui-hero-toast {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.6rem 0.85rem;
    font-size: 0.85rem;
    background-color: var(--aui-bg-secondary);
    border: 1px solid var(--aui-border-strong);
    border-radius: var(--aui-radius-md);
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.2);
    z-index: 10;
    transition: all 0.2s ease;
    animation: aui-toast-slide-up 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes aui-toast-slide-up {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .aui-hero-toast .aui-toast-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background-color: var(--aui-text-secondary);
    color: var(--aui-bg-primary);
    font-size: 0.72rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .aui-hero-toast .aui-toast-body {
    flex: 1;
    min-width: 0;
  }

  .aui-hero-toast .aui-toast-title {
    margin: 0;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--aui-text-secondary);
    line-height: 1.3;
  }

  .aui-hero-toast .aui-toast-desc {
    margin: 0.1rem 0 0;
    font-size: 0.78rem;
    color: var(--aui-text-muted);
    line-height: 1.3;
  }
</style>
