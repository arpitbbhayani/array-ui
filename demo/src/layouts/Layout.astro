---
import ThemeScript from "../../../src/astro/ThemeScript.astro";
import Navbar from "../../../src/astro/Navbar.astro";
import Footer from "../../../src/astro/Footer.astro";
import Kbd from "../../../src/astro/Kbd.astro";
import "../../../dist/styles.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "aui — dense, developer-first design system",
  description = "Compact light and dark UI components for React, Astro and plain CSS.",
} = Astro.props;

const navLinks = [
  { label: "Overview", href: "#overview" },
  { label: "Foundations", href: "#colors" },
  { label: "Components", href: "#buttons" },
  { label: "Usage", href: "#install" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%23e5000f'/><text x='16' y='23' font-family='sans-serif' font-size='20' font-weight='800' text-anchor='middle' fill='white'>a</text></svg>" />
    <ThemeScript />
  </head>
  <body class="aui-body">
    <Navbar brandName="aui" links={navLinks}>
      <div slot="actions" style="display:flex;align-items:center;gap:0.6rem;margin-right:0.25rem;">
        <span class="aui-badge aui-badge-light">v1.0.0</span>
        <a class="aui-btn aui-btn-secondary aui-btn-sm" href="https://github.com/arpitbbhayani/aui" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </Navbar>
    <slot />
    <Footer
      copyright="aui — MIT licensed."
      disclaimer="aui is an open design system inspired by arpitbhayani.me. Drop-in CSS tokens, React components and native Astro components."
    />
  </body>
</html>
