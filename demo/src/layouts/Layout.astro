---
import ThemeScript from "../../../src/astro/ThemeScript.astro";
import Navbar from "../../../src/astro/Navbar.astro";
import Footer from "../../../src/astro/Footer.astro";
import SocialPill from "../../../src/astro/SocialPill.astro";
import Kbd from "../../../src/astro/Kbd.astro";
import { CommandPalette } from "../../../dist/react.js";
import "../../../src/styles/index.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Array UI (aui) — Editorial Design System for Engineers & AI Agents",
  description = "Array UI (aui): Editorial, typography-led systems engineering design system for engineers and AI coding agents. Complete component registry, llms.txt, and shadcn CLI distribution for ui.arpitbhayani.me.",
} = Astro.props;

const navLinks = [
  { label: "[00] Agent Hub", href: "#ai-agents" },
  { label: "[01] Overview", href: "#overview" },
  { label: "[02] Registry", href: "#quickstart" },
  { label: "[03] Developer", href: "#ping-status" },
  { label: "[04] Components", href: "#buttons" },
  { label: "[05] Usage", href: "#install" },
];

const footerColumns = [
  {
    heading: "Design System",
    links: [
      { label: "Overview", href: "#overview" },
      { label: "shadcn Quickstart", href: "#quickstart" },
      { label: "Component Matrix", href: "#component-matrix" },
      { label: "GitHub Installation", href: "#install" },
      { label: "Color Foundations", href: "#colors" },
      { label: "Typography Scale", href: "#typography" },
    ],
  },
  {
    heading: "For AI Agents & LLMs",
    links: [
      { label: "AI Agent Instructions", href: "#ai-agents", isHighlight: true },
      { label: "llms.txt (Standard)", href: "/llms.txt", hint: "Manifest", external: true },
      { label: "llms-full.txt", href: "/llms-full.txt", hint: "Full APIs", external: true },
      { label: "shadcn Registry JSON", href: "/r/registry.json", hint: "Schema", external: true },
      { label: "AGENTS.md", href: "https://raw.githubusercontent.com/arpitbbhayani/aui/main/AGENTS.md", external: true },
      { label: "robots.txt", href: "/robots.txt", external: true },
    ],
  },
  {
    heading: "Ecosystem & Code",
    links: [
      { label: "GitHub Repository", href: "https://github.com/arpitbbhayani/aui", external: true, hint: "Source" },
      { label: "DiceDB", href: "https://github.com/DiceDB/Dice", external: true, hint: "In-memory DB" },
      { label: "arpitbhayani.me", href: "https://arpitbhayani.me", external: true, hint: "Essays" },
      { label: "System Design Cohort", href: "https://arpitbhayani.me/courses", external: true },
    ],
  },
  {
    heading: "Connect",
    links: [
      { label: "Twitter / X", href: "https://twitter.com/arpit_bhayani", external: true },
      { label: "LinkedIn", href: "https://linkedin.com/in/arpitbhayani", external: true },
      { label: "YouTube", href: "https://youtube.com/c/ArpitBhayani", external: true },
      { label: "GitHub Profile", href: "https://github.com/arpitbbhayani", external: true },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://ui.arpitbhayani.me" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%23e5000f'/><text x='16' y='23' font-family='sans-serif' font-size='20' font-weight='800' text-anchor='middle' fill='white'>a</text></svg>" />
    
    <!-- AI Agent & LLM Discoverability (llmstxt.org) -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context (llms.txt)" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Complete LLM Documentation (llms-full.txt)" />
    <link rel="alternate" type="application/json" href="/r/registry.json" title="Array UI Registry Manifest" />
    <meta name="ai:llms-txt" content="https://ui.arpitbhayani.me/llms.txt" />
    <meta name="ai:llms-full" content="https://ui.arpitbhayani.me/llms-full.txt" />
    <meta name="ai:registry" content="https://ui.arpitbhayani.me/r/registry.json" />
    <meta name="ai:agent-instructions" content="https://ui.arpitbhayani.me/#ai-agents" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Array UI (aui)",
        "description": "Editorial, systems-engineering design system inspired by arpitbhayani.me. Zero-runtime CSS tokens, React components, native Astro primitives, and official shadcn CLI distribution.",
        "url": "https://ui.arpitbhayani.me",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Any",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        }
      }
    </script>
    <ThemeScript />
  </head>
  <body class="aui-body">
    <CommandPalette client:load />
    <Navbar brandName="Array UI (aui)" links={navLinks}>
      <div slot="actions" class="aui-nav-custom-actions">
        <a class="aui-nav-llm-btn" href="/llms.txt" target="_blank" title="Machine-readable LLM documentation (llms.txt)">
          <span class="aui-ping-dot" style="width: 7px; height: 7px; background-color: var(--aui-success); border-radius: 50%; display: inline-block;"></span>
          <span>llms.txt</span>
        </a>
        <button
          type="button"
          class="aui-nav-search-btn"
          id="aui-search-trigger"
          title="Search docs (⌘K)"
          onclick="window.dispatchEvent(new KeyboardEvent('keydown', {key:'k', metaKey:true}))"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <span>Search...</span>
          <span class="aui-kbd" style="font-size:0.7rem;padding:0.05rem 0.3rem;">⌘K</span>
        </button>
        <span class="aui-badge aui-badge-light">v0.1.0</span>
        <a class="aui-btn aui-btn-secondary aui-btn-sm" href="https://github.com/arpitbbhayani/aui" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </Navbar>
    <slot />
    <Footer
      columns={footerColumns}
      copyright="Array UI — Built for curious systems engineers & AI agents. MIT Licensed."
      disclaimer="Array UI (aui) is an editorial, systems-engineering design system inspired by arpitbhayani.me. Zero-runtime CSS tokens, React components, native Astro primitives, and official shadcn CLI distribution for ui.arpitbhayani.me."
    >
      <div slot="socials" class="aui-social-pill-group">
        <SocialPill platform="youtube" href="https://youtube.com/c/ArpitBhayani" count="210k" />
        <SocialPill platform="twitter" href="https://twitter.com/arpit_bhayani" count="120k" />
        <SocialPill platform="linkedin" href="https://linkedin.com/in/arpitbhayani" count="280k" />
        <SocialPill platform="github" href="https://github.com/arpitbbhayani" count="7k" />
        <SocialPill platform="rss" href="/rss.xml" />
      </div>
    </Footer>

    <!-- Global Floating HUD / Keyboard Shortcuts Bar -->
    <div class="aui-floating-hud">
      <div class="aui-hud-inner">
        <button type="button" class="aui-hud-btn" onclick="window.dispatchEvent(new KeyboardEvent('keydown', {key:'k', metaKey:true}))">
          <span class="aui-hud-key">⌘K</span>
          <span>Search</span>
        </button>
        <span class="aui-hud-sep">·</span>
        <button type="button" class="aui-hud-btn" onclick="window.dispatchEvent(new KeyboardEvent('keydown', {key:'d', metaKey:true}))">
          <span class="aui-hud-key">⌘D</span>
          <span>Theme</span>
        </button>
        <span class="aui-hud-sep">·</span>
        <span class="aui-hud-item">
          <span class="aui-hud-key">J</span>/<span class="aui-hud-key">K</span>
          <span>Jump</span>
        </span>
      </div>
    </div>

    <!-- Mouse Tracking Dynamic Spotlight & Framework Switcher Scripts -->
    <script is:inline>
      // 1. Framework Switcher
      window.currentDocsFramework = localStorage.getItem("aui-framework") || "nextjs";
      window.setDocsFramework = function(fw) {
        window.currentDocsFramework = fw;
        localStorage.setItem("aui-framework", fw);
        document.documentElement.dataset.framework = fw;

        // Update all specimen bars
        document.querySelectorAll(".spec-usage-bar").forEach(function(bar) {
          var codeEl = bar.querySelector(".spec-code-text");
          var copyBtn = bar.querySelector(".spec-copy-btn");
          var pills = bar.querySelectorAll(".spec-fw-pill");

          pills.forEach(function(p) {
            if (p.dataset.fw === fw) p.classList.add("is-active");
            else p.classList.remove("is-active");
          });

          var snippet = bar.dataset[fw] || (fw === "nextjs" ? bar.dataset.react : "") || bar.dataset.react || "";
          if (codeEl) codeEl.textContent = snippet;
          if (copyBtn) copyBtn.dataset.usage = snippet;
        });

        // Update top global framework buttons
        document.querySelectorAll(".aui-global-fw-btn").forEach(function(btn) {
          if (btn.dataset.fw === fw) btn.classList.add("is-active");
          else btn.classList.remove("is-active");
        });
      };


      // Run on DOM ready
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", function() {
          window.setDocsFramework(window.currentDocsFramework);
        });
      } else {
        window.setDocsFramework(window.currentDocsFramework);
      }
    </script>
  </body>
</html>

<style is:global>
  .aui-nav-custom-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: 0.25rem;
  }
  @media (max-width: 680px) {
    .aui-nav-custom-actions .aui-badge {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .aui-nav-custom-actions a.aui-btn {
      display: none;
    }
  }
  @media (max-width: 400px) {
    .aui-nav-custom-actions {
      gap: 0.35rem;
      margin-right: 0;
    }
  }

  .aui-nav-llm-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.6rem;
    background-color: var(--aui-bg-tertiary);
    border: 1px solid var(--aui-border-color);
    border-radius: var(--aui-radius-md);
    font-family: var(--aui-font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--aui-text-secondary);
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .aui-nav-llm-btn:hover {
    background-color: var(--aui-clickable-hover);
    border-color: var(--aui-border-strong);
    color: var(--aui-primary);
  }
  @media (max-width: 480px) {
    .aui-nav-llm-btn {
      padding: 0.28rem 0.45rem;
    }
  }

  .aui-nav-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.28rem 0.65rem;
    background-color: var(--aui-bg-tertiary);
    border: 1px solid var(--aui-border-color);
    border-radius: var(--aui-radius-md);
    font-family: var(--aui-font-sans);
    font-size: 0.82rem;
    color: var(--aui-text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .aui-nav-search-btn:hover {
    background-color: var(--aui-clickable-hover);
    color: var(--aui-text-secondary);
    border-color: var(--aui-border-strong);
  }
  @media (max-width: 640px) {
    .aui-nav-search-btn span:first-of-type { display: none; }
    .aui-nav-search-btn .aui-kbd { display: none; }
    .aui-nav-search-btn { padding: 0.28rem 0.45rem; }
  }

  /* Floating HUD / Keyboard Shortcuts Dock */
  .aui-floating-hud {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    pointer-events: none;
  }

  .aui-hud-inner {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.85rem;
    background-color: var(--aui-bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--aui-border-strong);
    border-radius: var(--aui-radius-full);
    box-shadow: var(--aui-card-highlight, inset 0 0 0 0 transparent), var(--aui-box-shadow-lg);
    font-family: var(--aui-font-sans);
    font-size: 0.8rem;
    color: var(--aui-text-muted);
  }

  .aui-hud-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: transparent;
    border: none;
    color: var(--aui-text-muted);
    font-size: inherit;
    font-family: inherit;
    cursor: pointer;
    padding: 0;
    transition: color 0.12s ease;
  }

  .aui-hud-btn:hover {
    color: var(--aui-text-secondary);
  }

  .aui-hud-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .aui-hud-key {
    display: inline-block;
    padding: 0.08rem 0.35rem;
    font-family: var(--aui-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    color: var(--aui-text-secondary);
    background-color: var(--aui-bg-tertiary);
    border: 1px solid var(--aui-border-color);
    border-radius: var(--aui-radius-sm);
  }

  .aui-hud-sep {
    color: var(--aui-border-strong);
  }

  @media (max-width: 600px) {
    .aui-floating-hud { display: none; }
  }
</style>
