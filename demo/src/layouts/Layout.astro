---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Array UI</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://ui.arpitbhayani.me" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%23e5000f'/><text x='16' y='23' font-family='sans-serif' font-size='20' font-weight='800' text-anchor='middle' fill='white'>a</text></svg>" />
    
    <!-- AI Agent & LLM Discoverability (llmstxt.org) -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context (llms.txt)" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Complete LLM Documentation (llms-full.txt)" />
    <link rel="alternate" type="application/json" href="/r/registry.json" title="Array UI Registry Manifest" />
    <meta name="ai:llms-txt" content="https://ui.arpitbhayani.me/llms.txt" />
    <meta name="ai:llms-full" content="https://ui.arpitbhayani.me/llms-full.txt" />
    <meta name="ai:registry" content="https://ui.arpitbhayani.me/r/registry.json" />
    <meta name="ai:agent-instructions" content="https://ui.arpitbhayani.me/agents" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Array UI",
        "description": "Editorial, systems-engineering design system inspired by arpitbhayani.me. Zero-runtime CSS tokens, React components, native Astro primitives, and official shadcn CLI distribution.",
        "url": "https://ui.arpitbhayani.me",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Any",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        }
      }
    </script>
    <ThemeScript />
  </head>
  <body class="aui-body">
    <CommandPalette client:load items={commandItems} />
    <Navbar brandName="Array UI" links={navLinks}>
      <div slot="actions" class="aui-row aui-row-sm">
        <a class="aui-btn aui-btn-secondary aui-btn-sm" href="https://github.com/arpitbbhayani/aui" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </Navbar>
    <slot />
    <Footer
      columns={footerColumns}
      copyright="Array UI — Built for curious systems engineers & AI agents. MIT Licensed."
      disclaimer="Array UI is an editorial, systems-engineering design system for personal sites, developer SaaS, and HTML explainer docs. Zero-runtime CSS tokens, React components, native Astro primitives, and official shadcn CLI distribution."
    >
      <div slot="socials" class="aui-social-pill-group">
        <SocialPill platform="github" href="https://github.com/arpitbbhayani/aui" label="GitHub" />
      </div>
    </Footer>


    <!-- Mouse Tracking Dynamic Spotlight & Framework Switcher Scripts -->
    <script is:inline>
      // 1. Framework Switcher
      window.currentDocsFramework = localStorage.getItem("aui-framework") || "nextjs";
      window.setDocsFramework = function(fw) {
        window.currentDocsFramework = fw;
        localStorage.setItem("aui-framework", fw);
        document.documentElement.dataset.framework = fw;

        // Update all specimen bars
        document.querySelectorAll(".spec-usage-bar").forEach(function(bar) {
          var codeEl = bar.querySelector(".spec-code-text");
          var copyBtn = bar.querySelector(".spec-copy-btn");
          var pills = bar.querySelectorAll(".spec-fw-pill");

          pills.forEach(function(p) {
            if (p.dataset.fw === fw) p.classList.add("is-active");
            else p.classList.remove("is-active");
          });

          var snippet = bar.dataset[fw] || (fw === "nextjs" ? bar.dataset.react : "") || bar.dataset.react || "";
          if (codeEl) codeEl.textContent = snippet;
          if (copyBtn) copyBtn.dataset.usage = snippet;
        });

        // Update top global framework buttons
        document.querySelectorAll(".aui-global-fw-btn").forEach(function(btn) {
          if (btn.dataset.fw === fw) btn.classList.add("is-active");
          else btn.classList.remove("is-active");
        });
      };


      // Run on DOM ready
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", function() {
          window.setDocsFramework(window.currentDocsFramework);
        });
      } else {
        window.setDocsFramework(window.currentDocsFramework);
      }
    </script>
  </body>
</html>
