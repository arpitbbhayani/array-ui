---
import Layout from "../layouts/Layout.astro";
import Specimen from "../components/Specimen.astro";
import { TableDemo, ModalDemo, PaginationDemo, SegmentedDemo, ToastDemo, FormDemo, SearchBoxDemo, DropdownDemo, ComboboxDemo, DrawerDemo, AlertDialogDemo, SecretInputDemo, MultiSelectDemo, SliderDemo, PopoverDemo, ChartsDemo, DatePickerDemo, DataTableDemo, ParamSandboxDemo } from "../components/Interactive";

import Sidebar from "../../../src/astro/Sidebar.astro";
import Hero from "../../../src/astro/Hero.astro";
import Button from "../../../src/astro/Button.astro";
import Card from "../../../src/astro/Card.astro";
import SocialPill from "../../../src/astro/SocialPill.astro";
import Maxim from "../../../src/astro/Maxim.astro";
import TakeawaysBox from "../../../src/astro/TakeawaysBox.astro";
import NoticeBox from "../../../src/astro/NoticeBox.astro";
import Badge from "../../../src/astro/Badge.astro";
import Breadcrumbs from "../../../src/astro/Breadcrumbs.astro";
import CourseCard from "../../../src/astro/CourseCard.astro";
import Alert from "../../../src/astro/Alert.astro";
import StatCard from "../../../src/astro/StatCard.astro";
import Timeline from "../../../src/astro/Timeline.astro";
import Accordion from "../../../src/astro/Accordion.astro";
import Tabs from "../../../src/astro/Tabs.astro";
import ThemeToggle from "../../../src/astro/ThemeToggle.astro";
import Kbd from "../../../src/astro/Kbd.astro";
import Tooltip from "../../../src/astro/Tooltip.astro";
import Progress from "../../../src/astro/Progress.astro";
import Spinner from "../../../src/astro/Spinner.astro";
import Divider from "../../../src/astro/Divider.astro";
import Gutter from "../../../src/astro/Gutter.astro";
import EmptyState from "../../../src/astro/EmptyState.astro";
import Terminal from "../../../src/astro/Terminal.astro";
import Toast from "../../../src/astro/Toast.astro";
import CoverCard from "../../../src/astro/CoverCard.astro";
import TableOfContents from "../../../src/astro/TableOfContents.astro";
import SearchBox from "../../../src/astro/SearchBox.astro";
import Newsletter from "../../../src/astro/Newsletter.astro";
import Dropdown from "../../../src/astro/Dropdown.astro";
import VideoEmbed from "../../../src/astro/VideoEmbed.astro";
import Modal from "../../../src/astro/Modal.astro";

import {
  CodeBlock as ReactCodeBlock,
  Skeleton,
  Avatar,
  AvatarGroup,
  Switch,
  Checkbox,
  Select,
  Textarea,
  PingStatus,
  DiffBlock,
  PropertyGrid,
  FileTree,
  PackageManager,
  Canvas,
  ApiEndpoint,
  DocStepper,
  ParamTable,
  FeatureMatrix,
  VersionSelector,
  MemoryLayout,
  PipelineFlow,
  BenchmarkDelta,
  LatencyDistribution,
  ClusterState,
} from "../../../dist/react.js";

const sidebarGroups = [
  {
    title: "[01] Documentation",
    links: [
      { label: "Api endpoint", href: "#api-endpoint" },
      { label: "Doc stepper", href: "#doc-stepper" },
      { label: "Param table", href: "#param-table" },
      { label: "Feature matrix", href: "#feature-matrix" },
      { label: "Version selector", href: "#version-selector" },
      { label: "Canvas", href: "#canvas" },
    ],
  },
  {
    title: "[02] Systems Explorables",
    links: [
      { label: "Memory layout", href: "#memory-layout" },
      { label: "Pipeline flow", href: "#pipeline-flow" },
      { label: "Benchmark delta", href: "#benchmark-delta" },
      { label: "Latency distribution", href: "#latency-distribution" },
      { label: "Cluster state", href: "#cluster-state" },
      { label: "Param sandbox", href: "#param-sandbox" },
    ],
  },

  {
    title: "[03] Developer",
    links: [
      { label: "Ping status", href: "#ping-status" },
      { label: "Property grid", href: "#property-grid" },
      { label: "Diff block", href: "#diff-block" },
      { label: "File tree", href: "#file-tree" },
      { label: "Package manager", href: "#package-manager" },
      { label: "Terminal", href: "#terminal" },
    ],
  },
  {
    title: "[04] Actions",
    links: [
      { label: "Button", href: "#buttons" },
      { label: "Segmented control", href: "#segmented" },
      { label: "Kbd", href: "#kbd" },
      { label: "Tooltip", href: "#tooltip" },
      { label: "Theme toggle", href: "#theme-toggle" },
      { label: "Dropdown", href: "#dropdown" },
    ],
  },
  {
    title: "[05] Forms",
    links: [
      { label: "Input", href: "#input" },
      { label: "Select & textarea", href: "#select" },
      { label: "Search box", href: "#searchbox" },
      { label: "Switch & checkbox", href: "#switch" },
    ],
  },
  {
    title: "[06] Feedback",
    links: [
      { label: "Alert", href: "#alert" },
      { label: "Toast", href: "#toast" },
      { label: "Progress", href: "#progress" },
      { label: "Spinner & skeleton", href: "#spinner" },
      { label: "Modal", href: "#modal" },
      { label: "Empty state", href: "#empty" },
    ],
  },
  {
    title: "[07] Data display",
    links: [
      { label: "Badge", href: "#badge" },
      { label: "Avatar", href: "#avatar" },
      { label: "Stat card", href: "#stat" },
      { label: "Table", href: "#table" },
      { label: "Timeline", href: "#timeline" },
      { label: "Code block", href: "#codeblock" },
    ],
  },
  {
    title: "[08] Navigation",
    links: [
      { label: "Breadcrumbs", href: "#breadcrumbs" },
      { label: "Pagination", href: "#pagination" },
      { label: "Tabs", href: "#tabs" },
      { label: "Accordion", href: "#accordion" },
      { label: "Table of contents", href: "#toc" },
      { label: "Sidebar & navbar", href: "#sidebar" },
    ],
  },
  {
    title: "[09] Content",
    links: [
      { label: "Hero", href: "#hero" },
      { label: "Maxim quote", href: "#maxim" },
      { label: "Takeaways box", href: "#takeaways" },
      { label: "Notice box", href: "#notice" },
      { label: "Newsletter", href: "#newsletter" },
      { label: "Card", href: "#card" },
      { label: "Video embed", href: "#video-embed" },
      { label: "Social pill", href: "#social" },
      { label: "Divider", href: "#divider" },
      { label: "Gutter", href: "#gutter" },
      { label: "Course card", href: "#course" },
      { label: "Cover card", href: "#cover-card" },
    ],
  },
  {
    title: "[10] SaaS & Control Plane",
    links: [
      { label: "Combobox", href: "#combobox" },
      { label: "Drawer / Sheet", href: "#drawer" },
      { label: "Alert dialog", href: "#alert-dialog" },
      { label: "Secret input", href: "#secret-input" },
      { label: "Multi select", href: "#multi-select" },
      { label: "Slider", href: "#slider" },
      { label: "Popover", href: "#popover" },
      { label: "Telemetry charts", href: "#charts" },
      { label: "Date picker", href: "#datepicker" },
      { label: "Data table", href: "#datatable" },
    ],
  },
];

const tableRows = [
  { service: "api-gateway", region: "eu-west-1", p99: "42 ms", status: "Healthy" },
  { service: "ledger-db", region: "us-east-1", p99: "118 ms", status: "Degraded" },
  { service: "search-index", region: "ap-south-1", p99: "67 ms", status: "Healthy" },
  { service: "payments-queue", region: "eu-west-1", p99: "-", status: "Down" },
];

const takeaways = [
  "Zero-dependency core: pure CSS tokens, React, or native Astro.",
  "Theme-first: light and dark with anti-FOUC script.",
  "1px hairline borders everywhere, no arbitrary shadows.",
  "Designed for engineers: high information density and machined typography.",
];
---

<Layout
  title="Component Catalog — Array UI"
  description="Explore the complete interactive catalog of 58+ native components and shadcn CLI registry primitives."
>
  <div class="aui-container">
    <div class="aui-mobile-only">
      <Card hoverable={false} style="margin: 1rem 0; padding: 0.5rem 0.85rem; background-color: var(--aui-bg-secondary);">
        <div class="aui-row-between aui-flex-wrap" style="gap: 0.5rem;">
          <span class="aui-font-mono" style="font-size: 0.78rem; font-weight: 600; color: var(--aui-text-muted);">Jump to component:</span>
          <select class="aui-select" style="font-size: 0.82rem; padding: 0.25rem 0.5rem; max-width: 240px;" onchange="if(this.value) window.location.hash = this.value;">
            <option value="">Select component...</option>
            {sidebarGroups.map((g) => (
              <optgroup label={g.title}>
                {g.links.map((l) => (
                  <option value={l.href}>{l.label}</option>
                ))}
              </optgroup>
            ))}
          </select>
        </div>
      </Card>
    </div>

    <div class="aui-docs">
      <Sidebar groups={sidebarGroups} />

      <main style="min-width: 0;">
        <!-- Technical Documentation -->
        <h2 class="aui-h2"><span class="aui-index-tag">[01]</span> Technical Documentation</h2>
        <div class="spec-grid">
          <Specimen
            id="api-endpoint"
            name="Api endpoint"
            description="Machined API spec block with method pill, parameters, and status responses."
            usage={`<ApiEndpoint
  method="POST"
  path="/v1/clusters/{cluster_id}/replicate"
  description="Triggers immediate Raft write-ahead log replication across active quorum peers."
  badge="Idempotent"
  params={[
    { name: "cluster_id", type: "string", required: true, description: "Unique target cluster identifier" },
    { name: "fsync", type: "boolean", required: false, description: "Block until disk sync completes" },
    { name: "timeout_ms", type: "uint32", required: false, description: "RPC timeout limit (default: 500ms)" },
  ]}
  responses={[
    { status: 200, label: "OK", body: '{\\n  "replicated_index": 45091,\\n  "peers_acknowledged": 3,\\n  "latency_ms": 1.4\\n}' },
    { status: 409, label: "Conflict", body: '{\\n  "error": "LEADER_DEPOSED",\\n  "current_term": 5\\n}' },
  ]}
/>`}
            span={2}
            shadcnName="api-endpoint"
          >
            <ApiEndpoint
              client:load
              method="POST"
              path="/v1/clusters/{cluster_id}/replicate"
              description="Triggers immediate Raft write-ahead log replication across active quorum peers."
              badge="Idempotent"
              params={[
                { name: "cluster_id", type: "string", required: true, description: "Unique target cluster identifier" },
                { name: "fsync", type: "boolean", required: false, description: "Block until disk sync completes" },
                { name: "timeout_ms", type: "uint32", required: false, description: "RPC timeout limit (default: 500ms)" },
              ]}
              responses={[
                { status: 200, label: "OK", body: '{\n  "replicated_index": 45091,\n  "peers_acknowledged": 3,\n  "latency_ms": 1.4\n}' },
                { status: 409, label: "Conflict", body: '{\n  "error": "LEADER_DEPOSED",\n  "current_term": 5\n}' },
              ]}
            />
          </Specimen>

          <Specimen
            id="doc-stepper"
            name="Doc stepper"
            description="Connected tutorial walkthrough with numbered progression track."
            usage={`<DocStepper
  steps={[
    { title: "Initialize Root Node", description: "Bootstrap primary state machine on port 8080." },
    { title: "Attach Voter Peers", description: "Register secondary replica addresses in consensus quorum." },
    { title: "Verify Health & Heartbeat", description: "Send ping probe to ensure sub-5ms replication latency." },
  ]}
  activeStep={1}
/>`}
            shadcnName="doc-stepper"
          >
            <DocStepper
              client:load
              steps={[
                { title: "Initialize Root Node", description: "Bootstrap primary state machine on port 8080." },
                { title: "Attach Voter Peers", description: "Register secondary replica addresses in consensus quorum." },
                { title: "Verify Health & Heartbeat", description: "Send ping probe to ensure sub-5ms replication latency." },
              ]}
              activeStep={1}
            />
          </Specimen>

          <Specimen
            id="param-table"
            name="Param table"
            description="Dense configuration reference table with types, requirements, and defaults."
            usage={`<ParamTable
  items={[
    { name: "--wal-dir", type: "string", required: true, description: "Path to write-ahead log storage" },
    { name: "--sync-interval", type: "Duration", required: false, default: "100ms", description: "Fsync interval for durability" },
    { name: "--max-batch-size", type: "uint32", required: false, default: "1024", description: "Max operations before flush" },
  ]}
/>`}
            shadcnName="param-table"
          >
            <ParamTable
              client:load
              items={[
                { name: "--wal-dir", type: "string", required: true, description: "Path to write-ahead log storage" },
                { name: "--sync-interval", type: "Duration", required: false, default: "100ms", description: "Fsync interval for durability" },
                { name: "--max-batch-size", type: "uint32", required: false, default: "1024", description: "Max operations before flush" },
              ]}
            />
          </Specimen>

          <Specimen
            id="feature-matrix"
            name="Feature matrix"
            description="Dense matrix comparison comparing engines or editions with indicators."
            usage={`<FeatureMatrix
  columns={[
    { key: "lsm", label: "LSM-Tree (Pebbles/Rocks)" },
    { key: "btree", label: "B+ Tree (Postgres/InnoDB)" },
  ]}
  rows={[
    { category: "Storage & Latency" },
    { name: "Write Amplification", values: { lsm: "Low (Sequential I/O)", btree: "High (Random Pages)" } },
    { name: "Point Lookups", values: { lsm: "partial", btree: true } },
    { name: "Range Scans", values: { lsm: true, btree: true } },
    { category: "Hardware Characteristics" },
    { name: "NVMe SSD Optimization", values: { lsm: true, btree: "partial" } },
    { name: "Zero-Allocation Compaction", values: { lsm: true, btree: false } },
  ]}
/>`}
            span={2}
            shadcnName="feature-matrix"
          >
            <FeatureMatrix
              client:load
              columns={[
                { key: "lsm", label: "LSM-Tree (Pebbles/Rocks)" },
                { key: "btree", label: "B+ Tree (Postgres/InnoDB)" },
              ]}
              rows={[
                { category: "Storage & Latency" },
                { name: "Write Amplification", values: { lsm: "Low (Sequential I/O)", btree: "High (Random Pages)" } },
                { name: "Point Lookups", values: { lsm: "partial", btree: true } },
                { name: "Range Scans", values: { lsm: true, btree: true } },
                { category: "Hardware Characteristics" },
                { name: "NVMe SSD Optimization", values: { lsm: true, btree: "partial" } },
                { name: "Zero-Allocation Compaction", values: { lsm: true, btree: false } },
              ]}
            />
          </Specimen>

          <Specimen
            id="version-selector"
            name="Version selector"
            description="Compact documentation switcher for versions and runtime environments."
            usage={`<VersionSelector
  label="Doc Version:"
  versions={[
    { label: "v2.4", value: "v2.4", badge: "Latest" },
    { label: "v2.3", value: "v2.3" },
    { label: "v1.9", value: "v1.9", badge: "LTS" },
  ]}
/>`}
            shadcnName="version-selector"
          >
            <div class="spec-col" style="gap: 1rem;">
              <VersionSelector
                client:load
                label="Doc Version:"
                versions={[
                  { label: "v2.4", value: "v2.4", badge: "Latest" },
                  { label: "v2.3", value: "v2.3" },
                  { label: "v1.9", value: "v1.9", badge: "LTS" },
                ]}
              />
              <VersionSelector
                client:load
                label="Runtime:"
                versions={[
                  { label: "Kubernetes Operator", value: "k8s" },
                  { label: "Docker Compose", value: "docker" },
                  { label: "Bare Metal Binary", value: "bare-metal" },
                ]}
              />
            </div>
          </Specimen>

          <Specimen
            id="canvas"
            name="Canvas"
            description="Engineering coordinate drafting canvas with dotted grid, corner markers, and title bar."
            usage={`<Canvas title="Raft Consensus Replication Flow" variant="grid">
  <div style={{ padding: "1.25rem 0.75rem", display: "flex", justifyContent: "space-around", alignItems: "center" }}>
    <div>Leader: node-01 (Term 5)</div>
    <div>AppendEntries RPC (0.4ms)</div>
    <div>Follower: node-02 (Term 5)</div>
  </div>
</Canvas>`}
            shadcnName="canvas"
          >
            <Canvas client:load title="Raft Consensus Replication Flow" variant="grid">
              <div style="padding: 1.25rem 0.75rem; display: flex; align-items: center; justify-content: space-around; flex-wrap: wrap; gap: 1rem;">
                <div style="border: 1px solid var(--aui-primary); background: var(--aui-bg-secondary); border-radius: var(--aui-radius-md); padding: 0.75rem 1rem; font-family: var(--aui-font-mono); font-size: 0.8rem; text-align: center; min-width: 140px; box-shadow: 0 0 0 1px var(--aui-primary);">
                  <div style="color: var(--aui-primary); font-weight: 700; font-size: 0.72rem; text-transform: uppercase;">● Leader</div>
                  <div style="font-weight: 600; color: var(--aui-text-primary); margin-top: 0.2rem;">node-01 (Term 5)</div>
                  <div style="font-size: 0.7rem; color: var(--aui-text-muted); margin-top: 0.15rem;">Commit: 94,820</div>
                </div>
                <div style="font-family: var(--aui-font-mono); font-size: 0.72rem; color: var(--aui-text-muted); text-align: center; display: flex; flex-direction: column; align-items: center;">
                  <span>AppendEntries RPC</span>
                  <span style="color: var(--aui-primary); font-size: 1.1rem; line-height: 1.2;">⇄ ⇄</span>
                  <span>0.4ms ping</span>
                </div>
                <div style="border: 1px solid var(--aui-border-color); background: var(--aui-bg-secondary); border-radius: var(--aui-radius-md); padding: 0.75rem 1rem; font-family: var(--aui-font-mono); font-size: 0.8rem; text-align: center; min-width: 140px;">
                  <div style="color: var(--aui-success); font-weight: 700; font-size: 0.72rem; text-transform: uppercase;">○ Follower</div>
                  <div style="font-weight: 600; color: var(--aui-text-primary); margin-top: 0.2rem;">node-02 (Term 5)</div>
                  <div style="font-size: 0.7rem; color: var(--aui-text-muted); margin-top: 0.15rem;">Match: 94,820</div>
                </div>
              </div>
            </Canvas>
          </Specimen>
        </div>

        <div style="height: 2.5rem;"></div>

        <!-- Systems Explorables -->
        <h2 class="aui-h2"><span class="aui-index-tag">[02]</span> Interactive Systems Explorables</h2>
        <div class="spec-grid">
          <Specimen
            id="memory-layout"
            name="Memory layout"
            description="Contiguous binary struct and packet inspector with interactive field breakdown."
            usage={`<MemoryLayout
  title="TCP Segment Header (20 Bytes)"
  totalBytes={20}
  segments={[
    { name: "Source Port", bytes: 2, offset: "0x00 - 0x01", type: "uint16", value: "0x1F90 (8080)", color: "crimson", description: "Origin port transmitting payload packet." },
    { name: "Dest Port", bytes: 2, offset: "0x02 - 0x03", type: "uint16", value: "0x01BB (443)", color: "emerald", description: "Target service destination port." },
    { name: "Sequence No", bytes: 4, offset: "0x04 - 0x07", type: "uint32", value: "0x28B49001", color: "blue", description: "Initial Sequence Number (ISN) for data stream ordering." },
    { name: "Ack Number", bytes: 4, offset: "0x08 - 0x0B", type: "uint32", value: "0x00000000", color: "amber", description: "Next expected sequence number from peer." },
    { name: "Data Offset & Flags", bytes: 2, offset: "0x0C - 0x0D", type: "uint16", value: "0x5002 (SYN)", color: "violet", description: "Header length and TCP control flags (SYN, ACK, FIN)." },
    { name: "Window Size", bytes: 2, offset: "0x0E - 0x0F", type: "uint16", value: "0xFFFF (65535)", color: "neutral", description: "Receive window size for flow control buffer." },
    { name: "Checksum & Urgent", bytes: 4, offset: "0x10 - 0x13", type: "uint32", value: "0x3A210000", color: "neutral", description: "Error detection checksum and urgent pointer offset." },
  ]}
/>`}
            span={2}
            shadcnName="memory-layout"
          >
            <MemoryLayout
              client:load
              title="TCP Segment Header (20 Bytes)"
              totalBytes={20}
              segments={[
                { name: "Source Port", bytes: 2, offset: "0x00 - 0x01", type: "uint16", value: "0x1F90 (8080)", color: "crimson", description: "Origin port transmitting payload packet." },
                { name: "Dest Port", bytes: 2, offset: "0x02 - 0x03", type: "uint16", value: "0x01BB (443)", color: "emerald", description: "Target service destination port." },
                { name: "Sequence No", bytes: 4, offset: "0x04 - 0x07", type: "uint32", value: "0x28B49001", color: "blue", description: "Initial Sequence Number (ISN) for data stream ordering." },
                { name: "Ack Number", bytes: 4, offset: "0x08 - 0x0B", type: "uint32", value: "0x00000000", color: "amber", description: "Next expected sequence number from peer." },
                { name: "Data Offset & Flags", bytes: 2, offset: "0x0C - 0x0D", type: "uint16", value: "0x5002 (SYN)", color: "violet", description: "Header length and TCP control flags (SYN, ACK, FIN)." },
                { name: "Window Size", bytes: 2, offset: "0x0E - 0x0F", type: "uint16", value: "0xFFFF (65535)", color: "neutral", description: "Receive window size for flow control buffer." },
                { name: "Checksum & Urgent", bytes: 4, offset: "0x10 - 0x13", type: "uint32", value: "0x3A210000", color: "neutral", description: "Error detection checksum and urgent pointer offset." },
              ]}
            />
          </Specimen>

          <Specimen
            id="pipeline-flow"
            name="Pipeline flow"
            description="Multi-stage data streaming flow with stage metrics and animated pulse dots."
            usage={`<PipelineFlow
  animated={true}
  stages={[
    { title: "Ingress Gateway", badge: "HTTP/3", description: "TLS termination and routing", metric: "142k req/s" },
    { title: "Write-Ahead Log", badge: "NVMe", description: "Sequential disk append fsync", metric: "0.28ms flush", active: true },
    { title: "MemTable", badge: "SkipList", description: "Lock-free key-value sort", metric: "64MB cap" },
    { title: "SSTable Level-0", badge: "Disk", description: "Immutable sorted strings table", metric: "Compacting" },
  ]}
/>`}
            span={2}
            shadcnName="pipeline-flow"
          >
            <PipelineFlow
              client:load
              animated={true}
              stages={[
                { title: "Ingress Gateway", badge: "HTTP/3", description: "TLS termination and request routing", metric: "142k req/s" },
                { title: "Write-Ahead Log", badge: "NVMe", description: "Sequential disk append fsync", metric: "0.28ms flush", active: true },
                { title: "MemTable", badge: "SkipList", description: "Lock-free in-memory key-value sort", metric: "64MB cap" },
                { title: "SSTable Level-0", badge: "Disk", description: "Immutable block sorted strings table", metric: "Compacting" },
              ]}
            />
          </Specimen>

          <Specimen
            id="benchmark-delta"
            name="Benchmark delta"
            description="Comparative performance block showing baseline vs candidate gains."
            usage={`<BenchmarkDelta
  benchmarks={[
    {
      name: "Throughput (ops/sec)",
      baselineLabel: "v1.2 Baseline",
      baselineValue: 42000,
      baselineDisplay: "42,000 ops/s",
      candidateLabel: "v2.0 Optimized",
      candidateValue: 98000,
      candidateDisplay: "98,000 ops/s",
      delta: "+133%",
      better: "higher",
    },
    {
      name: "P99 Write Latency",
      baselineLabel: "v1.2",
      baselineValue: 45,
      baselineDisplay: "45.2 ms",
      candidateLabel: "v2.0",
      candidateValue: 12,
      candidateDisplay: "12.1 ms",
      delta: "-73%",
      better: "lower",
    },
    {
      name: "Heap Allocation Rate",
      baselineLabel: "v1.2",
      baselineValue: 180,
      baselineDisplay: "180 MB/s",
      candidateLabel: "v2.0",
      candidateValue: 48,
      candidateDisplay: "48 MB/s",
      delta: "-73%",
      better: "lower",
    },
  ]}
/>`}
            shadcnName="benchmark-delta"
          >
            <BenchmarkDelta
              client:load
              benchmarks={[
