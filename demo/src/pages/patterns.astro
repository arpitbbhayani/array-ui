---
import Layout from "../layouts/Layout.astro";
import Specimen from "../components/Specimen.astro";
import Breadcrumbs from "../../../src/astro/Breadcrumbs.astro";
import { Avatar } from "../../../dist/react.js";
import Badge from "../../../src/astro/Badge.astro";
import Button from "../../../src/astro/Button.astro";
import TableOfContents from "../../../src/astro/TableOfContents.astro";
import StatCard from "../../../src/astro/StatCard.astro";
import Alert from "../../../src/astro/Alert.astro";
import Maxim from "../../../src/astro/Maxim.astro";
import TakeawaysBox from "../../../src/astro/TakeawaysBox.astro";
import Terminal from "../../../src/astro/Terminal.astro";

const takeaways = [
  "A write-ahead log ensures crash recovery is sequential and deterministic.",
  "Durability is an invariant of synchronization order, not just disk technology.",
  "Log compaction discards prefix entries safely after checkpoints.",
];
---

<Layout
  title="Real-World Architectural Patterns — Array UI (aui)"
  description="Composable layouts, systems telemetry dashboards, and editorial article reading patterns built with Array UI."
>
  <div class="aui-container" style="padding-top: 1.5rem; padding-bottom: 3rem;">
    <!-- Page Header -->
    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--aui-border-color); padding-bottom: 1.5rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
        <span class="aui-index-tag">[01 PATTERNS]</span>
        <Badge variant="outline">Composed Layouts</Badge>
      </div>
      <h1 class="landing-title" style="margin-bottom: 0.5rem;">Real-World Patterns</h1>
      <p class="landing-sub" style="max-width: 72ch; margin-bottom: 1rem;">
        Complete, composited layouts demonstrating how Array UI primitives combine into high-density telemetry dashboards, readable engineering essays, and system consoles.
      </p>
    </div>

    <!-- Patterns Grid -->
    <div class="spec-grid" style="margin-bottom: 2rem;">
      <!-- Pattern 1: SaaS Telemetry Dashboard -->
      <Specimen id="saas-dashboard" name="SaaS Telemetry & Observability Dashboard" description="Dense, scannable product UI: toolbar, key metric stat cards, status table, and inline alert." span={2} tone="page">
        <div class="pattern pattern-app">
          <div class="app-toolbar">
            <div>
              <h2 class="app-title">Cluster Fleet Health</h2>
              <p class="app-sub">Production clusters · rolling 24 hours</p>
            </div>
            <div class="spec-row">
              <div class="aui-segmented">
                <button class="aui-segmented-item is-active" type="button">24h</button>
                <button class="aui-segmented-item" type="button">7d</button>
                <button class="aui-segmented-item" type="button">30d</button>
              </div>
              <Button variant="secondary" size="sm">Export Telemetry</Button>
              <Button variant="primary" size="sm">New Cluster</Button>
            </div>
          </div>

          <div class="aui-grid aui-grid-cols-4" style="gap:0.75rem;margin-bottom:1rem;">
            <StatCard value="99.98%" label="Uptime" description="rolling 30 days" />
            <StatCard value="42 ms" label="p99 latency" description="eu-west-1" />
            <StatCard value="1.2M" label="Requests / min" description="peak today" />
            <StatCard value="3" label="Replicas" description="1 degraded" />
          </div>

          <Alert variant="warning" title="Replica lag detected in us-east-1">
            Cluster node <code>us-east-1b</code> is 240 ms behind the primary consensus log. Client writes remain unaffected.
          </Alert>

          <div class="aui-table-wrapper" style="margin-top: 1rem;">
            <table class="aui-table">
              <thead>
                <tr>
                  <th>Service</th>
                  <th>Region</th>
                  <th>p99 Latency</th>
                  <th>Consensus</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>edge-gateway</strong></td>
                  <td>eu-west-1</td>
                  <td>14 ms</td>
                  <td>Raft Leader</td>
                  <td><span class="aui-badge aui-badge-green">Healthy</span></td>
                  <td style="text-align:right"><Button variant="ghost" size="sm">Inspect</Button></td>
                </tr>
                <tr>
                  <td><strong>ledger-db</strong></td>
                  <td>us-east-1</td>
                  <td>118 ms</td>
                  <td>Follower</td>
                  <td><span class="aui-badge aui-badge-amber">Degraded</span></td>
                  <td style="text-align:right"><Button variant="ghost" size="sm">Inspect</Button></td>
                </tr>
                <tr>
                  <td><strong>search-index</strong></td>
                  <td>ap-south-1</td>
                  <td>67 ms</td>
                  <td>Raft Leader</td>
                  <td><span class="aui-badge aui-badge-green">Healthy</span></td>
                  <td style="text-align:right"><Button variant="ghost" size="sm">Inspect</Button></td>
                </tr>
                <tr>
                  <td><strong>payments-queue</strong></td>
                  <td>eu-west-1</td>
                  <td>—</td>
                  <td>Candidate</td>
                  <td><span class="aui-badge aui-badge-red">Outage</span></td>
                  <td style="text-align:right"><Button variant="ghost" size="sm">Inspect</Button></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </Specimen>

      <!-- Pattern 2: Deep-Dive Technical Essay -->
      <Specimen id="blog-article" name="Editorial Technical Article" description="Long-form engineering essay: 15px/17px prose, 70ch measure, inline code, engineering maxim quote, and sticky outline." span={2} tone="page">
        <div class="pattern pattern-article">
          <Breadcrumbs items={[{ label: "Essays", href: "#" }, { label: "Storage Engines", href: "#" }, { label: "Write-Ahead Logging", active: true }]} />
          <div class="aui-layout-sidebar" style="margin-top: 1.25rem;">
            <article class="aui-prose" style="max-width: 100%;">
              <h1>Why every database writes before it writes</h1>
              <div class="aui-prose-meta">
                <Avatar size="sm" fallback="AB" />
                <span><strong style="color:var(--aui-text-secondary)">Arpit Bhayani</strong></span>
                <span>·</span><span>Oct 4, 2026</span><span>·</span><span>9 min read</span>
                <Badge>Databases</Badge><Badge>Storage Internals</Badge>
              </div>
              <p>
                A write-ahead log is the simplest idea in storage engineering and the one most systems get subtly wrong.
                Before a mutation touches an in-memory page or an on-disk B-tree, the intent is appended to a sequential file, so crash recovery is deterministic and sequential.
              </p>

              <Maxim author="Arpit Bhayani" source="Asli Engineering" sourceUrl="https://arpitbhayani.me">
                Durability is not a property of the disk. It is a property of the order in which you wait.
              </Maxim>

              <h2 id="the-contract">The Contract</h2>
              <p>
                The rule has two halves: a page may only be flushed once its log record is durable, and a commit is only
                acknowledged after the log is synced. Everything else, including <code>fsync</code> batching and
                group commits, is an optimization of those two invariants.
              </p>

              <TakeawaysBox title="Key Takeaways" items={takeaways} />

              <h3 id="what-to-measure">What to measure</h3>
              <ul>
                <li>Sync latency at p50, p99 and p99.9, not just the arithmetic mean.</li>
                <li>Bytes written per transaction, to spot write amplification early.</li>
                <li>Recovery time after an unclean SIGKILL.</li>
              </ul>
            </article>
            <aside class="aui-sticky-sidebar" style="position: static; max-height: none;">
              <TableOfContents
                sticky={false}
                headings={[
                  { depth: 2, slug: "the-contract", text: "The Contract" },
                  { depth: 3, slug: "what-to-measure", text: "What to measure" },
                ]}
              />
            </aside>
          </div>
        </div>
      </Specimen>
    </div>
  </div>
</Layout>
