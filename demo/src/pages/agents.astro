---
import Layout from "../layouts/Layout.astro";
import Specimen from "../components/Specimen.astro";
import Badge from "../../../src/astro/Badge.astro";
import Button from "../../../src/astro/Button.astro";
import Kbd from "../../../src/astro/Kbd.astro";
import PingStatus from "../../../src/astro/PingStatus.astro";

const registryComponents = [
  // Core UI & Actions
  { name: "button", title: "Button", desc: "Signature tactile action button with crimson primary, secondary, outline, ghost, and danger variants." },
  { name: "badge", title: "Badge", desc: "Status pills and tag badges (crimson, emerald green, amber, rose red, sky blue, outline)." },
  { name: "card", title: "Card", desc: "Flat card surface with 1px hairline border, header, title, description, content, and footer." },
  { name: "input", title: "Input", desc: "Machined text input with subtle focus ring and optional keyboard shortcut badge." },
  { name: "kbd", title: "Kbd", desc: "Monospace keyboard shortcut keycap badge." },
  { name: "tooltip", title: "Tooltip", desc: "Accessible tooltip hint on hover and focus." },
  { name: "alert", title: "Alert", desc: "Status-tinted inline alert callout (info, success, warning, destructive)." },
  { name: "tabs", title: "Tabs", desc: "Underline tab navigation with keyboard accessibility." },
  { name: "accordion", title: "Accordion", desc: "Collapsible hairline accordion sections for FAQs and structured content." },
  { name: "dropdown", title: "Dropdown", desc: "Minimal click-trigger dropdown menu with click outside dismissal and actions." },

  // Developer & Telemetry
  { name: "terminal", title: "Terminal", desc: "Machined telemetry terminal with bash command dots and styled outputs." },
  { name: "diff-block", title: "DiffBlock", desc: "Git patch viewer with line gutters, additions, and deletions." },
  { name: "ping-status", title: "PingStatus", desc: "Live telemetry pulsing dot indicator with status and latency." },
  { name: "property-grid", title: "PropertyGrid", desc: "Key-value metadata inspector with one-click copy functionality." },
  { name: "package-manager", title: "PackageManager", desc: "pnpm/npm/bun/yarn command switcher with copy button." },
  { name: "file-tree", title: "FileTree", desc: "Directory explorer tree with collapsible folders and item selection." },

  // Editorial & Content
  { name: "maxim", title: "Maxim", desc: "Editorial quote callout with amber left rail and citation." },
  { name: "takeaways-box", title: "TakeawaysBox", desc: "Key takeaways container with bulleted highlights." },
  { name: "hero", title: "Hero", desc: "Editorial profile hero section with avatar, heading, and bio." },
  { name: "social-pill", title: "SocialPill", desc: "Clean pill button with platform icon, handle, and follower count." },
  { name: "course-card", title: "CourseCard", desc: "Editorial course and project card with badges, tags, and CTA." },
  { name: "stat-card", title: "StatCard", desc: "Large key metric display card with optional trend indicator." },
  { name: "empty-state", title: "EmptyState", desc: "Dashed container for empty content and call-to-actions." },
  { name: "footer", title: "Footer", desc: "Editorial 4-column directory footer with category hints and disclaimer." },
  { name: "modal", title: "Modal", desc: "Accessible dialog modal with backdrop blur and escape key dismissal." },
  { name: "video-embed", title: "VideoEmbed", desc: "Responsive 16:9 aspect ratio video embed wrapper with border hairline styling." },
];

const universalAgentPrompt = `You are an expert engineer building UI with Array UI (@aui), an editorial engineering design system inspired by arpitbhayani.me.

# Documentation & Registry
- Official Site & Catalog: https://ui.arpitbhayani.me
- LLM Context: https://ui.arpitbhayani.me/llms.txt
- Comprehensive Reference: https://ui.arpitbhayani.me/llms-full.txt
- shadcn Registry: https://ui.arpitbhayani.me/r/{name}.json
- Registry Index: https://ui.arpitbhayani.me/r/registry.json
- GitHub Repo: github:arpitbbhayani/aui (Note: NOT on npm registry; install via GitHub or shadcn registry)

# Installation Modes
1. If project uses shadcn/ui:
   - Add "@aui": "https://ui.arpitbhayani.me/r/{name}.json" under "registries" in components.json.
   - Run: npx shadcn@latest add @aui/aui -y (base theme tokens)
   - Run: npx shadcn@latest add @aui/<component> -y (e.g. button, badge, card, terminal, ping-status)
   - Import from "@/components/ui/<component>".
2. If project uses direct package (Next.js, Astro):
   - Run: npm install github:arpitbbhayani/aui (or pnpm add / bun add)
   - Add import "aui/styles.css"; to root layout.
   - Import from "aui/nextjs" (Next.js) or "aui/astro/[Component].astro" (Astro).

# Autonomous Workflow (IMPORTANT):
- When given a task or UI requirement, autonomously select all needed @aui components.
- DO NOT pause or ask the user which components to install.
- Automatically execute the installation command (e.g. \`npx shadcn@latest add @aui/<component> -y\`) and immediately proceed to building the requested interface.

# Aesthetic Rules:
- Palette: Paper canvas in light mode (#f9f8f5), obsidian carbon in dark mode (#121215).
- Hairline borders: Single 1px borders everywhere (#dfded9 in light, #2c2c38 in dark).
- Accents:
  - Signature Crimson (#e5000f in light, #ff3344 in dark) ONLY for primary action buttons, active tabs, and focus rings.
  - Amber (#cc9900) exclusively for engineering maxim quotes and warnings.
  - Emerald (#10b981) for operational status & diff additions; Rose (#f43f5e) for outages & diff deletions.
- Typography: Plus Jakarta Sans / Space Grotesk bold headings, Assistant body (15px base), Lora italic serif quotes, Geist Mono code.
- Always use cn() from @/lib/utils for custom classes.`;
---

<Layout
  title="AI Agent & LLM Hub — Array UI (aui)"
  description="First-class system prompts, autonomous coding rules, and machine-readable registry endpoints (llms.txt, llms-full.txt) for AI assistants."
>
  <div class="aui-container" style="padding-top: 1.5rem; padding-bottom: 3rem;">
    <!-- Page Header -->
    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--aui-border-color); padding-bottom: 1.5rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
        <span class="aui-index-tag">[AI HUB]</span>
        <PingStatus status="operational" label="Machine Endpoints Active" size="sm" />
      </div>
      <h1 class="landing-title" style="margin-bottom: 0.5rem;">AI Agent & LLM Hub</h1>
      <p class="landing-sub" style="max-width: 72ch; margin-bottom: 1rem;">
        Array UI is architected for autonomous AI coding assistants (Cursor, Claude Code, Windsurf, Codex, Antigravity) who need machine-readable specifications, copy-paste prompts, and instant component installations.
      </p>

      <div class="docs-framework-bar" style="margin-top: 1rem;">
        <div class="docs-framework-meta">
          <span class="meta-chip">Agent Protocol</span>
          <span class="meta-sep">/</span>
          <span>llmstxt.org standard</span>
          <span class="meta-sep">/</span>
          <a href="/llms.txt" class="meta-llm-link">llms.txt</a>
          <span class="meta-sep">/</span>
          <a href="/llms-full.txt" class="meta-llm-link">llms-full.txt</a>
        </div>
      </div>
    </div>

    <!-- Agent System Prompts Box -->
    <div class="spec-grid" style="margin-bottom: 2rem;">
      <Specimen id="agent-prompts" name="Agent System Prompts & Presets" description="Select your AI assistant to preview and copy the fine-tuned instructions." span={2}>
        <div class="aui-agent-box">
          <div class="aui-agent-header">
            <div class="aui-agent-tabs">
              <button type="button" class="aui-agent-tab-btn is-active" data-preset="universal" onclick="switchAgentPreset('universal')">Universal Prompt</button>
              <button type="button" class="aui-agent-tab-btn" data-preset="cursor" onclick="switchAgentPreset('cursor')">Cursor (.cursorrules)</button>
              <button type="button" class="aui-agent-tab-btn" data-preset="claude" onclick="switchAgentPreset('claude')">Claude Code</button>
              <button type="button" class="aui-agent-tab-btn" data-preset="windsurf" onclick="switchAgentPreset('windsurf')">Windsurf Cascade</button>
              <button type="button" class="aui-agent-tab-btn" data-preset="cli" onclick="switchAgentPreset('cli')">CLI Snippet</button>
            </div>
            <div class="aui-agent-header-actions">
              <a href="/llms.txt" target="_blank" class="aui-agent-endpoint-badge" title="View official llms.txt">
                <span class="aui-agent-dot"></span>
                <span>/llms.txt ↗</span>
              </a>
              <a href="/llms-full.txt" target="_blank" class="aui-agent-endpoint-badge" title="View complete llms-full.txt">
                <span>/llms-full.txt ↗</span>
              </a>
              <button
                type="button"
                class="aui-agent-copy-btn"
                onclick="navigator.clipboard.writeText(document.getElementById('aui-agent-prompt-text').textContent); this.classList.add('is-copied'); const t=this.querySelector('.aui-agent-btn-text'); if(t) t.textContent='Copied Prompt!'; setTimeout(() => { this.classList.remove('is-copied'); if(t) t.textContent='Copy Active Prompt'; }, 2000);"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <span class="aui-agent-btn-text">Copy Active Prompt</span>
              </button>
            </div>
          </div>

          <pre class="aui-agent-pre"><code id="aui-agent-prompt-text">{universalAgentPrompt}</code></pre>
        </div>
      </Specimen>

      <!-- Machine-Readable Endpoints Grid -->
      <Specimen id="endpoints" name="Machine-Readable Endpoints (llmstxt.org)" description="Programmatic feeds optimized for ingestion by autonomous coding tools." span={2}>
        <div class="aui-agent-endpoints-grid">
          <div class="aui-agent-ep-card">
            <div class="aui-agent-ep-top">
              <span class="aui-agent-ep-badge">llms.txt</span>
              <a href="/llms.txt" target="_blank" class="aui-agent-ep-link">View Raw ↗</a>
            </div>
            <div class="aui-agent-ep-title">Standard Agent Context</div>
            <div class="aui-agent-ep-desc">Curated index following the llmstxt.org specification with rules, setup, and component registry.</div>
            <div class="aui-agent-ep-action">
              <code>https://ui.arpitbhayani.me/llms.txt</code>
              <button type="button" class="aui-agent-ep-copy" onclick="navigator.clipboard.writeText('https://ui.arpitbhayani.me/llms.txt'); this.textContent='✓'; setTimeout(() => this.textContent='Copy', 1500);">Copy</button>
            </div>
          </div>

          <div class="aui-agent-ep-card">
            <div class="aui-agent-ep-top">
              <span class="aui-agent-ep-badge">llms-full.txt</span>
              <a href="/llms-full.txt" target="_blank" class="aui-agent-ep-link">View Raw ↗</a>
            </div>
            <div class="aui-agent-ep-title">Complete LLM Reference</div>
            <div class="aui-agent-ep-desc">Single-file reference containing every component API, TypeScript prop definition, and TSX snippet.</div>
            <div class="aui-agent-ep-action">
              <code>https://ui.arpitbhayani.me/llms-full.txt</code>
              <button type="button" class="aui-agent-ep-copy" onclick="navigator.clipboard.writeText('https://ui.arpitbhayani.me/llms-full.txt'); this.textContent='✓'; setTimeout(() => this.textContent='Copy', 1500);">Copy</button>
            </div>
          </div>

          <div class="aui-agent-ep-card">
            <div class="aui-agent-ep-top">
              <span class="aui-agent-ep-badge">registry.json</span>
              <a href="/r/registry.json" target="_blank" class="aui-agent-ep-link">View Raw ↗</a>
            </div>
            <div class="aui-agent-ep-title">shadcn Registry Manifest</div>
            <div class="aui-agent-ep-desc">Machine-readable index of all 26 public components, styles, and dependency trees.</div>
            <div class="aui-agent-ep-action">
              <code>https://ui.arpitbhayani.me/r/registry.json</code>
              <button type="button" class="aui-agent-ep-copy" onclick="navigator.clipboard.writeText('https://ui.arpitbhayani.me/r/registry.json'); this.textContent='✓'; setTimeout(() => this.textContent='Copy', 1500);">Copy</button>
            </div>
          </div>

          <div class="aui-agent-ep-card">
            <div class="aui-agent-ep-top">
              <span class="aui-agent-ep-badge">AGENTS.md</span>
              <a href="https://raw.githubusercontent.com/arpitbbhayani/aui/main/AGENTS.md" target="_blank" class="aui-agent-ep-link">GitHub ↗</a>
            </div>
            <div class="aui-agent-ep-title">Repository Agent Guide</div>
            <div class="aui-agent-ep-desc">The official agent guide file maintained directly inside the root of the GitHub repository.</div>
            <div class="aui-agent-ep-action">
              <code>raw.githubusercontent.../AGENTS.md</code>
              <button type="button" class="aui-agent-ep-copy" onclick="navigator.clipboard.writeText('https://raw.githubusercontent.com/arpitbbhayani/aui/main/AGENTS.md'); this.textContent='✓'; setTimeout(() => this.textContent='Copy', 1500);">Copy</button>
            </div>
          </div>
        </div>
      </Specimen>

      <!-- Autonomous Agent Rules Box -->
      <Specimen id="agent-rules" name="Autonomous AI Agent Guidelines" description="Core invariants AI models must follow when generating code with Array UI." span={2}>
        <div class="aui-agent-rules-box">
          <div class="aui-agent-rules-head">
            <span class="aui-agent-rules-dot"></span>
            <span class="aui-agent-rules-title">Engineering Rules for AI Assistants</span>
          </div>
          <div class="aui-agent-rules-grid">
            <div class="aui-agent-rule-item">
              <span class="aui-agent-rule-num">01</span>
              <div class="aui-agent-rule-content">
                <strong>Autonomous Workflow</strong>: Never pause to ask the user which components to install. Autonomously execute <code>npx shadcn@latest add @aui/&lt;name&gt; -y</code> and proceed immediately.
              </div>
            </div>
            <div class="aui-agent-rule-item">
              <span class="aui-agent-rule-num">02</span>
              <div class="aui-agent-rule-content">
                <strong>1px Hairline Restraint</strong>: Always preserve 1px hairline borders (<code>#dfded9</code> light, <code>#2c2c38</code> dark). Avoid rounded bouncy containers or heavy box-shadows.
              </div>
            </div>
            <div class="aui-agent-rule-item">
              <span class="aui-agent-rule-num">03</span>
              <div class="aui-agent-rule-content">
                <strong>Strict Crimson Discipline</strong>: Reserve signature crimson (<code>#e5000f</code> / <code>#ff3344</code>) exclusively for primary action buttons, active navigation indicators, and key focus rings.
              </div>
            </div>
            <div class="aui-agent-rule-item">
              <span class="aui-agent-rule-num">04</span>
              <div class="aui-agent-rule-content">
                <strong>High Information Density</strong>: Design layouts with tight margins, tabular monospace metrics, flat tinted card surfaces (<code>bg-muted/30</code>), and editorial typography.
              </div>
            </div>
          </div>
        </div>
      </Specimen>

      <!-- Complete Component CLI Registry Table -->
      <Specimen id="component-matrix" name="Complete Registry Component Directory" description="All 26 components available via the shadcn CLI registry with copyable commands." span={2}>
        <div class="aui-agent-catalog-wrap">
          <div class="aui-agent-table-container">
            <table class="aui-agent-table">
              <thead>
                <tr>
                  <th>Component</th>
                  <th>Registry Target</th>
                  <th>Description</th>
                  <th>CLI Install Command</th>
                </tr>
              </thead>
              <tbody>
                {registryComponents.map((c) => (
                  <tr>
                    <td class="aui-agent-td-name">
                      <a href={`/components#${c.name}`} class="aui-agent-comp-link">{c.title}</a>
                    </td>
                    <td class="aui-agent-td-mono">
                      <code>@aui/{c.name}</code>
                    </td>
                    <td class="aui-agent-td-desc">{c.desc}</td>
                    <td class="aui-agent-td-cmd">
                      <button
                        type="button"
                        class="aui-agent-mini-copy"
                        onclick={`navigator.clipboard.writeText('npx shadcn@latest add @aui/${c.name} -y'); this.classList.add('is-copied'); setTimeout(() => this.classList.remove('is-copied'), 1500);`}
                        title="Click to copy install command"
                      >
                        <code>npx shadcn add @aui/{c.name}</code>
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </Specimen>
    </div>
  </div>
</Layout>

<script>
  const agentPresets: Record<string, string> = {
    universal: `You are an expert engineer building UI with Array UI (@aui), an editorial engineering design system inspired by arpitbhayani.me.

# Documentation & Registry
- Official Site & Catalog: https://ui.arpitbhayani.me
- LLM Context: https://ui.arpitbhayani.me/llms.txt
- Comprehensive Reference: https://ui.arpitbhayani.me/llms-full.txt
- shadcn Registry: https://ui.arpitbhayani.me/r/{name}.json
- Registry Index: https://ui.arpitbhayani.me/r/registry.json
- GitHub Repo: github:arpitbbhayani/aui (Note: NOT on npm registry; install via GitHub or shadcn registry)

# Installation Modes
1. If project uses shadcn/ui:
   - Add "@aui": "https://ui.arpitbhayani.me/r/{name}.json" under "registries" in components.json.
   - Run: npx shadcn@latest add @aui/aui -y (base theme tokens)
   - Run: npx shadcn@latest add @aui/<component> -y (e.g. button, badge, card, terminal, ping-status)
   - Import from "@/components/ui/<component>".
2. If project uses direct package (Next.js, Astro):
   - Run: npm install github:arpitbbhayani/aui (or pnpm add / bun add)
   - Add import "aui/styles.css"; to root layout.
   - Import from "aui/nextjs" (Next.js) or "aui/astro/[Component].astro" (Astro).

# Autonomous Workflow (IMPORTANT):
- When given a task or UI requirement, autonomously select all needed @aui components.
- DO NOT pause or ask the user which components to install.
- Automatically execute the installation command (e.g. \`npx shadcn@latest add @aui/<component> -y\`) and immediately proceed to building the requested interface.

# Aesthetic Rules:
- Palette: Paper canvas in light mode (#f9f8f5), obsidian carbon in dark mode (#121215).
- Hairline borders: Single 1px borders everywhere (#dfded9 in light, #2c2c38 in dark).
- Accents:
  - Signature Crimson (#e5000f in light, #ff3344 in dark) ONLY for primary action buttons, active tabs, and focus rings.
  - Amber (#cc9900) exclusively for engineering maxim quotes and warnings.
  - Emerald (#10b981) for operational status & diff additions; Rose (#f43f5e) for outages & diff deletions.
- Typography: Plus Jakarta Sans / Space Grotesk bold headings, Assistant body (15px base), Lora italic serif quotes, Geist Mono code.
- Always use cn() from @/lib/utils for custom classes.`,
    cursor: `# Array UI (.cursorrules / .cursor/rules/aui.mdc)
You are an expert engineer building interfaces with Array UI (@aui).

- Official Registry: https://ui.arpitbhayani.me/r/{name}.json
- LLM Context: https://ui.arpitbhayani.me/llms.txt
- Full Component APIs: https://ui.arpitbhayani.me/llms-full.txt

## Autonomous Execution Rule
- When building or editing UI, autonomously select required @aui components and execute:
  npx shadcn@latest add @aui/<component> -y
- DO NOT pause or prompt the user for permission to install components.

## Design Constraints
- 1px hairline borders everywhere (#dfded9 in light, #2c2c38 in dark).
- Paper canvas light mode (#f9f8f5), obsidian carbon dark mode (#121215).
- Signature crimson (#e5000f light, #ff3344 dark) strictly for primary action buttons and active indicators.
- Headings: Plus Jakarta Sans / Space Grotesk (tight tracking).
- Body: Assistant (15px dense). Quotes: Lora italic serif. Monospace: Geist Mono.
- Flat tinted surfaces, dense tables, machined telemetry. Never inject arbitrary gradients or heavy shadows.`,
    claude: `# Claude Code Guidelines: Array UI (@aui)

## UI Framework
- Design system: Array UI (https://ui.arpitbhayani.me)
- Registry: https://ui.arpitbhayani.me/r/{name}.json
- Full Context: https://ui.arpitbhayani.me/llms-full.txt

## Component Installation
When implementing requested UI, autonomously run:
npx shadcn@latest add @aui/<component> -y
(e.g., button, badge, card, terminal, diff-block, property-grid, ping-status, maxim)

## Styling & Typography
- 1px hairline borders (#dfded9 light, #2c2c38 dark).
- Paper light canvas (#f9f8f5), obsidian carbon dark canvas (#121215).
- Signature crimson (#e5000f light, #ff3344 dark) reserved for primary actions.
- Amber (#cc9900) exclusively for engineering maxims.
- Always import cn() from "@/lib/utils" for className composition.`,
    windsurf: `# Windsurf Cascade Rules: Array UI (@aui)
- Design System: Array UI (https://ui.arpitbhayani.me)
- Components Registry: https://ui.arpitbhayani.me/r/{name}.json
- Manifest: https://ui.arpitbhayani.me/llms.txt
- Execution Rule: Autonomously install @aui components via CLI (npx shadcn@latest add @aui/<name> -y). Do not halt for confirmation.
- Aesthetics: 1px hairline borders, paper canvas (#f9f8f5) & obsidian carbon (#121215), crimson accent for primary actions only, Assistant/Lora/Geist Mono typography.`,
    cli: `# 1. Configure components.json:
# Under "registries", add:
# "@aui": "https://ui.arpitbhayani.me/r/{name}.json"

# 2. Install base tokens & design system theme:
npx shadcn@latest add @aui/aui -y

# 3. Autonomously install developer & editorial primitives:
npx shadcn@latest add @aui/button @aui/badge @aui/card @aui/terminal @aui/diff-block @aui/property-grid @aui/ping-status -y`
  };

  (window as any).switchAgentPreset = (name: string) => {
    const codeEl = document.getElementById("aui-agent-prompt-text");
    if (codeEl && agentPresets[name]) {
      codeEl.textContent = agentPresets[name];
    }
    document.querySelectorAll(".aui-agent-tab-btn").forEach((btn) => {
      const el = btn as HTMLElement;
      if (el.dataset.preset === name) {
        el.classList.add("is-active");
      } else {
        el.classList.remove("is-active");
      }
    });
  };
</script>
