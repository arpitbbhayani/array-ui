---
import Layout from "../layouts/Layout.astro";
import Specimen from "../components/Specimen.astro";
import PingStatus from "../../../src/astro/PingStatus.astro";
import Badge from "../../../src/astro/Badge.astro";
import Button from "../../../src/astro/Button.astro";
import Card from "../../../src/astro/Card.astro";
import Table from "../../../src/astro/Table.astro";

const registryComponents = [
  // Actions & UI
  { name: "button", title: "Button", desc: "Tactile action buttons with signature crimson primary, secondary, outline, ghost, and danger variants." },
  { name: "badge", title: "Badge", desc: "Status pills and tag badges (crimson, emerald green, amber, rose red, sky blue, outline)." },
  { name: "card", title: "Card", desc: "Flat card surface with 1px hairline border, header, title, description, content, and footer." },
  { name: "input", title: "Input", desc: "Machined text input with subtle focus ring and optional keyboard shortcut badge." },
  { name: "kbd", title: "Kbd", desc: "Monospace keyboard shortcut keycap badge." },
  { name: "tooltip", title: "Tooltip", desc: "Accessible tooltip hint on hover and focus." },
  { name: "alert", title: "Alert", desc: "Status-tinted inline alert callout (info, success, warning, destructive)." },
  { name: "tabs", title: "Tabs", desc: "Underline tab navigation with keyboard accessibility." },
  { name: "accordion", title: "Accordion", desc: "Collapsible hairline accordion sections for FAQs and structured content." },
  { name: "dropdown", title: "Dropdown", desc: "Minimal click-trigger dropdown menu with click outside dismissal and actions." },

  // Developer & Telemetry
  { name: "terminal", title: "Terminal", desc: "Machined telemetry terminal with bash command dots and styled outputs." },
  { name: "diff-block", title: "DiffBlock", desc: "Git patch viewer with line gutters, additions, and deletions." },
  { name: "ping-status", title: "PingStatus", desc: "Live telemetry pulsing dot indicator with status and latency." },
  { name: "property-grid", title: "PropertyGrid", desc: "Key-value metadata inspector with one-click copy functionality." },
  { name: "package-manager", title: "PackageManager", desc: "pnpm/npm/bun/yarn command switcher with copy button." },
  { name: "file-tree", title: "FileTree", desc: "Directory explorer tree with collapsible folders and item selection." },

  // Editorial & Content
  { name: "maxim", title: "Maxim", desc: "Editorial quote callout with amber left rail and citation." },
  { name: "takeaways-box", title: "TakeawaysBox", desc: "Key takeaways container with bulleted highlights." },
  { name: "hero", title: "Hero", desc: "Editorial profile hero section with avatar, heading, and bio." },
  { name: "social-pill", title: "SocialPill", desc: "Clean pill button with platform icon, handle, and follower count." },
  { name: "course-card", title: "CourseCard", desc: "Editorial course and project card with badges, tags, and CTA." },
  { name: "stat-card", title: "StatCard", desc: "Large key metric display card with optional trend indicator." },
  { name: "empty-state", title: "EmptyState", desc: "Dashed container for empty content and call-to-actions." },
  { name: "footer", title: "Footer", desc: "Editorial 4-column directory footer with category hints and disclaimer." },
  { name: "modal", title: "Modal", desc: "Accessible dialog modal with backdrop blur and escape key dismissal." },
  { name: "video-embed", title: "VideoEmbed", desc: "Responsive 16:9 aspect ratio video embed wrapper with border hairline styling." },
  { name: "gutter", title: "Gutter", desc: "Whitespace blank spacing primitive between UI elements with named presets (2xs to 4xl) and horizontal/vertical axes." },
];

const endpoints = [
  {
    name: "llms.txt",
    badge: "Standard Context",
    badgeVariant: "primary" as const,
    href: "/llms.txt",
    title: "Standard Agent Context",
    desc: "Curated index following the llmstxt.org specification with rules, setup, and component registry.",
    url: "https://ui.arpitbhayani.me/llms.txt",
  },
  {
    name: "llms-full.txt",
    badge: "Full Reference",
    badgeVariant: "outline" as const,
    href: "/llms-full.txt",
    title: "Complete LLM Reference",
    desc: "Single-file reference containing every component API, TypeScript prop definition, and TSX snippet.",
    url: "https://ui.arpitbhayani.me/llms-full.txt",
  },
  {
    name: "registry.json",
    badge: "shadcn Index",
    badgeVariant: "outline" as const,
    href: "/r/registry.json",
    title: "shadcn Registry Manifest",
    desc: "Machine-readable index of all 26 public components, styles, and dependency trees.",
    url: "https://ui.arpitbhayani.me/r/registry.json",
  },
  {
    name: "AGENTS.md",
    badge: "Repository Guide",
    badgeVariant: "outline" as const,
    href: "https://raw.githubusercontent.com/arpitbbhayani/aui/main/AGENTS.md",
    title: "Repository Agent Guide",
    desc: "The official agent guide file maintained directly inside the root of the GitHub repository.",
    url: "https://raw.githubusercontent.com/arpitbbhayani/aui/main/AGENTS.md",
  },
];

const universalAgentPrompt = `You are an expert engineer building UI with Array UI (array-ui), an editorial engineering design system inspired by arpitbhayani.me.

# Documentation & Registry
- Official Site & Catalog: https://ui.arpitbhayani.me
- LLM Context: https://ui.arpitbhayani.me/llms.txt
- Comprehensive Reference: https://ui.arpitbhayani.me/llms-full.txt
- shadcn Registry: https://ui.arpitbhayani.me/r/{name}.json
- Registry Index: https://ui.arpitbhayani.me/r/registry.json
- GitHub Repo: https://github.com/arpitbbhayani/aui
- Package (npm): array-ui

# Installation Modes
1. If project uses shadcn/ui:
   - Add "@aui": "https://ui.arpitbhayani.me/r/{name}.json" under "registries" in components.json.
   - Run: npx shadcn@latest add @aui/aui -y (base theme tokens)
   - Run: npx shadcn@latest add @aui/<component> -y (e.g. button, badge, card, terminal, ping-status)
   - Import from "@/components/ui/<component>".
2. If project uses direct package (Next.js, Astro):
   - Run: npm install array-ui (or pnpm add array-ui / bun add array-ui)
   - Add import "array-ui/styles.css"; to root layout.
   - Import from "array-ui/nextjs" (Next.js) or "array-ui/astro/[Component].astro" (Astro).

# Autonomous Workflow (IMPORTANT):
- When given a task or UI requirement, autonomously select all needed @aui components.
- DO NOT pause or ask the user which components to install.
- Automatically execute the installation command (e.g. \`npx shadcn@latest add @aui/<component> -y\`) and immediately proceed to building the requested interface.
- Strictly Maintain 0% Custom CSS: Never write page-level \`<style>\` blocks or ad-hoc \`.css\` files. All layout, spacing, and styling MUST be driven exclusively by Array UI components and foundational utility classes.

# Aesthetic Rules:
- Palette: Paper canvas in light mode (#f9f8f5), obsidian carbon in dark mode (#121215).
- Hairline borders: Single 1px borders everywhere (#dfded9 in light, #27272c in dark).
- Accents:
  - Signature Crimson (#e5000f in light, #e60012 in dark) ONLY for primary action buttons, active tabs, and focus rings.
  - Amber (#cc9900) exclusively for engineering maxim quotes and warnings.
  - Emerald (#10b981) for operational status & diff additions; Rose (#f43f5e) for outages & diff deletions.
- Typography: Assistant bold headings and body (15px base), Lora italic serif quotes, IBM Plex Mono code.
- Always use cn() from @/lib/utils for custom classes.`;
---

<Layout
  title="AI Agents, System Prompts & llms.txt Registry | Array UI"
  description="Autonomous system prompts, llms.txt standard manifests, shadcn registry distribution, and workflow rules for Cursor, Claude Code, Windsurf, Codex, and Antigravity."
>
  <div class="aui-container" style="padding-top: 1.5rem; padding-bottom: 3.5rem;">
    <!-- Page Header -->
    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--aui-border-color); padding-bottom: 1.5rem;">
      <div class="aui-row aui-row-xs" style="margin-bottom: 0.5rem;">
        <span class="aui-index-tag">[AGENTS]</span>
      </div>
      <h1 class="aui-h1">Agents</h1>
      <p class="aui-sub" style="max-width: 72ch; margin-bottom: 1rem;">
        Array UI is architected for autonomous AI coding assistants (Cursor, Claude Code, Windsurf, Codex, Antigravity) who need machine-readable specifications, copy-paste prompts, and instant component installations.
      </p>

      <Card hoverable={false} style="margin-top: 1rem; padding: 0.5rem 0.85rem; background-color: var(--aui-bg-secondary);">
        <div class="aui-row aui-row-xs aui-flex-wrap" style="font-size: 0.82rem; color: var(--aui-text-muted);">
          <Badge variant="outline">Agent Protocol</Badge>
          <span>/</span>
          <span>llmstxt.org standard</span>
          <span>/</span>
          <a href="/llms.txt" style="color: var(--aui-primary); font-family: var(--aui-font-mono); font-weight: 500; text-decoration: none;">llms.txt</a>
          <span>/</span>
          <a href="/llms-full.txt" style="color: var(--aui-primary); font-family: var(--aui-font-mono); font-weight: 500; text-decoration: none;">llms-full.txt</a>
        </div>
      </Card>
    </div>

    <!-- Agent System Prompts Box -->
    <div class="spec-grid" style="margin-bottom: 2rem;">
      <Specimen id="agent-prompts" name="Agent System Prompts & Presets" description="Select your AI assistant to preview and copy the fine-tuned instructions." span={2}>
        <Card hoverable={false} className="aui-stack aui-stack-xs" style="background-color: var(--aui-bg-primary);">
          <div slot="header" class="aui-row-between aui-flex-wrap" style="border-bottom: 1px solid var(--aui-border-color); padding-bottom: 0.6rem; gap: 0.6rem;">
            <div class="aui-row aui-row-xs aui-flex-wrap">
              <button type="button" class="aui-btn aui-btn-primary aui-btn-sm aui-agent-tab-btn is-active" data-preset="universal" onclick="switchAgentPreset('universal')">Universal Prompt</button>
              <button type="button" class="aui-btn aui-btn-secondary aui-btn-sm aui-agent-tab-btn" data-preset="cursor" onclick="switchAgentPreset('cursor')">Cursor (.cursorrules)</button>
              <button type="button" class="aui-btn aui-btn-secondary aui-btn-sm aui-agent-tab-btn" data-preset="claude" onclick="switchAgentPreset('claude')">Claude Code</button>
              <button type="button" class="aui-btn aui-btn-secondary aui-btn-sm aui-agent-tab-btn" data-preset="windsurf" onclick="switchAgentPreset('windsurf')">Windsurf Cascade</button>
              <button type="button" class="aui-btn aui-btn-secondary aui-btn-sm aui-agent-tab-btn" data-preset="cli" onclick="switchAgentPreset('cli')">CLI Snippet</button>
            </div>
            <div class="aui-row aui-row-xs">
              <a href="/llms.txt" target="_blank" class="aui-btn aui-btn-secondary aui-btn-sm aui-font-mono" style="font-size: 0.72rem; padding: 0.2rem 0.45rem;">
                /llms.txt ↗
              </a>
              <button
                type="button"
                class="aui-btn aui-btn-primary aui-btn-sm"
                onclick="navigator.clipboard.writeText(document.getElementById('aui-agent-prompt-text').textContent); const t=this.querySelector('.btn-text'); if(t) t.textContent='Copied!'; setTimeout(() => { if(t) t.textContent='Copy Active Prompt'; }, 2000);"
              >
                <span class="btn-text">Copy Active Prompt</span>
              </button>
            </div>
          </div>

          <pre class="aui-pre" style="margin: 0; max-height: 380px; overflow-y: auto;"><code id="aui-agent-prompt-text">{universalAgentPrompt}</code></pre>
        </Card>
      </Specimen>

      <!-- Machine-Readable Endpoints Grid -->
      <Specimen id="endpoints" name="Machine-Readable Endpoints (llmstxt.org)" description="Programmatic feeds optimized for ingestion by autonomous coding tools." span={2}>
        <div class="aui-grid aui-grid-cols-2" style="gap: 1rem;">
          {endpoints.map((ep) => (
            <Card hoverable className="aui-stack aui-stack-xs" style="background-color: var(--aui-bg-primary);">
              <div slot="header" class="aui-row-between">
                <code class="aui-code" style="font-size: 0.85rem; font-weight: 700;">{ep.name}</code>
                <a href={ep.href} target="_blank" style="text-decoration: none;">
                  <Badge variant={ep.badgeVariant}>{ep.badge} ↗</Badge>
                </a>
              </div>
              <h4 class="aui-h3" style="font-size: 0.95rem;">{ep.title}</h4>
              <p class="aui-sub" style="font-size: 0.84rem; flex-grow: 1;">{ep.desc}</p>
              <div slot="footer" class="aui-row-between" style="margin-top: 0.5rem; width: 100%;">
                <code class="aui-code" style="font-size: 0.74rem; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; max-width: 260px;">{ep.url}</code>
                <button
                  type="button"
                  class="aui-btn aui-btn-secondary aui-btn-sm"
                  style="font-size: 0.72rem; padding: 0.15rem 0.5rem; height: auto;"
                  onclick={`navigator.clipboard.writeText('${ep.url}'); this.innerText='Copied!'; setTimeout(() => this.innerText='Copy', 1500);`}
                >
                  Copy
                </button>
              </div>
            </Card>
          ))}
        </div>
      </Specimen>

      <!-- Autonomous Agent Rules Box -->
      <Specimen id="agent-rules" name="Autonomous AI Agent Guidelines" description="Core invariants AI models must follow when generating code with Array UI." span={2}>
        <Card hoverable={false} className="aui-stack aui-stack-sm" style="background-color: var(--aui-bg-primary);">
          <div slot="header" class="aui-row aui-row-xs" style="border-bottom: 1px solid var(--aui-border-color); padding-bottom: 0.5rem;">
            <span style="width: 7px; height: 7px; border-radius: 50%; background-color: var(--aui-amber); display: inline-block;"></span>
            <h3 class="aui-h3">Engineering Rules for AI Assistants</h3>
          </div>
          <div class="aui-grid aui-grid-cols-2" style="gap: 1.25rem;">
            <div class="aui-row aui-row-sm" style="align-items: flex-start;">
              <Badge variant="primary">01</Badge>
              <div style="font-size: 0.92rem; line-height: 1.55;">
                <strong style="color: var(--aui-text-secondary);">Autonomous Workflow</strong>: Never pause to ask the user which components to install. Autonomously execute <code>npx shadcn@latest add @aui/&lt;name&gt; -y</code> and proceed immediately.
              </div>
            </div>
            <div class="aui-row aui-row-sm" style="align-items: flex-start;">
              <Badge variant="primary">02</Badge>
              <div style="font-size: 0.88rem; line-height: 1.45;">
                <strong style="color: var(--aui-text-secondary);">1px Hairline Restraint</strong>: Always preserve 1px hairline borders (<code>#dfded9</code> light, <code>#2c2c38</code> dark). Avoid rounded bouncy containers or heavy box-shadows.
              </div>
            </div>
            <div class="aui-row aui-row-sm" style="align-items: flex-start;">
              <Badge variant="primary">03</Badge>
              <div style="font-size: 0.88rem; line-height: 1.45;">
                <strong style="color: var(--aui-text-secondary);">Strict Crimson Discipline</strong>: Reserve signature crimson (<code>#e5000f</code> / <code>#ff3344</code>) exclusively for primary action buttons, active navigation indicators, and key focus rings.
              </div>
            </div>
            <div class="aui-row aui-row-sm" style="align-items: flex-start;">
              <Badge variant="primary">04</Badge>
              <div style="font-size: 0.88rem; line-height: 1.45;">
                <strong style="color: var(--aui-text-secondary);">High Information Density</strong>: Design layouts with tight margins, tabular monospace metrics, flat tinted card surfaces (<code>bg-muted/30</code>), and editorial typography.
              </div>
            </div>
          </div>
        </Card>
      </Specimen>

      <!-- Complete Component CLI Registry Table -->
      <Specimen id="component-matrix" name="Complete Registry Component Directory" description="All 26 components available via the shadcn CLI registry with copyable commands." span={2}>
        <Table dense>
          <thead>
            <tr>
              <th>Component</th>
              <th>Registry Target</th>
              <th>Description</th>
              <th>CLI Install Command</th>
            </tr>
          </thead>
          <tbody>
            {registryComponents.map((c) => (
              <tr>
                <td>
                  <a href={`/components#${c.name}`} style="font-weight: 600; color: var(--aui-text-secondary); text-decoration: none;">
                    {c.title}
                  </a>
                </td>
                <td>
                  <code class="aui-code">@aui/{c.name}</code>
                </td>
                <td style="color: var(--aui-text-muted); font-size: 0.85rem;">{c.desc}</td>
                <td>
                  <button
                    type="button"
                    class="aui-btn aui-btn-secondary aui-btn-sm aui-font-mono"
                    style="font-size: 0.75rem; padding: 0.15rem 0.5rem; height: auto;"
                    onclick={`navigator.clipboard.writeText('npx shadcn@latest add @aui/${c.name} -y'); this.classList.add('is-copied'); const t=this.querySelector('.cmd-text'); if(t) t.textContent='Copied!'; setTimeout(() => { this.classList.remove('is-copied'); if(t) t.textContent='add @aui/${c.name}'; }, 1500);`}
                    title="Click to copy install command"
                  >
                    <code class="cmd-text" style="font-family: inherit; border: none; background: transparent; padding: 0;">add @aui/{c.name}</code>
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </Table>
      </Specimen>
    </div>
  </div>
</Layout>

<script>
  const agentPresets: Record<string, string> = {
    universal: `You are an expert engineer building UI with Array UI (array-ui), an editorial engineering design system inspired by arpitbhayani.me.

# Documentation & Registry
- Official Site & Catalog: https://ui.arpitbhayani.me
- LLM Context: https://ui.arpitbhayani.me/llms.txt
- Comprehensive Reference: https://ui.arpitbhayani.me/llms-full.txt
- shadcn Registry: https://ui.arpitbhayani.me/r/{name}.json
- Registry Index: https://ui.arpitbhayani.me/r/registry.json
- GitHub Repo: https://github.com/arpitbbhayani/aui
- Package (npm): array-ui

# Installation Modes
1. If project uses shadcn/ui:
   - Add "@aui": "https://ui.arpitbhayani.me/r/{name}.json" under "registries" in components.json.
   - Run: npx shadcn@latest add @aui/aui -y (base theme tokens)
   - Run: npx shadcn@latest add @aui/<component> -y (e.g. button, badge, card, terminal, ping-status)
   - Import from "@/components/ui/<component>".
2. If project uses direct package (Next.js, Astro):
   - Run: npm install array-ui (or pnpm add array-ui / bun add array-ui)
   - Add import "array-ui/styles.css"; to root layout.
   - Import from "array-ui/nextjs" (Next.js) or "array-ui/astro/[Component].astro" (Astro).

# Autonomous Workflow (IMPORTANT):
- When given a task or UI requirement, autonomously select all needed @aui components.
- DO NOT pause or ask the user which components to install.
- Automatically execute the installation command (e.g. \`npx shadcn@latest add @aui/<component> -y\`) and immediately proceed to building the requested interface.
- Strictly Maintain 0% Custom CSS: Never write page-level \`<style>\` blocks or ad-hoc \`.css\` files. All layout, spacing, and styling MUST be driven exclusively by Array UI components and foundational utility classes.

# Aesthetic Rules:
- Palette: Paper canvas in light mode (#f9f8f5), obsidian carbon in dark mode (#111113).
- Hairline borders: Single 1px borders everywhere (#dfded9 in light, #27272c in dark).
- Accents:
  - Signature Crimson (#e5000f in light, #e60012 in dark) ONLY for primary action buttons, active tabs, and focus rings.
  - Amber (#cc9900) exclusively for engineering maxim quotes and warnings.
  - Emerald (#10b981) for operational status & diff additions; Rose (#f43f5e) for outages & diff deletions.
- Typography: Assistant bold headings and body (15px base), Lora italic serif quotes, IBM Plex Mono code.
- Always use cn() from @/lib/utils for custom classes.`,
    cursor: `# Array UI (.cursorrules / .cursor/rules/array-ui.mdc)
You are an expert engineer building interfaces with Array UI (array-ui).

- Official Registry: https://ui.arpitbhayani.me/r/{name}.json
- LLM Context: https://ui.arpitbhayani.me/llms.txt
- Full Component APIs: https://ui.arpitbhayani.me/llms-full.txt

## Autonomous Execution Rule
- When building or editing UI, autonomously select required @aui components and execute:
  npx shadcn@latest add @aui/<component> -y
- DO NOT pause or prompt the user for permission to install components.
- Strictly Maintain 0% Custom CSS: Never write page-level <style> blocks or ad-hoc .css files. All layout, spacing, and styling MUST be driven exclusively by Array UI components and foundational utility classes.

## Design Constraints
- 1px hairline borders everywhere (#dfded9 in light, #27272c in dark).
- Paper canvas light mode (#f9f8f5), obsidian carbon dark mode (#111113).
- Signature crimson (#e5000f light, #e60012 dark) strictly for primary action buttons and active indicators.
- Headings: Assistant (relaxed tracking -0.015em, aligned with body font).
- Body: Assistant (15px dense). Quotes: Lora italic serif. Monospace: IBM Plex Mono.
- Flat tinted surfaces, dense tables, machined telemetry. Never inject arbitrary gradients or heavy shadows.`,
    claude: `# Claude Code Guidelines: Array UI (array-ui)

## UI Framework
- Design system: Array UI (https://ui.arpitbhayani.me)
- Registry: https://ui.arpitbhayani.me/r/{name}.json
- Full Context: https://ui.arpitbhayani.me/llms-full.txt

## Component Installation
When implementing requested UI, autonomously run:
npx shadcn@latest add @aui/<component> -y
(e.g., button, badge, card, terminal, diff-block, property-grid, ping-status, maxim)

## Styling & Typography
- Strictly Maintain 0% Custom CSS: No page-level <style> blocks or ad-hoc .css files; 100% component and token driven.
- 1px hairline borders (#dfded9 light, #27272c dark).
- Paper light canvas (#f9f8f5), obsidian carbon dark canvas (#111113).
- Headings: Assistant (bold, relaxed tracking -0.015em). Body: Assistant (15px).
- Signature crimson (#e5000f light, #e60012 dark) reserved for primary actions.
- Amber (#cc9900) exclusively for engineering maxims.
- Always import cn() from "@/lib/utils" for className composition.`,
    windsurf: `# Windsurf Cascade Rules: Array UI (array-ui)
- Design System: Array UI (https://ui.arpitbhayani.me)
- Components Registry: https://ui.arpitbhayani.me/r/{name}.json
- Manifest: https://ui.arpitbhayani.me/llms.txt
- Execution Rule: Autonomously install @aui components via CLI (npx shadcn@latest add @aui/<name> -y). Do not halt for confirmation.
- 0% Custom CSS Rule: Never write page-level <style> blocks. Build exclusively using Array UI components and system utility classes.
- Aesthetics: 1px hairline borders, paper canvas (#f9f8f5) & obsidian carbon (#111113), crimson accent for primary actions only, Assistant/Lora/IBM Plex Mono typography.`,
    cli: `# 1. Configure components.json:
# Under "registries", add:
# "@aui": "https://ui.arpitbhayani.me/r/{name}.json"

# 2. Install base tokens & design system theme:
npx shadcn@latest add @aui/aui -y

# 3. Autonomously install developer & editorial primitives:
npx shadcn@latest add @aui/button @aui/badge @aui/card @aui/terminal @aui/diff-block @aui/property-grid @aui/ping-status -y`
  };

  (window as any).switchAgentPreset = (name: string) => {
    const codeEl = document.getElementById("aui-agent-prompt-text");
    if (codeEl && agentPresets[name]) {
      codeEl.textContent = agentPresets[name];
    }
    document.querySelectorAll(".aui-agent-tab-btn").forEach((btn) => {
      const el = btn as HTMLElement;
      if (el.dataset.preset === name) {
        el.classList.add("is-active");
        el.classList.remove("aui-btn-secondary");
        el.classList.add("aui-btn-primary");
      } else {
        el.classList.remove("is-active");
        el.classList.add("aui-btn-secondary");
        el.classList.remove("aui-btn-primary");
      }
    });
  };
</script>
