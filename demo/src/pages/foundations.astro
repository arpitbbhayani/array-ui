---
import Layout from "../layouts/Layout.astro";
import Specimen from "../components/Specimen.astro";
import Badge from "../../../src/astro/Badge.astro";
import Card from "../../../src/astro/Card.astro";
import Gutter from "../../../src/astro/Gutter.astro";
import { CodeBlock as ReactCodeBlock } from "../../../dist/react.js";

const colorTokens = [
  { name: "Canvas Primary", v: "--aui-bg-primary" },
  { name: "Canvas Secondary", v: "--aui-bg-secondary" },
  { name: "Canvas Tertiary", v: "--aui-bg-tertiary" },
  { name: "Signature Crimson", v: "--aui-primary" },
  { name: "Hairline Border", v: "--aui-border-color" },
  { name: "Strong Border", v: "--aui-border-strong" },
  { name: "Carbon Primary", v: "--aui-text-primary" },
  { name: "Carbon Secondary", v: "--aui-text-secondary" },
  { name: "Carbon Muted", v: "--aui-text-muted" },
  { name: "Operational Emerald", v: "--aui-success" },
  { name: "Warning Amber", v: "--aui-warning" },
  { name: "Outage Rose", v: "--aui-danger" },
  { name: "Code Block BG", v: "--aui-pre-bg" },
  { name: "Hover Surface", v: "--aui-clickable-hover" },
  { name: "Active Surface", v: "--aui-clickable-active" },
  { name: "Glass Blur Surface", v: "--aui-bg-glass" },
];

const radii = [
  { label: "sm · 4px", v: "--aui-radius-sm" },
  { label: "md · 8px", v: "--aui-radius-md" },
  { label: "lg · 12px", v: "--aui-radius-lg" },
];

const shadows = [
  { label: "xs (Subtle)", v: "--aui-shadow-xs" },
  { label: "Hover Lift", v: "--aui-box-shadow-hover" },
  { label: "Modal / Large", v: "--aui-box-shadow-lg" },
];

const shadcnBridgeCode = `:root {
  --background: 43 25% 97%;   /* #faf9f5 Paper */
  --foreground: 247 7% 19%;   /* #2d2c33 Carbon */
  --primary: 356 100% 45%;    /* #e5000f Signature Crimson */
  --border: 41 24% 86%;       /* #e5e0d3 Hairline */
}
.dark {
  --background: 240 6% 7%;    /* #111113 Obsidian Carbon */
  --foreground: 240 5% 85%;   /* #d6d6dc Soft White */
  --primary: 355 100% 45%;    /* #e60012 Crimson Dark */
  --border: 240 5% 16%;       /* #27272c Hairline */
}`;

const spacingScale = [
  { name: "none", rem: "0", px: "0px", class: "aui-gutter-none" },
  { name: "2xs", rem: "0.25rem", px: "4px", class: "aui-gutter-2xs" },
  { name: "xs", rem: "0.5rem", px: "8px", class: "aui-gutter-xs" },
  { name: "sm", rem: "0.75rem", px: "12px", class: "aui-gutter-sm" },
  { name: "md", rem: "1.5rem", px: "24px", class: "aui-gutter-md", isDefault: true },
  { name: "lg", rem: "2.25rem", px: "36px", class: "aui-gutter-lg" },
  { name: "xl", rem: "3rem", px: "48px", class: "aui-gutter-xl" },
  { name: "2xl", rem: "4.5rem", px: "72px", class: "aui-gutter-2xl" },
  { name: "3xl", rem: "6rem", px: "96px", class: "aui-gutter-3xl" },
  { name: "4xl", rem: "8rem", px: "128px", class: "aui-gutter-4xl" },
];

const layoutFlows = [
  { primitive: ".aui-stack", desc: "Vertical flex column flow", defaultGap: "1rem (16px)", variants: ".aui-stack-xs (0.25rem), .aui-stack-sm (0.5rem), .aui-stack-lg (1.5rem)" },
  { primitive: ".aui-row", desc: "Horizontal flex row with vertical centering", defaultGap: "0.75rem (12px)", variants: ".aui-row-xs (0.25rem), .aui-row-sm (0.5rem), .aui-row-lg (1.25rem)" },
  { primitive: ".aui-gutter", desc: "Whitespace blank spacer primitive", defaultGap: "1.5rem (24px default)", variants: "<Gutter size=\"lg\" /> or <Gutter orientation=\"horizontal\" />" },
  { primitive: ".aui-theatre-grid", desc: "Responsive 2-column player layout with sticky sidebar", defaultGap: "1.5rem", variants: "minmax(0, 1fr) 340px, collapses on mobile (< 900px)" },
];

const baseInvariants = [
  {
    name: "Enforced [hidden] Dismissal",
    code: "[hidden] { display: none !important; }",
    desc: "Forces display: none with !important on any element with the hidden attribute, ensuring zero DOM footprint regardless of framework or specificity.",
    badge: "base.css",
  },
  {
    name: "Universal Box-Sizing",
    code: "*, *::before, *::after { box-sizing: border-box; }",
    desc: "Predictable mathematical geometry across cards, inputs, and hairline borders without padding overflow.",
    badge: "base.css",
  },
  {
    name: "Viewport Scroll Clearance",
    code: "html { scroll-behavior: smooth; scroll-padding-top: 4.5rem; }",
    desc: "Smooth anchor navigation with automatic offset clearance for fixed headers.",
    badge: "base.css",
  },
  {
    name: "Strict Zero Custom CSS Invariant",
    code: "0% Custom CSS Invariant",
    desc: "Application pages must remain 100% free of ad-hoc .css files and <style> tags, driven entirely by native components and tokens.",
    badge: "AGENTS.md",
  },
];
---

<Layout
  title="Design Foundations, Tokens & Zero-CSS Invariants | Array UI"
  description="Editorial palette (paper & obsidian carbon), mathematical typography scale, 1px hairline borders, and zero-runtime CSS tokens for Next.js, Astro, and React."
>
  <div class="aui-container" style="padding-top: 1.5rem; padding-bottom: 3.5rem;">
    <!-- Page Header -->
    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--aui-border-color); padding-bottom: 1.5rem;">
      <div class="aui-row aui-row-xs" style="margin-bottom: 0.5rem;">
        <span class="aui-index-tag">[02 FOUNDATIONS]</span>
        <Badge variant="outline">Design Tokens</Badge>
      </div>
      <h1 class="aui-h1">Foundations & Design Tokens</h1>
      <p class="aui-sub" style="max-width: 72ch; margin-bottom: 1rem;">
        Array UI is built around mathematical restraint: an editorial paper & obsidian canvas, 1px warm hairline borders, and strict semantic accents. Zero arbitrary gradients, zero neon glows.
      </p>

      <Card hoverable={false} style="margin-top: 1rem; padding: 0.5rem 0.85rem; background-color: var(--aui-bg-secondary);">
        <div class="aui-row aui-row-xs aui-flex-wrap" style="font-size: 0.82rem; color: var(--aui-text-muted);">
          <Badge variant="outline">Zero-Runtime Tokens</Badge>
          <span>/</span>
          <Badge variant="outline">0% Custom CSS</Badge>
          <span>/</span>
          <span>Light (#f9f8f5) & Dark (#121215)</span>
          <span>/</span>
          <code class="aui-code">tokens.css</code>
          <span>/</span>
          <code class="aui-code">base.css</code>
          <span>/</span>
          <code class="aui-code">shadcn.css</code>
        </div>
      </Card>
    </div>

    <!-- Foundations Specimens -->
    <div class="spec-grid" style="margin-bottom: 2rem;">
      <!-- Color Palette -->
      <Specimen id="colors" name="Color Tokens" description="Semantic tokens that automatically swap between Paper light and Obsidian dark. Click any card to copy its CSS variable." span={2}>
        <div class="aui-grid aui-grid-cols-4" style="gap: 0.75rem;">
          {colorTokens.map((t) => (
            <Card
              hoverable
              interactive
              style="cursor: pointer; padding: 0.6rem 0.75rem; background-color: var(--aui-bg-primary);"
              onclick={`navigator.clipboard.writeText('var(${t.v})'); this.style.borderColor = 'var(--aui-success)'; setTimeout(() => this.style.borderColor = '', 1000);`}
            >
              <div class="aui-row aui-row-xs">
                <span style={`width: 22px; height: 22px; border-radius: var(--aui-radius-sm); border: 1px solid var(--aui-border-color); flex-shrink: 0; background: var(${t.v});`}></span>
                <div style="min-width: 0;">
                  <div style="font-size: 0.8rem; font-weight: 600; color: var(--aui-text-secondary); text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">{t.name}</div>
                  <code class="aui-code" style="font-size: 0.7rem; padding: 0.05rem 0.25rem;">{t.v}</code>
                </div>
              </div>
            </Card>
          ))}
        </div>
      </Specimen>

      <!-- Typography -->
      <Specimen id="typography" name="Typography Scale & Typefaces" description="Engineered hierarchy: Assistant headings and body, Lora serif pull quotes, and IBM Plex Mono code." span={2}>
        <div class="aui-stack" style="gap: 1rem;">
          <div style="border-bottom: 1px solid var(--aui-border-color); padding-bottom: 0.75rem;">
            <div style="font-size: 2.2rem; font-family: var(--aui-font-heading); font-weight: 600; letter-spacing: -0.015em; line-height: 1.2; color: var(--aui-text-secondary);">
              Heading 1 · 32px (Assistant)
            </div>
            <span style="font-size: 0.8rem; color: var(--aui-text-muted); font-family: var(--aui-font-mono);">font-heading / semi-bold (600) / -0.015em tracking</span>
          </div>

          <div style="border-bottom: 1px solid var(--aui-border-color); padding-bottom: 0.75rem;">
            <div style="font-family: var(--aui-font-heading); font-size: 1.55rem; font-weight: 600; letter-spacing: -0.01em; color: var(--aui-text-secondary);">
              Heading 2 · 24px: Component & Section Titles
            </div>
            <span style="font-size: 0.8rem; color: var(--aui-text-muted); font-family: var(--aui-font-mono);">font-heading / semi-bold / -0.01em tracking</span>
          </div>

          <div style="border-bottom: 1px solid var(--aui-border-color); padding-bottom: 0.75rem;">
            <div style="font-family: var(--aui-font-heading); font-size: 1.15rem; font-weight: 600; color: var(--aui-text-secondary);">
              Heading 3 · 18px: Card & Widget Headers
            </div>
            <span style="font-size: 0.8rem; color: var(--aui-text-muted); font-family: var(--aui-font-mono);">font-heading / semi-bold / -0.005em tracking</span>
          </div>

          <div style="border-bottom: 1px solid var(--aui-border-color); padding-bottom: 0.75rem;">
            <div style="font-family: var(--aui-font-sans); font-size: 1.02rem; line-height: 1.6; color: var(--aui-text-primary);">
              Body · 15px base (Assistant): Dense, readable, editorial body typography designed for high information density across data screens and engineering essays.
            </div>
            <span style="font-size: 0.8rem; color: var(--aui-text-muted); font-family: var(--aui-font-mono);">font-sans / regular / 15px</span>
          </div>

          <div style="border-bottom: 1px solid var(--aui-border-color); padding-bottom: 0.75rem;">
            <div style="font-family: var(--aui-font-serif); font-style: italic; font-size: 1.25rem; line-height: 1.5; color: var(--aui-text-secondary);">
              “Simplicity is a prerequisite for reliability. Complex systems always fail in complex ways.” (Lora Italic Serif)
            </div>
            <span style="font-size: 0.8rem; color: var(--aui-text-muted); font-family: var(--aui-font-mono);">font-serif / italic / reserved for engineering maxims</span>
          </div>

          <div>
            <div style="font-family: var(--aui-font-mono); font-size: 0.92rem; color: var(--aui-primary);">
              const cluster = new RaftCluster(&#123; id: "cls_01HX98Z", quorum: 3 &#125;); (IBM Plex Mono)
            </div>
            <span style="font-size: 0.8rem; color: var(--aui-text-muted); font-family: var(--aui-font-mono);">font-mono / tabular numbers / telemetry & code</span>
          </div>
        </div>
      </Specimen>

      <!-- Geometry, Radius & Hairlines -->
      <Specimen id="elevation" name="Borders, Radius & Elevation" description="1px hairlines everywhere, flat card surfaces, and restrained shadows.">
        <div class="aui-stack aui-stack-xs" style="margin-bottom: 1.25rem;">
          <div class="aui-font-mono" style="font-size: 0.72rem; text-transform: uppercase; color: var(--aui-text-muted); font-weight: 500; letter-spacing: 0.05em;">Corner Radius</div>
          <div class="aui-row aui-row-sm aui-flex-wrap">
            {radii.map((r) => (
              <Card hoverable={false} style={`border-radius: var(${r.v}); padding: 0.5rem 0.85rem; font-size: 0.82rem; font-weight: 600; text-align: center; background-color: var(--aui-bg-primary);`}>{r.label}</Card>
            ))}
          </div>
        </div>
        <div class="aui-stack aui-stack-xs">
          <div class="aui-font-mono" style="font-size: 0.72rem; text-transform: uppercase; color: var(--aui-text-muted); font-weight: 500; letter-spacing: 0.05em;">Shadows (Subtle Restraint)</div>
          <div class="aui-row aui-row-sm aui-flex-wrap">
            {shadows.map((s) => (
              <Card hoverable={false} style={`box-shadow: var(${s.v}); padding: 0.5rem 0.85rem; font-size: 0.82rem; font-weight: 600; text-align: center; background-color: var(--aui-bg-primary);`}>{s.label}</Card>
            ))}
          </div>
        </div>
      </Specimen>

      <!-- shadcn Bridge -->
      <Specimen id="bridge" name="shadcn Bridge & HSL Tokens" description="How Array UI bidirectional tokens interoperate with shadcn/ui.">
        <div class="aui-stack aui-stack-xs">
          <p class="aui-sub" style="font-size: 0.88rem;">
            Array UI integrates directly with shadcn/ui. CSS variables defined in <code>shadcn.css</code> automatically map to <code>--primary</code>, <code>--secondary</code>, <code>--background</code>, <code>--border</code>, etc.
          </p>
          <ReactCodeBlock
            language="css"
            filename="shadcn.css"
            code={shadcnBridgeCode}
            client:load
          />
        </div>
      </Specimen>

      <!-- Spacing Scale & Gutter Primitives -->
      <Specimen id="spacing" name="Mathematical Spacing & Layout Rhythm" description="Predictable proportional spacing scale from 2xs (4px) to 4xl (128px) for Gutter spacers, Stack gaps, and Row flow." span={2}>
        <div class="aui-stack" style="gap: 1.25rem;">
          <div class="aui-stack aui-stack-xs">
            <div class="aui-font-mono" style="font-size: 0.72rem; text-transform: uppercase; color: var(--aui-text-muted); font-weight: 500; letter-spacing: 0.05em;">Spacing Scale (Gutter & Gaps)</div>
            <div class="aui-grid aui-grid-cols-2" style="gap: 0.75rem;">
              {spacingScale.filter(s => s.name !== "none").map((s) => (
                <Card
                  hoverable
                  interactive
                  style="padding: 0.5rem 0.75rem; background-color: var(--aui-bg-primary); cursor: pointer;"
                  onclick={`navigator.clipboard.writeText('<Gutter size="${s.name}" />'); this.style.borderColor = 'var(--aui-success)'; setTimeout(() => this.style.borderColor = '', 1000);`}
                >
                  <div class="aui-row aui-row-between" style="width: 100%;">
                    <div class="aui-row aui-row-xs">
                      <code class="aui-code" style="font-size: 0.78rem; font-weight: 600; min-width: 2.5rem; text-align: center;">{s.name}</code>
                      <span style="font-size: 0.8rem; color: var(--aui-text-muted); font-family: var(--aui-font-mono);">{s.rem} · {s.px}</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.5rem; flex: 1; justify-content: flex-end; max-width: 50%;">
                      <div style={`height: 12px; width: ${s.rem}; max-width: 100%; background-color: var(--aui-primary); border-radius: var(--aui-radius-sm); opacity: 0.85;`}></div>
                      <span class="aui-font-mono" style="font-size: 0.68rem; color: var(--aui-text-muted);">{s.class}</span>
                    </div>
                  </div>
                </Card>
              ))}
            </div>
          </div>

          <div class="aui-stack aui-stack-xs">
            <div class="aui-font-mono" style="font-size: 0.72rem; text-transform: uppercase; color: var(--aui-text-muted); font-weight: 500; letter-spacing: 0.05em;">Layout Flow Primitives & Rules</div>
            <div class="aui-grid aui-grid-cols-2" style="gap: 0.75rem;">
              {layoutFlows.map((f) => (
                <Card hoverable={false} style="padding: 0.75rem 1rem; background-color: var(--aui-bg-primary);">
                  <div class="aui-stack aui-stack-xs">
                    <div class="aui-row aui-row-between">
                      <code class="aui-code" style="font-size: 0.82rem; font-weight: 600; color: var(--aui-primary);">{f.primitive}</code>
                      <Badge variant="outline">Gap: {f.defaultGap}</Badge>
                    </div>
                    <p style="font-size: 0.82rem; color: var(--aui-text-primary); margin: 0;">{f.desc}</p>
                    <div style="font-size: 0.72rem; color: var(--aui-text-muted); font-family: var(--aui-font-mono);">{f.variants}</div>
                  </div>
                </Card>
              ))}
            </div>
          </div>

          <Card hoverable={false} style="padding: 0.65rem 0.85rem; background-color: var(--aui-bg-secondary); border-left: 3px solid var(--aui-primary);">
            <div style="font-size: 0.82rem; color: var(--aui-text-primary);">
              <strong>Stack Normalization Invariant:</strong> Inside <code>.aui-stack</code> and <code>.aui-theatre-main</code>, margins on nested headings, breadcrumbs (<code>.aui-breadcrumbs</code>), and tabs (<code>.aui-tabs</code>) are normalized to zero to prevent margin collapsing and preserve mathematically pure layout rhythm.
            </div>
          </Card>
        </div>
      </Specimen>

      <!-- Base Resets & Architecture Invariants -->
      <Specimen id="invariants" name="Base Reset & Architectural Invariants" description="Global browser resets and core invariants enforced by base.css and Array UI design rules." span={2}>
        <div class="aui-grid aui-grid-cols-2" style="gap: 0.75rem;">
          {baseInvariants.map((b) => (
            <Card hoverable={false} style="padding: 0.85rem 1rem; background-color: var(--aui-bg-primary);">
              <div class="aui-stack aui-stack-xs">
                <div class="aui-row aui-row-between">
                  <span style="font-size: 0.85rem; font-weight: 600; color: var(--aui-text-secondary);">{b.name}</span>
                  <Badge variant="outline">{b.badge}</Badge>
                </div>
                <code class="aui-code" style="font-size: 0.75rem; color: var(--aui-primary);">{b.code}</code>
                <p style="font-size: 0.8rem; color: var(--aui-text-muted); margin: 0.25rem 0 0;">{b.desc}</p>
              </div>
            </Card>
          ))}
        </div>
      </Specimen>
    </div>
  </div>
</Layout>
