---
import Layout from "../layouts/Layout.astro";
import Specimen from "../components/Specimen.astro";
import HeroDeck from "../components/HeroDeck.astro";
import Button from "../../../src/astro/Button.astro";
import Badge from "../../../src/astro/Badge.astro";
import PingStatus from "../../../src/astro/PingStatus.astro";
import PackageManager from "../../../src/astro/PackageManager.astro";
import { CodeBlock as ReactCodeBlock } from "../../../dist/react.js";

const categories = [
  {
    tag: "[03]",
    title: "Developer & Telemetry",
    desc: "Machined infrastructure controls: telemetry terminals, git diff viewers, pulsing heartbeat dots, and property key-value inspectors.",
    href: "/components#ping-status",
    pills: ["Terminal", "DiffBlock", "PingStatus", "PropertyGrid", "FileTree", "PackageManager"],
  },
  {
    tag: "[04]",
    title: "Core Actions & UI",
    desc: "Tactile action buttons with signature crimson primary, status pills, hairline cards, monospace keycaps, and dropdowns.",
    href: "/components#buttons",
    pills: ["Button", "Badge", "Card", "Kbd", "Tooltip", "Dropdown", "SegmentedControl"],
  },
  {
    tag: "[05]",
    title: "Forms & Inputs",
    desc: "Dense inputs with keyboard shortcut badges, select menus, auto-expanding textareas, and debounced search boxes.",
    href: "/components#input",
    pills: ["Input", "Select", "Textarea", "SearchBox", "Switch", "Checkbox"],
  },
  {
    tag: "[06]",
    title: "Feedback & Overlays",
    desc: "Status-tinted inline alerts, transient toast notifications, progress indicators, skeleton loaders, and accessible modals.",
    href: "/components#alert",
    pills: ["Alert", "Toast", "Progress", "Spinner", "Skeleton", "Modal", "EmptyState"],
  },
  {
    tag: "[07]",
    title: "Data Display",
    desc: "Typed sortable tables, timeline event feeds, large metric stat cards, avatar clusters, and syntax-highlighted code blocks.",
    href: "/components#table",
    pills: ["Table", "Timeline", "StatCard", "Avatar", "CodeBlock"],
  },
  {
    tag: "[08]",
    title: "Navigation",
    desc: "Underline tab bars, collapsible hairline accordions, breadcrumb trails, pagination bars, and scroll-spy table of contents.",
    href: "/components#tabs",
    pills: ["Tabs", "Accordion", "Breadcrumbs", "Pagination", "TableOfContents", "Sidebar"],
  },
  {
    tag: "[09]",
    title: "Editorial & Content",
    desc: "Signature amber maxim callouts, crimson takeaway boxes, profile portrait heroes, OpenGraph cover cards, and course cards.",
    href: "/components#hero",
    pills: ["Maxim", "TakeawaysBox", "Hero", "CourseCard", "CoverCard", "VideoEmbed", "SocialPill"],
  },
  {
    tag: "[02]",
    title: "Design Foundations",
    desc: "Semantic zero-runtime CSS tokens: Paper light canvas (#f9f8f5), Obsidian dark (#121215), and hairline geometry.",
    href: "/foundations",
    pills: ["Colors", "Typography", "Hairline Borders", "Elevation", "CSS Bridge"],
  },
  {
    tag: "[01]",
    title: "Architectural Patterns",
    desc: "Real-world composited layouts: high-density SaaS observability telemetry dashboard and deep-dive technical essays.",
    href: "/patterns",
    pills: ["Telemetry Dashboard", "Technical Essay", "System Console"],
  },
  {
    tag: "[AI]",
    title: "AI Agent & LLM Hub",
    desc: "First-class machine-readable endpoints (llms.txt, llms-full.txt), fine-tuned prompts for Cursor/Claude/Windsurf, and autonomous rules.",
    href: "/agents",
    pills: ["llms.txt", "llms-full.txt", "registry.json", "AGENTS.md", "Autonomous Rules"],
  },
];

const registryHighlights = [
  { name: "button", title: "Button", category: "Actions", desc: "Signature tactile action button with crimson primary variant." },
  { name: "badge", title: "Badge", category: "Actions", desc: "Monospace status pills (green, amber, red, blue, outline)." },
  { name: "card", title: "Card", category: "Surfaces", desc: "Flat card surface with 1px hairline border and structured subcomponents." },
  { name: "terminal", title: "Terminal", category: "Developer", desc: "Machined telemetry terminal with bash command dots and styled outputs." },
  { name: "diff-block", title: "DiffBlock", category: "Developer", desc: "Unified git patch viewer with line gutters, additions, and deletions." },
  { name: "ping-status", title: "PingStatus", category: "Developer", desc: "Live pulsing heartbeat indicator with status and latency." },
  { name: "property-grid", title: "PropertyGrid", category: "Developer", desc: "Key-value metadata inspector with one-click copy functionality." },
  { name: "maxim", title: "Maxim", category: "Editorial", desc: "Amber quotation callout box for engineering principles." },
  { name: "takeaways-box", title: "TakeawaysBox", category: "Editorial", desc: "Crimson bulleted key takeaways callout." },
  { name: "stat-card", title: "StatCard", category: "Telemetry", desc: "Metric display card for dashboards and telemetry." },
];
---

<Layout
  title="Array UI (aui) — Editorial Design System for Engineers & AI Agents"
  description="Array UI (aui): Editorial, typography-led systems engineering design system for engineers and AI coding agents. Complete component registry, llms.txt, and shadcn CLI distribution for ui.arpitbhayani.me."
>
  <div class="aui-container">
    <!-- Hero Section -->
    <section class="landing" id="overview">
      <div class="landing-text">
        <div style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem; align-items: center;">
          <PingStatus status="operational" label="CLI Registry Online" size="sm" />
          <Badge variant="primary">v0.1.0</Badge>
        </div>

        <h1 class="landing-title">
          The design system for engineers & AI agents.
        </h1>

        <p class="landing-sub">
          Inspired by <strong>arpitbhayani.me</strong>. Precision typography, 1px warm hairline borders, and zero-runtime CSS tokens for web engineering.
        </p>

        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.25rem 0 1rem; align-items: center;">
          <a href="/components">
            <Button variant="primary" size="md">Explore Components →</Button>
          </a>
          <a href="/agents">
            <Button variant="secondary" size="md">AI Agent Hub</Button>
          </a>
        </div>

        <div
          class="landing-install-pill"
          onclick="navigator.clipboard.writeText('npx shadcn@latest add @aui/aui -y'); this.classList.add('is-copied'); setTimeout(() => this.classList.remove('is-copied'), 2000);"
          title="Click to copy install command"
        >
          <span class="landing-install-prompt">$</span>
          <span class="landing-install-code">npx shadcn@latest add @aui/aui -y</span>
          <span class="landing-install-copy">
            <svg class="icon-copy" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="icon-check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Copy</span>
          </span>
        </div>
      </div>

      <div class="landing-preview">
        <HeroDeck />
      </div>
    </section>

    <!-- Context & Framework Bar -->
    <div class="docs-framework-bar" style="margin: 0.5rem 0 2rem;">
      <div class="docs-framework-meta">
        <span class="meta-chip">48+ Primitives</span>
        <span class="meta-sep">/</span>
        <span>Astro · Next.js · React · Plain CSS</span>
        <span class="meta-sep">/</span>
        <code>shadcn CLI</code>
        <span class="meta-sep">/</span>
        <a href="/llms.txt" class="meta-llm-link">llms.txt</a>
      </div>
      <div class="docs-framework-pills">
        <span class="docs-framework-pill-label">Registry:</span>
        <a href="/components" class="aui-global-fw-btn is-active">Catalog</a>
        <a href="/foundations" class="aui-global-fw-btn">Foundations</a>
        <a href="/patterns" class="aui-global-fw-btn">Patterns</a>
        <a href="/agents" class="aui-global-fw-btn">AI Hub</a>
      </div>
    </div>

    <!-- Quickstart Guide -->
    <div class="spec-grid" style="margin-bottom: 2rem;">
      <Specimen id="quickstart" name="Two-Minute Quickstart" description="Deploy Array UI via official shadcn CLI or direct repository dependency." span={2}>
        <div class="aui-quickstart-steps">
          <div class="aui-step">
            <span class="aui-step-num">01</span>
            <div class="aui-step-body">
              <div class="aui-step-title">Configure shadcn CLI Registry</div>
              <p class="aui-step-desc">Add Array UI registry endpoint to your <code>components.json</code> registries:</p>
              <ReactCodeBlock
                language="json"
                filename="components.json"
                code={`{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "registries": {
    "@aui": "https://ui.arpitbhayani.me/r/{name}.json"
  }
}`}
                client:load
              />
            </div>
          </div>

          <div class="aui-step">
            <span class="aui-step-num">02</span>
            <div class="aui-step-body">
              <div class="aui-step-title">Install Design Tokens & Components</div>
              <p class="aui-step-desc">Install the base theme and copy-paste any components directly into your codebase:</p>
              <ReactCodeBlock
                language="bash"
                code={`# Install design tokens (Paper light & Obsidian dark)
npx shadcn@latest add @aui/aui -y

# Install core UI and engineering primitives
npx shadcn@latest add @aui/button @aui/badge @aui/card @aui/terminal @aui/diff-block @aui/ping-status -y`}
                client:load
              />
            </div>
          </div>
        </div>
      </Specimen>
    </div>

    <!-- Browse By Category Directory -->
    <div style="margin-bottom: 2.5rem;">
      <div style="display: flex; align-items: baseline; justify-content: space-between; border-bottom: 1px solid var(--aui-border-color); padding-bottom: 0.5rem; margin-bottom: 1rem;">
        <div>
          <h2 class="docs-h2" style="border-bottom: none; margin: 0; padding: 0;">Browse Library by Category</h2>
          <p style="margin: 0.25rem 0 0; font-size: 0.88rem; color: var(--aui-text-muted);">
            Explore all 48+ native components, design tokens, architectural patterns, and AI endpoints.
          </p>
        </div>
        <a href="/components" style="font-size: 0.85rem; font-weight: 600; color: var(--aui-primary); text-decoration: none;">View All 48+ Components →</a>
      </div>

      <div class="docs-category-grid">
        {categories.map((cat) => (
          <a href={cat.href} class="docs-category-card">
            <div class="docs-category-head">
              <span class="docs-category-tag">{cat.tag}</span>
              <span style="font-family: var(--aui-font-mono); font-size: 0.78rem; color: var(--aui-text-muted);">Explore →</span>
            </div>
            <div class="docs-category-title">{cat.title}</div>
            <div class="docs-category-desc">{cat.desc}</div>
            <div class="docs-category-pills">
              {cat.pills.map((pill) => (
                <span class="docs-category-pill">{pill}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Featured Registry Components Table -->
    <div class="spec-grid" style="margin-bottom: 2.5rem;">
      <Specimen id="featured-registry" name="Registry Quick Reference" description="Top shadcn-compatible components available for instant CLI installation." span={2}>
        <div class="aui-agent-catalog-wrap">
          <div class="aui-agent-table-container">
            <table class="aui-agent-table">
              <thead>
                <tr>
                  <th>Component</th>
                  <th>Category</th>
                  <th>Description</th>
                  <th>CLI Command</th>
                </tr>
              </thead>
              <tbody>
                {registryHighlights.map((c) => (
                  <tr>
                    <td class="aui-agent-td-name">
                      <a href={`/components#${c.name}`} class="aui-agent-comp-link">{c.title}</a>
                    </td>
                    <td class="aui-agent-td-mono">
                      <span class="aui-badge aui-badge-light">{c.category}</span>
                    </td>
                    <td class="aui-agent-td-desc">{c.desc}</td>
                    <td class="aui-agent-td-cmd">
                      <button
                        type="button"
                        class="aui-agent-mini-copy"
                        onclick={`navigator.clipboard.writeText('npx shadcn@latest add @aui/${c.name} -y'); this.classList.add('is-copied'); setTimeout(() => this.classList.remove('is-copied'), 1500);`}
                        title="Click to copy install command"
                      >
                        <code>npx shadcn add @aui/{c.name}</code>
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div style="margin-top: 0.75rem; text-align: right;">
            <a href="/agents#component-matrix" style="font-size: 0.84rem; font-weight: 600; color: var(--aui-primary); text-decoration: none;">
              View all 26 registry components in Agent Hub →
            </a>
          </div>
        </div>
      </Specimen>
    </div>

    <!-- Framework Integration -->
    <h2 class="docs-h2"><span class="aui-index-tag">[10]</span> Usage & Frameworks</h2>
    <div class="spec-grid" style="margin-bottom: 3rem;">
      <Specimen id="shadcn" name="shadcn CLI Registry" description="Copy signature aui primitives directly into your project via shadcn CLI.">
        <ReactCodeBlock
          language="bash"
          code={`# Configure registry in components.json, then:
npx shadcn@latest add @aui/button @aui/terminal @aui/ping-status -y

# Installed in @/components/ui/
import { Button } from "@/components/ui/button";
import { Terminal } from "@/components/ui/terminal";`}
          client:load
        />
      </Specimen>

      <Specimen id="nextjs" name="Next.js (App Router / Pages)" description="Direct package dependency with zero-FOUC theme provider.">
        <ReactCodeBlock
          language="tsx"
          filename="app/page.tsx"
          code={`import "aui/styles.css";
import { Button, Terminal, PingStatus } from "aui/nextjs";

export default function Page() {
  return (
    <div>
      <PingStatus status="operational" label="Cluster live" />
      <Button variant="primary">Deploy</Button>
    </div>
  );
}`}
          client:load
        />
      </Specimen>

      <Specimen id="astro" name="Astro Primitives" description="Zero client JavaScript overhead for content sites.">
        <ReactCodeBlock
          language="astro"
          filename="src/pages/index.astro"
          code={`---
import "aui/styles.css";
import Terminal from "aui/astro/Terminal.astro";
import DiffBlock from "aui/astro/DiffBlock.astro";
import PingStatus from "aui/astro/PingStatus.astro";
---
<PingStatus status="operational" label="Healthy" />
<Terminal title="bash" lines={["echo hello"]} />`}
          client:load
        />
      </Specimen>

      <Specimen id="css" name="Plain CSS Tokens" description="Works in any framework or static HTML page.">
        <ReactCodeBlock
          language="html"
          filename="index.html"
          code={`<link rel="stylesheet" href="node_modules/aui/dist/styles.css" />
<body class="aui-body">
  <button class="aui-btn aui-btn-primary aui-btn-md">Deploy</button>
  <span class="aui-badge aui-badge-green">Operational</span>
</body>`}
          client:load
        />
      </Specimen>
    </div>
  </div>
</Layout>
