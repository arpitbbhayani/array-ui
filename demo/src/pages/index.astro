const tableRows = [
  { service: "api-gateway", region: "eu-west-1", p99: "42 ms", status: "Healthy" },
  { service: "ledger-db", region: "us-east-1", p99: "118 ms", status: "Degraded" },
  { service: "search-index", region: "ap-south-1", p99: "67 ms", status: "Healthy" },
  { service: "payments-queue", region: "eu-west-1", p99: "-", status: "Down" },
];

const takeaways = [
  "Zero-dependency core: pure CSS tokens, React, or native Astro.",
  "Theme-first: light and dark with anti-FOUC script.",
  "Dense by default: 15px base, compact controls, tight rhythm.",
];
---

<Layout>
  <!-- Landing -->
  <div class="aui-container aui-canvas-grid" style="border: 1px solid var(--aui-border-color); border-radius: var(--aui-radius-lg); margin-top: 0.5rem; padding: 0.5rem 1.25rem;">
    <section id="overview" class="landing" style="position: relative;">
      <div class="landing-copy">
        <div class="spec-row" style="margin-bottom: 0.85rem;">
          <PingStatus status="operational" label="Array UI · 48 components · v0.1.0" client:load />
          <Badge variant="light">[01] React</Badge>
          <Badge variant="light">[02] Astro</Badge>
          <Badge variant="light">[03] Plain CSS</Badge>
          <Badge variant="crimson">[04] shadcn Registry</Badge>
        </div>
        <h1 class="landing-title">Don’t use this design system.</h1>
        <p class="landing-sub">
          <span class="aui-font-serif aui-italic" style="font-size: 1.15rem; display: block; margin-bottom: 0.45rem; color: var(--aui-text-secondary); line-height: 1.45;">
            "Unless you are an engineer who genuinely cares about words, typography, and mathematical rigor."
          </span>
          A dense, systems-first design system with zero-runtime CSS, React, and native Astro primitives.
        </p>
        <div class="spec-row" style="margin-bottom: 1rem;">
          <Button href="#ping-status" variant="primary" size="lg">Explore dev tools</Button>
          <Button href="#shadcn" variant="secondary" size="lg">shadcn Registry</Button>
        </div>
        <div class="spec-row" style="margin-bottom: 0.85rem; flex-wrap: wrap; gap: 0.5rem;">
          <div
            class="landing-install-pill"
            title="Click to copy install command from GitHub"
            onclick="navigator.clipboard.writeText('npm i github:arpitbbhayani/aui'); this.classList.add('is-copied'); const t=this.querySelector('.landing-copy-text'); if(t) t.textContent='Copied!'; setTimeout(() => { this.classList.remove('is-copied'); if(t) t.textContent='github'; }, 1600);"
          >
            <span class="landing-install-prompt">$</span>
            <code class="landing-install-code">npm i github:arpitbbhayani/aui</code>
            <span class="landing-install-copy" aria-label="Copy install command">
              <svg class="spec-copy-icon icon-copy" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <svg class="spec-copy-icon icon-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="landing-copy-text">github</span>
            </span>
          </div>
          <div
            class="landing-install-pill"
            title="Click to copy shadcn add command"
            onclick="navigator.clipboard.writeText('npx shadcn@latest add @aui/terminal'); this.classList.add('is-copied'); const t=this.querySelector('.landing-copy-text'); if(t) t.textContent='Copied!'; setTimeout(() => { this.classList.remove('is-copied'); if(t) t.textContent='shadcn'; }, 1600);"
          >
            <span class="landing-install-prompt">$</span>
            <code class="landing-install-code">npx shadcn add @aui/terminal</code>
            <span class="landing-install-copy" aria-label="Copy shadcn add command">
              <svg class="spec-copy-icon icon-copy" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <svg class="spec-copy-icon icon-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="landing-copy-text">shadcn</span>
            </span>
          </div>
        </div>
        <p class="landing-hint">
          Toggle theme <Kbd keys={["⌘", "D"]} /> · Search <Kbd keys={["⌘", "K"]} /> · Jump sections <Kbd>J</Kbd> / <Kbd>K</Kbd>
        </p>
      </div>

      <div class="landing-preview" style="position: relative;">
        <HeroDeck />
      </div>
    </section>
  </div>

  <div class="aui-container" style="margin-top: 0.65rem;">
    <dl class="meta-strip">
      <div><dt>[00] version</dt><dd>0.1.0</dd></div>
      <div><dt>[01] license</dt><dd>MIT</dd></div>
      <div><dt>[02] components</dt><dd>48</dd></div>
      <div><dt>[03] runtime deps</dt><dd>0</dd></div>
      <div><dt>[04] themes</dt><dd>light · dark</dd></div>
    </dl>
  </div>

  <!-- Global Framework Switcher Toolbar -->
  <div class="aui-container" style="margin-top: 0.65rem; margin-bottom: 0.65rem;">
    <div class="docs-framework-bar">
      <div class="docs-framework-label">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        <span>View Code Snippets As:</span>
      </div>
      <div class="docs-framework-pills">
        <button type="button" class="aui-global-fw-btn is-active" data-fw="react" onclick="window.setDocsFramework('react')">
          React
        </button>
        <button type="button" class="aui-global-fw-btn" data-fw="astro" onclick="window.setDocsFramework('astro')">
          Astro
        </button>
        <button type="button" class="aui-global-fw-btn" data-fw="html" onclick="window.setDocsFramework('html')">
          HTML / CSS
        </button>
        <button type="button" class="aui-global-fw-btn" data-fw="shadcn" onclick="window.setDocsFramework('shadcn')">
          shadcn CLI
        </button>
      </div>
      <div class="docs-framework-hint">
        Click to switch all 45 component snippets simultaneously
      </div>
    </div>
  </div>

  <div class="aui-container">
    <!-- Mobile Jump Selector -->
    <div class="mobile-jump-bar">
      <span class="mobile-jump-label">Jump to section:</span>
      <select class="mobile-jump-select" onchange="if(this.value) window.location.hash = this.value;">
        <option value="">Select component / section...</option>
        {sidebarGroups.map((g) => (
          <optgroup label={g.title}>
            {g.links.map((l) => (
              <option value={l.href}>{l.label}</option>
            ))}
          </optgroup>
        ))}
      </select>
    </div>

    <div class="aui-docs">
      <Sidebar groups={sidebarGroups} />

      <main class="docs-main">
        <!-- Install -->
        <h2 class="docs-h2"><span class="aui-index-tag">[00]</span> Getting started</h2>
        <div class="spec-grid">
          <Specimen id="ai-agents" name="AI Coding Agents (Cursor, Claude Code, Windsurf)" description="One-click system prompt to teach your AI coding assistant the complete Array UI design language." span={2}>
            <div class="aui-agent-box">
              <div class="aui-agent-header">
                <div>
                  <div class="aui-agent-title">Drop into Cursor Rules, Windsurf, or Claude Code</div>
                  <div class="aui-agent-sub">Includes aesthetic rules, color constraints, registry endpoints, and component syntax:</div>
                </div>
                <button
                  type="button"
                  class="aui-agent-copy-btn"
                  onclick="navigator.clipboard.writeText(document.getElementById('aui-agent-prompt-text').textContent); this.classList.add('is-copied'); const t=this.querySelector('.aui-agent-btn-text'); if(t) t.textContent='Copied Prompt!'; setTimeout(() => { this.classList.remove('is-copied'); if(t) t.textContent='Copy Agent Prompt'; }, 2000);"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                  </svg>
                  <span class="aui-agent-btn-text">Copy Agent Prompt</span>
                </button>
              </div>
              <pre class="aui-agent-pre"><code id="aui-agent-prompt-text">{`You are an expert engineer building UI with Array UI (@aui), an editorial engineering design system inspired by arpitbhayani.me.

# Documentation & Registry
- AI Agent Guide: https://raw.githubusercontent.com/arpitbbhayani/aui/main/AGENTS.md
- LLM Context: https://ui.arpitbhayani.me/llms.txt
- shadcn Registry: https://ui.arpitbhayani.me/r/{name}.json
- GitHub Repo: github:arpitbbhayani/aui (Note: NOT on npm registry; install via GitHub or shadcn registry)

# Installation Modes
1. If project uses shadcn/ui:
   - Add "@aui": "https://ui.arpitbhayani.me/r/{name}.json" under "registries" in components.json.
   - Run: npx shadcn@latest add @aui/aui -y (base theme tokens)
   - Run: npx shadcn@latest add @aui/<component> -y (e.g. terminal, diff-block, property-grid, ping-status)
   - Import from "@/components/ui/<component>".
2. If project uses direct package (Astro, Next.js, Remix):
   - Run: npm install github:arpitbbhayani/aui (or pnpm add / bun add)
   - Add \`import "aui/styles.css";\` to root layout.
   - Import from "aui/react" (React) or "aui/astro/[Component].astro" (Astro).

# Autonomous Workflow (IMPORTANT):
- When given a task or UI requirement, autonomously select all needed @aui components.
- DO NOT pause or ask the user which components to install.
- Automatically execute the installation command (e.g. \`npx shadcn@latest add @aui/<component> -y\`) and immediately proceed to building the requested interface.

# Aesthetic Rules:
- Palette: Paper canvas in light mode (#f9f8f5), obsidian carbon in dark mode (#0a0a0c).
- Hairline borders: Single 1px borders everywhere (#dfded9 in light, #24242c in dark).
- Accents:
  - Signature Crimson (#e5000f) ONLY for primary action buttons, active tabs, and focus rings.
  - Amber (#cc9900) exclusively for engineering maxim quotes.
  - Emerald (#10b981) for operational status & diff additions; Rose (#f43f5e) for outages & diff deletions.
- Typography: Plus Jakarta Sans / Space Grotesk bold headings, Assistant body (15px base), Lora italic serif quotes, Geist Mono code.
- Always use cn() from @/lib/utils for custom classes.`}</code></pre>
            </div>
          </Specimen>

          <Specimen id="quickstart" name="shadcn Registry Quickstart" description="The recommended copy-paste workflow. Direct CLI installation into your codebase." span={2}>
            <div class="aui-quickstart-steps">
              <div class="aui-step">
                <div class="aui-step-num">01</div>
                <div class="aui-step-body">
                  <div class="aui-step-title">Configure your <code>components.json</code></div>
                  <p class="aui-step-desc">Add the <code>@aui</code> registry namespace pointing to the official registry:</p>
                  <ReactCodeBlock
                    language="json"
                    filename="components.json"
                    code={`{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "registries": {
    "@aui": "https://ui.arpitbhayani.me/r/{name}.json"
  }
}`}
                    client:load
                  />
                </div>
              </div>

              <div class="aui-step">
                <div class="aui-step-num">02</div>
                <div class="aui-step-body">
                  <div class="aui-step-title">Install the Array UI design system theme</div>
                  <p class="aui-step-desc">Applies paper light & obsidian carbon dark palettes, Assistant/Lora typography, and radii:</p>
                  <Terminal
                    title="bash"
                    lines={[
                      { text: "npx shadcn@latest add @aui/aui", kind: "cmd" },
                      { text: "✔ Added @aui design tokens and typography into your Tailwind config and globals.css", kind: "ok" }
                    ]}
                  />
                </div>
              </div>

              <div class="aui-step">
                <div class="aui-step-num">03</div>
                <div class="aui-step-body">
                  <div class="aui-step-title">Add any component</div>
                  <p class="aui-step-desc">Components are dropped straight into <code>components/ui/</code> as clean, fully editable TypeScript + Tailwind code:</p>
                  <Terminal
                    title="bash"
                    lines={[
                      { text: "npx shadcn@latest add @aui/terminal @aui/diff-block @aui/property-grid", kind: "cmd" },
                      { text: "✔ Added terminal.tsx to components/ui/", kind: "ok" },
                      { text: "✔ Added diff-block.tsx to components/ui/", kind: "ok" },
                      { text: "✔ Added property-grid.tsx to components/ui/", kind: "ok" },
                    ]}
                  />
                </div>
              </div>

              <div class="aui-step">
                <div class="aui-step-num">04</div>
                <div class="aui-step-body">
                  <div class="aui-step-title">AI Coding Agent Setup (Cursor, Claude Code, Windsurf)</div>
                  <p class="aui-step-desc">Teach your AI coding assistant the Array UI design system so it builds & reviews matching components:</p>
                  <Terminal
                    title="prompt / rules"
                    lines={[
                      { text: "# In your project's .cursorrules, AGENTS.md, or system prompt:", kind: "out" },
                      { text: "Refer to https://ui.arpitbhayani.me/llms.txt for Array UI component APIs, themes, and design rules.", kind: "cmd" },
                      { text: "Registry catalog: https://ui.arpitbhayani.me/r/registry.json", kind: "out" },
                    ]}
                  />
                </div>
              </div>
            </div>
          </Specimen>

          <Specimen id="install" name="Install (GitHub)" description="Not published on npm registry — install directly from GitHub into any package manager.">
            <Terminal
              title="bash"
              lines={[
                { text: "# npm", kind: "out" },
                { text: "npm install github:arpitbbhayani/aui", kind: "cmd" },
                { text: "# pnpm", kind: "out" },
                { text: "pnpm add github:arpitbbhayani/aui", kind: "cmd" },
                { text: "# bun", kind: "out" },
                { text: "bun add github:arpitbbhayani/aui", kind: "cmd" },
              ]}
            />
            <div class="spec-row">
              <Badge variant="light">aui/styles.css</Badge>
              <Badge variant="light">aui/react</Badge>
              <Badge variant="light">aui/astro/*</Badge>
              <Badge variant="light">aui/tokens</Badge>
              <Badge variant="light">aui/tailwind</Badge>
            </div>
          </Specimen>
          <Specimen id="theme-note" name="Theming" description="Attribute- or class-driven.">
            <Terminal
              title="html"
              lines={[
                { text: '<html data-theme="dark">', kind: "out" },
                { text: '<html class="dark">', kind: "out" },
              ]}
            />
            <p style="margin:0;font-size:0.93rem;color:var(--aui-text-muted);">
              All colors resolve through <code class="aui-code">--aui-*</code> custom properties, so any component re-themes instantly.
            </p>
          </Specimen>

          <Specimen id="component-matrix" name="Components Quick Reference" description="Dual consumption options for each signature primitive." span={2}>
            <div style="overflow-x:auto;">
              <table class="aui-table aui-table-dense" style="width:100%;margin:0;font-size:0.84rem;">
                <thead>
                  <tr>
                    <th>Component</th>
                    <th>shadcn CLI Command</th>
                    <th>GitHub Package (React)</th>
                    <th>GitHub Package (Astro)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>Terminal</strong></td>
                    <td><code>npx shadcn@latest add @aui/terminal</code></td>
                    <td><code>import &#123; Terminal &#125; from "aui/react"</code></td>
                    <td><code>import Terminal from "aui/astro/Terminal.astro"</code></td>
                  </tr>
                  <tr>
                    <td><strong>DiffBlock</strong></td>
