---
import Layout from "../layouts/Layout.astro";
import Specimen from "../components/Specimen.astro";
import HeroDeck from "../components/HeroDeck.astro";
import Button from "../../../src/astro/Button.astro";
import Badge from "../../../src/astro/Badge.astro";
import PingStatus from "../../../src/astro/PingStatus.astro";
import Card from "../../../src/astro/Card.astro";
import Table from "../../../src/astro/Table.astro";
import Alert from "../../../src/astro/Alert.astro";
import { CodeBlock as ReactCodeBlock, PackageManager } from "../../../dist/react.js";

const categories = [
  {
    tag: "[03]",
    title: "Developer & Telemetry",
    desc: "Machined infrastructure controls: telemetry terminals, git diff viewers, pulsing heartbeat dots, and property key-value inspectors.",
    href: "/components#ping-status",
    pills: ["Terminal", "DiffBlock", "PingStatus", "PropertyGrid", "FileTree", "PackageManager"],
  },
  {
    tag: "[04]",
    title: "Core Actions & UI",
    desc: "Tactile action buttons with signature crimson primary, status pills, hairline cards, monospace keycaps, and dropdowns.",
    href: "/components#buttons",
    pills: ["Button", "Badge", "Card", "Kbd", "Tooltip", "Dropdown", "SegmentedControl"],
  },
  {
    tag: "[05]",
    title: "Forms & Inputs",
    desc: "Dense inputs with keyboard shortcut badges, select menus, auto-expanding textareas, and debounced search boxes.",
    href: "/components#input",
    pills: ["Input", "Select", "Textarea", "SearchBox", "Switch", "Checkbox"],
  },
  {
    tag: "[06]",
    title: "Feedback & Overlays",
    desc: "Status-tinted inline alerts, transient toast notifications, progress indicators, skeleton loaders, and accessible modals.",
    href: "/components#alert",
    pills: ["Alert", "Toast", "Progress", "Spinner", "Skeleton", "Modal", "EmptyState"],
  },
  {
    tag: "[07]",
    title: "Data Display",
    desc: "Typed sortable tables, timeline event feeds, large metric stat cards, avatar clusters, and syntax-highlighted code blocks.",
    href: "/components#table",
    pills: ["Table", "Timeline", "StatCard", "Avatar", "CodeBlock"],
  },
  {
    tag: "[08]",
    title: "Navigation",
    desc: "Underline tab bars, collapsible hairline accordions, breadcrumb trails, pagination bars, and scroll-spy table of contents.",
    href: "/components#tabs",
    pills: ["Tabs", "Accordion", "Breadcrumbs", "Pagination", "TableOfContents", "Sidebar"],
  },
  {
    tag: "[09]",
    title: "Editorial & Media",
    desc: "Engineering maxim quotes, takeaways callouts, profile hero sections, interactive social pills, and course cards.",
    href: "/components#callouts",
    pills: ["Maxim", "TakeawaysBox", "Hero", "CourseCard", "SocialPill", "VideoEmbed"],
  },
];

const registryHighlights = [
  { name: "button", title: "Button", category: "Actions", desc: "Signature tactile action button with crimson primary variant." },
  { name: "badge", title: "Badge", category: "Actions", desc: "Monospace status pills (green, amber, red, blue, outline)." },
  { name: "card", title: "Card", category: "Surfaces", desc: "Flat card surface with 1px hairline border and structured subcomponents." },
  { name: "terminal", title: "Terminal", category: "Developer", desc: "Machined telemetry terminal with bash command dots and styled outputs." },
  { name: "diff-block", title: "DiffBlock", category: "Developer", desc: "Unified git patch viewer with line gutters, additions, and deletions." },
  { name: "ping-status", title: "PingStatus", category: "Developer", desc: "Live pulsing heartbeat indicator with status and latency." },
  { name: "property-grid", title: "PropertyGrid", category: "Developer", desc: "Key-value metadata inspector with one-click copy functionality." },
  { name: "maxim", title: "Maxim", category: "Editorial", desc: "Amber quotation callout box for engineering principles." },
  { name: "takeaways-box", title: "TakeawaysBox", category: "Editorial", desc: "Crimson bulleted key takeaways callout." },
  { name: "stat-card", title: "StatCard", category: "Telemetry", desc: "Metric display card for dashboards and telemetry." },
];

const agentQuickstartPrompt = `Set up and build with Array UI (aui) in this project:

1. Design System Context: Read https://ui.arpitbhayani.me/llms.txt for full component reference and architecture rules.
2. Installation (Note: aui is NOT published on the public npm registry):
   - Option A (shadcn CLI Registry - Recommended):
     Configure "registries": { "@aui": "https://ui.arpitbhayani.me/r/{name}.json" } in components.json.
     Run: npx shadcn@latest add @aui/aui -y (installs design tokens)
     Autonomously install any required components via: npx shadcn@latest add @aui/<component> -y (e.g. button, badge, card, terminal, ping-status) without asking for confirmation.
   - Option B (Direct GitHub Dependency):
     Run: pnpm add github:arpitbbhayani/aui (or npm install github:arpitbbhayani/aui / bun add github:arpitbbhayani/aui).
     Import "aui/styles.css" in root layout.
     Import components from "aui/nextjs" (Next.js) or "aui/astro/*" (Astro).
3. Aesthetic Invariants:
   - 1px hairline warm borders everywhere (#dfded9 in light, #2c2c38 in dark).
   - Paper canvas in light mode (#f9f8f5), obsidian carbon in dark mode (#121215).
   - Reserve Signature Crimson (#e5000f light, #ff3344 dark) strictly for primary actions, active tabs, and focus rings.
   - High information density, flat surfaces (bg-muted/30), and monospace telemetry.`;
---

<Layout
  title="Array UI (aui) — Editorial Design System for Engineers & AI Agents"
  description="Array UI (aui): Editorial, typography-led systems engineering design system for engineers and AI coding agents. Complete component registry, llms.txt, and shadcn CLI distribution for ui.arpitbhayani.me."
>
  <div class="aui-container" style="padding-top: 1.5rem; padding-bottom: 3.5rem;">
    <!-- Hero Section -->
    <section class="aui-grid aui-grid-cols-2" id="overview" style="align-items: center; margin-bottom: 2.5rem;">
      <div class="aui-stack aui-stack-sm">
        <div class="aui-row aui-row-xs aui-flex-wrap">
          <PingStatus status="operational" label="CLI Registry Online" size="sm" />
          <Badge variant="outline">github:arpitbbhayani/aui</Badge>
          <Badge variant="primary">v0.1.0</Badge>
        </div>

        <h1 class="aui-h1">
          The design system for engineers & AI agents.
        </h1>

        <p class="aui-sub" style="max-width: 60ch;">
          Inspired by <strong>arpitbhayani.me</strong>. Precision typography, 1px warm hairline borders, and zero-runtime CSS tokens for web engineering.
        </p>

        <div class="aui-row aui-row-sm" style="margin: 0.75rem 0 0.5rem;">
          <a href="/components">
            <Button variant="primary" size="md">Explore Components →</Button>
          </a>
          <a href="/agents">
            <Button variant="secondary" size="md">AI Agent Hub</Button>
          </a>
        </div>

        <!-- Hero Quick Install Card -->
        <Card hoverable={false} className="aui-stack aui-stack-xs" style="margin-top: 0.75rem; background-color: var(--aui-bg-secondary);">
          <div slot="header" class="aui-row-between aui-flex-wrap" style="border-bottom: 1px solid var(--aui-border-color); padding-bottom: 0.5rem; margin-bottom: 0.25rem;">
            <div class="aui-row aui-row-xs">
              <button type="button" class="aui-btn aui-btn-secondary aui-btn-sm hero-tab is-active" data-mode="github" onclick="switchHeroInstall('github')">GitHub Package</button>
              <button type="button" class="aui-btn aui-btn-secondary aui-btn-sm hero-tab" data-mode="shadcn" onclick="switchHeroInstall('shadcn')">shadcn CLI</button>
              <button type="button" class="aui-btn aui-btn-secondary aui-btn-sm hero-tab" data-mode="agent" onclick="switchHeroInstall('agent')">Agent Prompt</button>
            </div>
            <Badge variant="outline" size="sm">Not on npm</Badge>
          </div>

          <!-- Mode 1: GitHub -->
          <div id="hero-pane-github" class="aui-stack aui-stack-xs">
            <PackageManager client:load pkg="github:arpitbbhayani/aui" defaultManager="pnpm" />
            <p class="aui-editorial-sub" style="font-size: 0.8rem; margin: 0.2rem 0 0;">Direct package for Next.js & Astro. Works with <code>pnpm</code>, <code>npm</code>, <code>bun</code>.</p>
          </div>

          <!-- Mode 2: shadcn CLI -->
          <div id="hero-pane-shadcn" class="aui-stack aui-stack-xs" style="display: none;">
            <ReactCodeBlock
              language="bash"
              code="npx shadcn@latest add @aui/aui -y"
              client:load
            />
            <p class="aui-editorial-sub" style="font-size: 0.8rem; margin: 0.2rem 0 0;">Copies design tokens & primitives into your project via <code>ui.arpitbhayani.me</code> registry.</p>
          </div>

          <!-- Mode 3: Agent Prompt -->
          <div id="hero-pane-agent" class="aui-stack aui-stack-xs" style="display: none;">
            <ReactCodeBlock
              language="markdown"
              filename="Agent Prompt (llms.txt)"
              code={agentQuickstartPrompt}
              client:load
            />
            <p class="aui-editorial-sub" style="font-size: 0.8rem; margin: 0.2rem 0 0;">Ready-to-paste prompt for Cursor, Claude Code, Windsurf, Codex, or Antigravity.</p>
          </div>
        </Card>
      </div>

      <div>
        <HeroDeck />
      </div>
    </section>

    <!-- Context & Framework Bar -->
    <Card hoverable={false} style="margin-bottom: 2rem; padding: 0.65rem 1rem; background-color: var(--aui-bg-secondary);">
      <div class="aui-row-between aui-flex-wrap" style="gap: 0.75rem;">
        <div class="aui-row aui-row-xs" style="font-size: 0.85rem; color: var(--aui-text-muted);">
          <Badge variant="outline">48+ Primitives</Badge>
          <span>/</span>
          <span>Astro · Next.js · React · Plain CSS</span>
          <span>/</span>
          <code class="aui-code">shadcn CLI</code>
          <span>/</span>
          <a href="/llms.txt" style="color: var(--aui-primary); font-family: var(--aui-font-mono); font-size: 0.82rem; font-weight: 600; text-decoration: none;">llms.txt</a>
        </div>
        <div class="aui-row aui-row-xs">
          <span style="font-size: 0.8rem; font-weight: 600; color: var(--aui-text-muted);">Registry:</span>
          <a href="/components"><Button variant="secondary" size="sm">Catalog</Button></a>
          <a href="/foundations"><Button variant="secondary" size="sm">Foundations</Button></a>
          <a href="/patterns"><Button variant="secondary" size="sm">Patterns</Button></a>
          <a href="/agents"><Button variant="primary" size="sm">AI Hub</Button></a>
        </div>
      </div>
    </Card>

    <!-- Package Notice Callout -->
    <div style="margin-bottom: 2rem;">
      <Alert variant="warning" title="Notice: Array UI is not yet published on the public npm registry.">
        To install, use the direct GitHub dependency (<code>pnpm add github:arpitbbhayani/aui</code> or <code>npm install github:arpitbbhayani/aui</code>) for Next.js and Astro, or copy components directly into your codebase using the official shadcn CLI registry (<code>@aui</code>).
      </Alert>
    </div>

    <!-- Quickstart Guide -->
    <div class="spec-grid" style="margin-bottom: 2.5rem;">
      <Specimen id="quickstart-github" name="Option 1: Direct GitHub Package (Next.js & Astro)" description="Install Array UI directly from GitHub for full 48+ native components and zero-FOUC theme scripts." span={2}>
        <div class="aui-grid aui-grid-cols-2" style="gap: 1.25rem;">
          <div class="aui-stack aui-stack-xs">
            <div class="aui-row aui-row-xs">
              <Badge variant="primary">01</Badge>
              <h4 class="aui-h3" style="font-size: 0.95rem;">Install from GitHub</h4>
            </div>
            <p class="aui-sub" style="font-size: 0.85rem;">Since <code>aui</code> is not on npm, install via your package manager pointing to GitHub:</p>
            <PackageManager client:load pkg="github:arpitbbhayani/aui" defaultManager="pnpm" />
          </div>

          <div class="aui-stack aui-stack-xs">
            <div class="aui-row aui-row-xs">
              <Badge variant="primary">02</Badge>
              <h4 class="aui-h3" style="font-size: 0.95rem;">Import Styles & Components</h4>
            </div>
            <p class="aui-sub" style="font-size: 0.85rem;">Import global stylesheet in root layout, then import components from <code>aui/nextjs</code> or <code>aui/astro/*</code>:</p>
            <ReactCodeBlock
              language="tsx"
              filename="app/layout.tsx"
              code={`import "aui/styles.css";
import { Button, Terminal, PingStatus, Card } from "aui/nextjs";`}
              client:load
            />
          </div>
        </div>
      </Specimen>

      <Specimen id="quickstart-shadcn" name="Option 2: shadcn CLI Registry (Copy-Paste Primitives)" description="Copy pure TypeScript and Tailwind primitives directly into your project without npm dependencies." span={2}>
        <div class="aui-grid aui-grid-cols-2" style="gap: 1.25rem;">
          <div class="aui-stack aui-stack-xs">
            <div class="aui-row aui-row-xs">
              <Badge variant="primary">01</Badge>
              <h4 class="aui-h3" style="font-size: 0.95rem;">Configure shadcn CLI Registry</h4>
            </div>
            <p class="aui-sub" style="font-size: 0.85rem;">Add Array UI registry endpoint to your <code>components.json</code> registries:</p>
            <ReactCodeBlock
              language="json"
              filename="components.json"
              code={`{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "registries": {
    "@aui": "https://ui.arpitbhayani.me/r/{name}.json"
  }
}`}
              client:load
            />
          </div>

          <div class="aui-stack aui-stack-xs">
            <div class="aui-row aui-row-xs">
              <Badge variant="primary">02</Badge>
              <h4 class="aui-h3" style="font-size: 0.95rem;">Install Design Tokens & Components</h4>
            </div>
            <p class="aui-sub" style="font-size: 0.85rem;">Install base theme tokens and copy-paste components into <code>@/components/ui/</code>:</p>
            <ReactCodeBlock
              language="bash"
              code={`npx shadcn@latest add @aui/aui -y
npx shadcn@latest add @aui/button @aui/badge @aui/card @aui/terminal @aui/ping-status -y`}
              client:load
            />
          </div>
        </div>
      </Specimen>
    </div>

    <!-- Browse By Category Directory -->
    <div style="margin-bottom: 2.5rem;">
      <div class="aui-row-between" style="border-bottom: 1px solid var(--aui-border-color); padding-bottom: 0.5rem; margin-bottom: 1.25rem;">
        <div>
          <h2 class="aui-h2" style="border-bottom: none; margin: 0; padding: 0;">Browse Library by Category</h2>
          <p class="aui-sub" style="font-size: 0.88rem;">
            Explore all 48+ native components, design tokens, architectural patterns, and AI endpoints.
          </p>
        </div>
        <a href="/components" style="font-size: 0.85rem; font-weight: 600; color: var(--aui-primary); text-decoration: none;">View All 48+ Components →</a>
      </div>

      <div class="aui-grid aui-grid-cols-3" style="gap: 1rem;">
        {categories.map((cat) => (
          <Card as="a" href={cat.href} hoverable interactive className="aui-stack aui-stack-xs" style="text-decoration: none; color: inherit;">
            <div slot="header" class="aui-row-between">
              <span class="aui-index-tag">{cat.tag}</span>
              <span class="aui-font-mono" style="font-size: 0.78rem; color: var(--aui-text-muted);">Explore →</span>
            </div>
            <h3 class="aui-card-title" style="font-size: 1.05rem;">{cat.title}</h3>
            <p class="aui-card-description" style="font-size: 0.84rem;">{cat.desc}</p>
            <div slot="footer" class="aui-row aui-row-xs aui-flex-wrap" style="margin-top: 0.5rem;">
              {cat.pills.map((pill) => (
                <Badge variant="outline" size="sm">{pill}</Badge>
              ))}
            </div>
          </Card>
        ))}
      </div>
    </div>

    <!-- Featured Registry Components Table -->
    <div class="spec-grid" style="margin-bottom: 2.5rem;">
      <Specimen id="featured-registry" name="Registry Quick Reference" description="Top shadcn-compatible components available for instant CLI installation." span={2}>
        <div class="aui-stack aui-stack-xs">
          <Table dense>
            <thead>
              <tr>
                <th>Component</th>
                <th>Category</th>
                <th>Description</th>
                <th>CLI Command</th>
              </tr>
            </thead>
            <tbody>
              {registryHighlights.map((c) => (
                <tr>
                  <td>
                    <a href={`/components#${c.name}`} style="font-weight: 600; color: var(--aui-text-secondary); text-decoration: none;">
                      {c.title}
                    </a>
                  </td>
                  <td>
                    <Badge variant="light">{c.category}</Badge>
                  </td>
                  <td style="color: var(--aui-text-muted); font-size: 0.85rem;">{c.desc}</td>
                  <td>
                    <button
                      type="button"
                      class="aui-btn aui-btn-secondary aui-btn-sm aui-font-mono"
                      style="font-size: 0.75rem; padding: 0.15rem 0.5rem; height: auto;"
                      onclick={`navigator.clipboard.writeText('npx shadcn@latest add @aui/${c.name} -y'); this.classList.add('is-copied'); const t=this.querySelector('.cmd-text'); if(t) t.textContent='Copied!'; setTimeout(() => { this.classList.remove('is-copied'); if(t) t.textContent='add @aui/${c.name}'; }, 1500);`}
                      title="Click to copy install command"
                    >
                      <code class="cmd-text" style="font-family: inherit; border: none; background: transparent; padding: 0;">add @aui/{c.name}</code>
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </Table>
          <div style="text-align: right; margin-top: 0.5rem;">
            <a href="/agents#component-matrix" style="font-size: 0.84rem; font-weight: 600; color: var(--aui-primary); text-decoration: none;">
              View all 26 registry components in Agent Hub →
            </a>
          </div>
        </div>
      </Specimen>
    </div>

    <!-- Framework Integration -->
    <h2 class="aui-h2"><span class="aui-index-tag">[10]</span> Usage & Frameworks</h2>
    <div class="spec-grid" style="margin-bottom: 3rem;">
      <Specimen id="shadcn" name="shadcn CLI Registry" description="Copy signature aui primitives directly into your project via shadcn CLI.">
        <ReactCodeBlock
          language="bash"
          code={`# Configure registry in components.json, then:
npx shadcn@latest add @aui/button @aui/terminal @aui/ping-status -y

# Installed in @/components/ui/
import { Button } from "@/components/ui/button";
import { Terminal } from "@/components/ui/terminal";`}
          client:load
        />
      </Specimen>

      <Specimen id="nextjs" name="Next.js (App Router / Pages)" description="Direct package dependency with zero-FOUC theme provider.">
        <ReactCodeBlock
          language="tsx"
          filename="app/page.tsx"
          code={`import "aui/styles.css";
import { Button, Terminal, PingStatus } from "aui/nextjs";

export default function Page() {
  return (
    <div>
      <PingStatus status="operational" label="Cluster live" />
      <Button variant="primary">Deploy</Button>
    </div>
  );
}`}
          client:load
        />
      </Specimen>

      <Specimen id="astro" name="Astro Primitives" description="Zero client JavaScript overhead for content sites.">
        <ReactCodeBlock
          language="astro"
          filename="src/pages/index.astro"
          code={`---
import "aui/styles.css";
import Terminal from "aui/astro/Terminal.astro";
import DiffBlock from "aui/astro/DiffBlock.astro";
import PingStatus from "aui/astro/PingStatus.astro";
---
<PingStatus status="operational" label="Healthy" />
<Terminal title="bash" lines={["echo hello"]} />`}
          client:load
        />
      </Specimen>

      <Specimen id="css" name="Plain CSS Tokens" description="Works in any framework or static HTML page.">
        <ReactCodeBlock
          language="html"
          filename="index.html"
          code={`<link rel="stylesheet" href="node_modules/aui/dist/styles.css" />
<body class="aui-body">
  <button class="aui-btn aui-btn-primary aui-btn-md">Deploy</button>
  <span class="aui-badge aui-badge-green">Operational</span>
</body>`}
          client:load
        />
      </Specimen>
    </div>
  </div>

  <script is:inline define:vars={{ agentQuickstartPrompt }}>
    window.agentQuickPromptText = agentQuickstartPrompt;

    window.switchHeroInstall = function(mode) {
      document.querySelectorAll(".hero-tab").forEach(function(btn) {
        if (btn.dataset.mode === mode) {
          btn.classList.add("is-active");
          btn.classList.remove("aui-btn-secondary");
          btn.classList.add("aui-btn-primary");
        } else {
          btn.classList.remove("is-active");
          btn.classList.add("aui-btn-secondary");
          btn.classList.remove("aui-btn-primary");
        }
      });
      var panes = ["github", "shadcn", "agent"];
      panes.forEach(function(p) {
        var el = document.getElementById("hero-pane-" + p);
        if (el) el.style.display = (p === mode) ? "block" : "none";
      });
    };
  </script>
</Layout>
