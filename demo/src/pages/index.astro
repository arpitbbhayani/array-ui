const colorTokens = [
  { name: "primary", v: "--aui-primary" },
  { name: "primary-soft", v: "--aui-primary-soft" },
  { name: "bg-primary", v: "--aui-bg-primary" },
  { name: "bg-secondary", v: "--aui-bg-secondary" },
  { name: "bg-tertiary", v: "--aui-bg-tertiary" },
  { name: "text-secondary", v: "--aui-text-secondary" },
  { name: "text-primary", v: "--aui-text-primary" },
  { name: "text-muted", v: "--aui-text-muted" },
  { name: "border-color", v: "--aui-border-color" },
  { name: "border-strong", v: "--aui-border-strong" },
  { name: "success", v: "--aui-success" },
  { name: "info", v: "--aui-info" },
  { name: "warning", v: "--aui-warning" },
  { name: "danger", v: "--aui-danger" },
];

const tableRows = [
  { service: "api-gateway", region: "eu-west-1", p99: "42 ms", status: "Healthy" },
  { service: "ledger-db", region: "us-east-1", p99: "118 ms", status: "Degraded" },
  { service: "search-index", region: "ap-south-1", p99: "67 ms", status: "Healthy" },
  { service: "payments-queue", region: "eu-west-1", p99: "-", status: "Down" },
];

const takeaways = [
  "Zero-dependency core: pure CSS tokens, React, or native Astro.",
  "Theme-first: light and dark with anti-FOUC script.",
  "Dense by default: 15px base, compact controls, tight rhythm.",
];
---

<Layout>
  <!-- Landing -->
  <div class="aui-container aui-canvas-grid" style="border-radius: var(--aui-radius-lg); margin-top: 0.5rem;">
    <section id="overview" class="landing" style="position: relative;">
      <div class="landing-copy">
        <div class="spec-row" style="margin-bottom: 0.85rem;">
          <PingStatus status="operational" label="Array UI · 45 components · v0.1.0" client:load />
          <Badge variant="light">React</Badge>
          <Badge variant="light">Astro</Badge>
          <Badge variant="light">Plain CSS</Badge>
        </div>
        <h1 class="landing-title">A minimal design system for developers.</h1>
        <p class="landing-sub">
          Fast, dense components for React, Astro, and plain CSS.
          Zero dependencies, instant anti-FOUC dark mode.
        </p>
        <div class="spec-row" style="margin-bottom: 1rem;">
          <Button href="#ping-status" variant="primary" size="lg">Explore dev tools</Button>
          <Button href="#saas-dashboard" variant="secondary" size="lg">Live patterns</Button>
        </div>
        <div class="spec-row" style="margin-bottom: 0.85rem;">
          <div
            class="landing-install-pill"
            title="Click to copy install command"
            onclick="navigator.clipboard.writeText('npm i github:arpitbbhayani/aui'); this.classList.add('is-copied'); const t=this.querySelector('.landing-copy-text'); if(t) t.textContent='Copied!'; setTimeout(() => { this.classList.remove('is-copied'); if(t) t.textContent='Copy'; }, 1600);"
          >
            <span class="landing-install-prompt">$</span>
            <code class="landing-install-code">npm i github:arpitbbhayani/aui</code>
            <span class="landing-install-copy" aria-label="Copy install command">
              <svg class="spec-copy-icon icon-copy" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <svg class="spec-copy-icon icon-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="landing-copy-text">Copy</span>
            </span>
          </div>
        </div>
        <p class="landing-hint">
          Toggle theme <Kbd keys={["⌘", "D"]} /> · Search <Kbd keys={["⌘", "K"]} /> · Jump sections <Kbd>J</Kbd> / <Kbd>K</Kbd>
        </p>
      </div>

      <div class="landing-preview" style="position: relative;">
        <HeroDeck />
      </div>
    </section>
  </div>

  <div class="aui-container">
    <dl class="meta-strip">
      <div><dt>version</dt><dd>0.1.0</dd></div>
      <div><dt>license</dt><dd>MIT</dd></div>
      <div><dt>components</dt><dd>45</dd></div>
      <div><dt>runtime deps</dt><dd>0</dd></div>
      <div><dt>themes</dt><dd>light · dark</dd></div>
    </dl>
  </div>

  <!-- Global Framework Switcher Toolbar -->
  <div class="aui-container" style="margin-top: 0.65rem; margin-bottom: 0.65rem;">
    <div class="docs-framework-bar">
      <div class="docs-framework-label">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        <span>View Code Snippets As:</span>
      </div>
      <div class="docs-framework-pills">
        <button type="button" class="aui-global-fw-btn is-active" data-fw="react" onclick="window.setDocsFramework('react')">
          React
        </button>
        <button type="button" class="aui-global-fw-btn" data-fw="astro" onclick="window.setDocsFramework('astro')">
          Astro
        </button>
        <button type="button" class="aui-global-fw-btn" data-fw="html" onclick="window.setDocsFramework('html')">
          HTML / CSS
        </button>
      </div>
      <div class="docs-framework-hint">
        Click to switch all 45 component snippets simultaneously
      </div>
    </div>
  </div>

  <div class="aui-container">
    <!-- Mobile Jump Selector -->
    <div class="mobile-jump-bar">
      <span class="mobile-jump-label">Jump to section:</span>
      <select class="mobile-jump-select" onchange="if(this.value) window.location.hash = this.value;">
        <option value="">Select component / section...</option>
        {sidebarGroups.map((g) => (
          <optgroup label={g.title}>
            {g.links.map((l) => (
              <option value={l.href}>{l.label}</option>
            ))}
          </optgroup>
        ))}
      </select>
    </div>

    <div class="aui-docs">
      <Sidebar groups={sidebarGroups} />

      <main class="docs-main">
        <!-- Install -->
        <h2 class="docs-h2">Getting started</h2>
        <div class="spec-grid">
          <Specimen id="install" name="Install" description="One package, three ways to consume it.">
            <Terminal title="bash" lines={["npm install github:arpitbbhayani/aui"]} />
            <div class="spec-row">
              <Badge variant="light">aui/styles.css</Badge>
              <Badge variant="light">aui/react</Badge>
              <Badge variant="light">aui/astro/*</Badge>
              <Badge variant="light">aui/tokens</Badge>
              <Badge variant="light">aui/tailwind</Badge>
            </div>
          </Specimen>
          <Specimen id="theme-note" name="Theming" description="Attribute- or class-driven.">
            <Terminal
              title="html"
              lines={[
                { text: '<html data-theme="dark">', kind: "out" },
                { text: '<html class="dark">', kind: "out" },
              ]}
            />
            <p style="margin:0;font-size:0.93rem;color:var(--aui-text-muted);">
              All colors resolve through <code class="aui-code">--aui-*</code> custom properties, so any component re-themes instantly.
            </p>
          </Specimen>
        </div>

        <!-- Patterns -->
        <h2 class="docs-h2">Patterns</h2>
        <div class="spec-grid">
          <Specimen id="blog-article" name="Blog article" description="Long-form reading: 17px prose, 70ch measure, restrained links and code." usage={`<article class="aui-prose">…</article>`} span={2} tone="page">
            <div class="pattern pattern-article">
              <Breadcrumbs items={[{ label: "Blog", href: "#" }, { label: "Databases", href: "#" }, { label: "Write-ahead logging", active: true }]} />
              <article class="aui-prose">
                <h1>Why every database writes before it writes</h1>
                <div class="aui-prose-meta">
                  <Avatar size="sm" fallback="AB" />
                  <span><strong style="color:var(--aui-text-secondary)">Arpit Bhayani</strong></span>
                  <span>·</span><span>Oct 4, 2026</span><span>·</span><span>9 min read</span>
                  <Badge>Databases</Badge><Badge>Internals</Badge>
                </div>
                <p>
                  A write-ahead log is the simplest idea in storage engineering and the one most systems get subtly wrong.
                  Before a change touches a data page, the intent is appended to a sequential file, so a crash can be
                  replayed instead of repaired by hand.
                </p>
                <h2>The contract</h2>
                <p>
                  The rule has two halves: a page may only be flushed once its log record is durable, and a commit is only
                  acknowledged after the log is synced. Everything else, including <code>fsync</code> batching and
                  <a href="#blog-article">group commit</a>, is an optimisation of those two sentences.
                </p>
                <blockquote><p>Durability is not a property of the disk. It is a property of the order in which you wait.</p></blockquote>
                <pre><code>{`wal.append(record)      // sequential, cheap
wal.sync()              // the only expensive call
page.apply(record)      // safe to do lazily`}</code></pre>
                <h3>What to measure</h3>
                <ul>
                  <li>Sync latency at p50, p99 and p99.9, not just the mean.</li>
                  <li>Bytes written per transaction, to spot log amplification.</li>
                  <li>Recovery time after an unclean shutdown.</li>
                </ul>
              </article>
            </div>
          </Specimen>

          <Specimen id="saas-dashboard" name="SaaS dashboard" description="Dense, scannable product UI: toolbar, key metrics, status table, inline alert." usage={`<StatCard /> <table class="aui-table"> <Alert />`} span={2} tone="page">
            <div class="pattern pattern-app">
              <div class="app-toolbar">
                <div>
                  <h2 class="app-title">Services</h2>
                  <p class="app-sub">Production · last 24 hours</p>
                </div>
                <div class="spec-row">
                  <div class="aui-segmented">
                    <button class="aui-segmented-item is-active" type="button">24h</button>
                    <button class="aui-segmented-item" type="button">7d</button>
                    <button class="aui-segmented-item" type="button">30d</button>
                  </div>
                  <Button variant="secondary" size="sm">Export</Button>
                  <Button variant="primary" size="sm">New service</Button>
                </div>
              </div>
              <div class="aui-grid aui-grid-cols-4" style="gap:0.75rem;margin-bottom:1rem;">
                <StatCard value="99.98%" label="Uptime" description="rolling 30 days" />
                <StatCard value="42 ms" label="p99 latency" description="eu-west-1" />
                <StatCard value="1.2M" label="Requests / min" description="peak today" />
                <StatCard value="3" label="Open incidents" description="1 critical" />
              </div>
              <Alert variant="warning" title="Replica lag above threshold">ledger-db in us-east-1 is 240 ms behind the primary. Writes are unaffected.</Alert>
              <div class="aui-table-wrapper">
                <table class="aui-table">
                  <thead><tr><th>Service</th><th>Region</th><th>p99</th><th>Status</th><th></th></tr></thead>
                  <tbody>
                    <tr><td><strong>api-gateway</strong></td><td>eu-west-1</td><td>42 ms</td><td><span class="aui-badge aui-badge-green">Healthy</span></td><td style="text-align:right"><Button variant="ghost" size="sm">Open</Button></td></tr>
                    <tr><td><strong>ledger-db</strong></td><td>us-east-1</td><td>118 ms</td><td><span class="aui-badge aui-badge-amber">Degraded</span></td><td style="text-align:right"><Button variant="ghost" size="sm">Open</Button></td></tr>
                    <tr><td><strong>search-index</strong></td><td>ap-south-1</td><td>67 ms</td><td><span class="aui-badge aui-badge-green">Healthy</span></td><td style="text-align:right"><Button variant="ghost" size="sm">Open</Button></td></tr>
                    <tr><td><strong>payments-queue</strong></td><td>eu-west-1</td><td>-</td><td><span class="aui-badge aui-badge-red">Down</span></td><td style="text-align:right"><Button variant="ghost" size="sm">Open</Button></td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </Specimen>
        </div>

        <!-- Foundations -->
        <h2 class="docs-h2">Foundations</h2>
        <div class="spec-grid">
          <Specimen id="colors" name="Colors" description="Semantic tokens. Toggle the theme to watch them swap." span={2}>
            <div class="swatches">
              {colorTokens.map((t) => (
                <div class="swatch">
                  <span class="swatch-chip" style={`background: var(${t.v});`}></span>
                  <div>
                    <div class="swatch-name">{t.name}</div>
                    <code class="swatch-var">{t.v}</code>
                  </div>
                </div>
              ))}
            </div>
          </Specimen>

          <Specimen id="typography" name="Typography" description="Space Grotesk headings, Assistant body, system mono for data.">
            <div class="spec-col" style="gap:0.4rem;">
              <div style="font-size:2rem;font-family:var(--aui-font-heading);font-weight:700;letter-spacing:-0.03em;line-height:1.15;color:var(--aui-text-secondary);">Heading 1 · 30</div>
              <div style="font-family:var(--aui-font-heading);font-size:1.45rem;font-weight:700;letter-spacing:-0.025em;color:var(--aui-text-secondary);">Heading 2 · 22</div>
              <div style="font-family:var(--aui-font-heading);font-size:1.1rem;font-weight:700;color:var(--aui-text-secondary);">Heading 3 · 16</div>
              <div>Body · 15 - The quick brown fox jumps over the lazy dog.</div>
              <div style="font-size:0.86rem;color:var(--aui-text-muted);">Small · 13 - secondary and helper text</div>
              <div style="font-family:var(--aui-font-mono);font-size:0.9rem;">Mono · 13.5 - SELECT * FROM users;</div>
              <div style="font-family:var(--aui-font-serif);font-style:italic;font-size:1.1rem;">Lora italic - kept for pull quotes</div>
            </div>
          </Specimen>

          <Specimen id="elevation" name="Radius & elevation" description="Small radii, 1px borders, restrained shadows.">
            <div class="spec-label">Radius</div>
            <div class="spec-row" style="margin-bottom:1rem;">
              {[
                ["sm · 4", "--aui-radius-sm"],
                ["md · 8", "--aui-radius-md"],
                ["lg · 12", "--aui-radius-lg"],
              ].map(([label, v]) => (
                <div class="elev" style={`border-radius: var(${v});`}>{label}</div>
              ))}
            </div>
            <div class="spec-label">Shadow</div>
            <div class="spec-row">
              {[
                ["xs", "--aui-shadow-xs"],
                ["md", "--aui-box-shadow-hover"],
                ["lg", "--aui-box-shadow-lg"],
              ].map(([label, v]) => (
                <div class="elev" style={`box-shadow: var(${v});`}>{label}</div>
              ))}
            </div>
          </Specimen>
        </div>

        <!-- Developer Primitives -->
        <h2 class="docs-h2">Developer Primitives</h2>
        <div class="spec-grid">
          <Specimen id="ping-status" name="Ping status" description="Live heartbeat indicator with smooth CSS pulse." usage={`<PingStatus variant="success" label="Operational" />`}>
            <div class="spec-col" style="gap:1rem;">
              <div class="spec-row" style="gap:1.5rem;">
                <PingStatus variant="success" label="Operational" client:load />
                <PingStatus variant="warning" label="Degraded lag" client:load />
                <PingStatus variant="danger" label="Cluster outage" client:load />
                <PingStatus variant="info" label="Deploying" client:load />
              </div>
              <div class="spec-row" style="gap:1.5rem;padding-top:0.4rem;border-top:1px solid var(--aui-border-light);">
                <span style="font-size:0.8rem;color:var(--aui-text-muted);">Sizes:</span>
                <PingStatus size="sm" variant="success" label="sm · 8px" client:load />
                <PingStatus size="md" variant="success" label="md · 10px" client:load />
                <PingStatus size="lg" variant="success" label="lg · 12px" client:load />
              </div>
            </div>
          </Specimen>

          <Specimen id="property-grid" name="Property grid" description="Dense inspector for infrastructure entities with click-to-copy." usage={`<PropertyGrid items={[…]} />`}>
            <PropertyGrid
              client:load
              items={[
                { label: "Cluster ID", value: "cls_01HX98Z", copyValue: "cls_01HX98Z" },
                { label: "Region", value: "eu-west-1 (Ireland)" },
                { label: "Kubernetes", value: "v1.31.2-eks" },
                { label: "VPC CIDR", value: "10.140.0.0/16", copyValue: "10.140.0.0/16" },
                { label: "TLS Version", value: "TLS 1.3 (X25519)" },
              ]}
            />
          </Specimen>

          <Specimen id="diff-block" name="Diff block" description="Unified git patch block with syntax additions and deletions." usage={`<DiffBlock file="migrations/0042.sql" diff={…} />`} span={2}>
            <DiffBlock
              client:load
              file="migrations/0042_cluster_status.sql"
              diff={`@@ -12,7 +12,8 @@
 id: uuid PRIMARY KEY,
 created_at: timestamp NOT NULL DEFAULT now(),
-status: varchar(32) DEFAULT 'pending',
+status: cluster_status NOT NULL DEFAULT 'provisioning',
+replicas: integer NOT NULL DEFAULT 3,
 region: text NOT NULL`}
            />
          </Specimen>

          <Specimen id="file-tree" name="File tree" description="Interactive, collapsible directory and file hierarchy." usage={`<FileTree data={[…]} />`} span={2}>
            <FileTree
              client:load
              data={[
                {
                  name: "src",
                  type: "folder",
                  defaultOpen: true,
                  children: [
                    {
                      name: "components",
                      type: "folder",
                      defaultOpen: true,
                      children: [
                        { name: "Button.tsx", type: "file", badge: "React" },
                        { name: "DiffBlock.tsx", type: "file", badge: "React" },
                        { name: "PingStatus.astro", type: "file", badge: "Astro" },
                      ],
                    },
                    {
                      name: "styles",
                      type: "folder",
                      defaultOpen: true,
                      children: [
                        { name: "tokens.css", type: "file" },
                        { name: "components.css", type: "file" },
                      ],
                    },
                    { name: "index.ts", type: "file" },
                  ],
                },
                { name: "package.json", type: "file", badge: "0.1.0" },
                { name: "tsconfig.json", type: "file" },
                { name: "README.md", type: "file" },
              ]}
            />
          </Specimen>
        </div>

