const sidebarGroups = [
  { title: "Start", links: [{ label: "Overview", href: "#overview" }, { label: "Install", href: "#install" }] },
  {
    title: "Patterns",
    links: [
      { label: "Blog article", href: "#blog-article" },
      { label: "SaaS dashboard", href: "#saas-dashboard" },
    ],
  },
  {
    title: "Foundations",
    links: [
      { label: "Colors", href: "#colors" },
      { label: "Typography", href: "#typography" },
      { label: "Radius & elevation", href: "#elevation" },
    ],
  },
  {
    title: "Actions",
    links: [
      { label: "Button", href: "#buttons" },
      { label: "Segmented control", href: "#segmented" },
      { label: "Kbd", href: "#kbd" },
      { label: "Tooltip", href: "#tooltip" },
      { label: "Theme toggle", href: "#theme-toggle" },
    ],
  },
  {
    title: "Forms",
    links: [
      { label: "Input", href: "#input" },
      { label: "Select & textarea", href: "#select" },
      { label: "Switch & checkbox", href: "#switch" },
    ],
  },
  {
    title: "Feedback",
    links: [
      { label: "Alert", href: "#alert" },
      { label: "Toast", href: "#toast" },
      { label: "Progress", href: "#progress" },
      { label: "Spinner & skeleton", href: "#spinner" },
      { label: "Empty state", href: "#empty" },
      { label: "Modal", href: "#modal" },
    ],
  },
  {
    title: "Data display",
    links: [
      { label: "Badge", href: "#badge" },
      { label: "Avatar", href: "#avatar" },
      { label: "Stat card", href: "#stat" },
      { label: "Table", href: "#table" },
      { label: "Timeline", href: "#timeline" },
      { label: "Code block", href: "#codeblock" },
      { label: "Terminal", href: "#terminal" },
    ],
  },
  {
    title: "Navigation",
    links: [
      { label: "Breadcrumbs", href: "#breadcrumbs" },
      { label: "Tabs", href: "#tabs" },
      { label: "Pagination", href: "#pagination" },
      { label: "Accordion", href: "#accordion" },
      { label: "Sidebar & navbar", href: "#sidebar" },
    ],
  },
  {
    title: "Content",
    links: [
      { label: "Hero", href: "#hero" },
      { label: "Callouts", href: "#callouts" },
      { label: "Notice box", href: "#notice" },
      { label: "Card", href: "#card" },
      { label: "Course card", href: "#course" },
      { label: "Pricing card", href: "#pricing" },
      { label: "Newsletter", href: "#newsletter" },
      { label: "Social pill", href: "#social" },
      { label: "Divider", href: "#divider" },
    ],
  },
  {
    title: "Usage",
    links: [
      { label: "Next.js", href: "#nextjs" },
      { label: "Astro", href: "#astro" },
      { label: "Plain CSS", href: "#css" },
    ],
  },
];

const colorTokens = [
  { name: "primary", v: "--aui-primary" },
  { name: "primary-soft", v: "--aui-primary-soft" },
  { name: "bg-primary", v: "--aui-bg-primary" },
  { name: "bg-secondary", v: "--aui-bg-secondary" },
  { name: "bg-tertiary", v: "--aui-bg-tertiary" },
  { name: "text-secondary", v: "--aui-text-secondary" },
  { name: "text-primary", v: "--aui-text-primary" },
  { name: "text-muted", v: "--aui-text-muted" },
  { name: "border-color", v: "--aui-border-color" },
  { name: "border-strong", v: "--aui-border-strong" },
  { name: "success", v: "--aui-success" },
  { name: "info", v: "--aui-info" },
  { name: "warning", v: "--aui-warning" },
  { name: "danger", v: "--aui-danger" },
];

const tableRows = [
  { service: "api-gateway", region: "eu-west-1", p99: "42 ms", status: "Healthy" },
  { service: "ledger-db", region: "us-east-1", p99: "118 ms", status: "Degraded" },
  { service: "search-index", region: "ap-south-1", p99: "67 ms", status: "Healthy" },
  { service: "payments-queue", region: "eu-west-1", p99: "—", status: "Down" },
];

const takeaways = [
  "Zero-dependency core: pure CSS tokens, React, or native Astro.",
  "Theme-first: light and dark with anti-FOUC script.",
  "Dense by default: 15px base, compact controls, tight rhythm.",
];
---

<Layout>
  <!-- Landing -->
  <div class="aui-container">
    <section id="overview" class="landing">
      <div class="landing-copy">
        <div class="spec-row" style="margin-bottom: 1rem;">
          <Badge variant="light">v1.0.0</Badge>
          <Badge variant="light">React</Badge>
          <Badge variant="light">Astro</Badge>
          <Badge variant="light">Plain CSS</Badge>
        </div>
        <h1 class="landing-title">Interface foundations for products and publications.</h1>
        <p class="landing-sub">
          Light and dark components for SaaS apps and long-form blogs. Compact where you need density,
          comfortable where you need to read.
        </p>
        <div class="spec-row" style="margin-bottom: 1.25rem;">
          <Button href="#buttons" variant="primary" size="lg">Browse components</Button>
          <Button href="#blog-article" variant="secondary" size="lg">See patterns</Button>
        </div>
        <p class="landing-hint">
          Toggle theme with <Kbd keys={["⌘", "D"]} /> or the button in the header.
        </p>
      </div>

      <div class="landing-preview">
        <Terminal
          title="~/my-app"
          lines={[
            "npm install github:arpitbbhayani/aui",
            { text: "added 1 package in 2s", kind: "out" },
            "echo \"import 'aui/styles.css'\" >> src/main.ts",
            { text: "✓ ready — 43 components, light + dark, 0 runtime deps", kind: "ok" },
          ]}
        />
      </div>
    </section>
  </div>

  <div class="aui-container">
    <dl class="meta-strip">
      <div><dt>version</dt><dd>1.0.0</dd></div>
      <div><dt>license</dt><dd>MIT</dd></div>
      <div><dt>components</dt><dd>43</dd></div>
      <div><dt>runtime deps</dt><dd>0</dd></div>
      <div><dt>themes</dt><dd>light · dark</dd></div>
    </dl>
  </div>

  <div class="aui-container">
    <div class="aui-docs">
      <Sidebar groups={sidebarGroups} />

      <main class="docs-main">
        <!-- Install -->
        <h2 class="docs-h2">Getting started</h2>
        <div class="spec-grid">
          <Specimen id="install" name="Install" description="One package, three ways to consume it.">
            <Terminal title="bash" lines={["npm install github:arpitbbhayani/aui"]} />
            <div class="spec-row">
              <Badge variant="light">aui/styles.css</Badge>
              <Badge variant="light">aui/react</Badge>
              <Badge variant="light">aui/astro/*</Badge>
              <Badge variant="light">aui/tokens</Badge>
              <Badge variant="light">aui/tailwind</Badge>
            </div>
          </Specimen>
          <Specimen id="theme-note" name="Theming" description="Attribute- or class-driven.">
            <Terminal
              title="html"
              lines={[
                { text: '<html data-theme="dark">', kind: "out" },
                { text: '<html class="dark">', kind: "out" },
              ]}
            />
            <p style="margin:0;font-size:0.93rem;color:var(--aui-text-muted);">
              All colors resolve through <code class="aui-code">--aui-*</code> custom properties, so any component re-themes instantly.
            </p>
          </Specimen>
        </div>

        <!-- Patterns -->
        <h2 class="docs-h2">Patterns</h2>
        <div class="spec-grid">
          <Specimen id="blog-article" name="Blog article" description="Long-form reading: 17px prose, 70ch measure, restrained links and code." usage={`<article class="aui-prose">…</article>`} span={2} tone="page">
            <div class="pattern pattern-article">
              <Breadcrumbs items={[{ label: "Blog", href: "#" }, { label: "Databases", href: "#" }, { label: "Write-ahead logging", active: true }]} />
              <article class="aui-prose">
                <h1>Why every database writes before it writes</h1>
                <div class="aui-prose-meta">
                  <Avatar size="sm" fallback="AB" />
                  <span><strong style="color:var(--aui-text-secondary)">Arpit Bhayani</strong></span>
                  <span>·</span><span>Oct 4, 2026</span><span>·</span><span>9 min read</span>
                  <Badge>Databases</Badge><Badge>Internals</Badge>
                </div>
                <p>
                  A write-ahead log is the simplest idea in storage engineering and the one most systems get subtly wrong.
                  Before a change touches a data page, the intent is appended to a sequential file, so a crash can be
                  replayed instead of repaired by hand.
                </p>
                <h2>The contract</h2>
                <p>
                  The rule has two halves: a page may only be flushed once its log record is durable, and a commit is only
                  acknowledged after the log is synced. Everything else, including <code>fsync</code> batching and
                  <a href="#blog-article">group commit</a>, is an optimisation of those two sentences.
                </p>
                <blockquote><p>Durability is not a property of the disk. It is a property of the order in which you wait.</p></blockquote>
                <pre><code>{`wal.append(record)      // sequential, cheap
wal.sync()              // the only expensive call
page.apply(record)      // safe to do lazily`}</code></pre>
                <h3>What to measure</h3>
                <ul>
                  <li>Sync latency at p50, p99 and p99.9, not just the mean.</li>
                  <li>Bytes written per transaction, to spot log amplification.</li>
                  <li>Recovery time after an unclean shutdown.</li>
                </ul>
              </article>
            </div>
          </Specimen>

          <Specimen id="saas-dashboard" name="SaaS dashboard" description="Dense, scannable product UI: toolbar, key metrics, status table, inline alert." usage={`<StatCard /> <table class="aui-table"> <Alert />`} span={2} tone="page">
            <div class="pattern pattern-app">
              <div class="app-toolbar">
                <div>
                  <h2 class="app-title">Services</h2>
                  <p class="app-sub">Production · last 24 hours</p>
                </div>
                <div class="spec-row">
                  <div class="aui-segmented">
                    <button class="aui-segmented-item is-active" type="button">24h</button>
                    <button class="aui-segmented-item" type="button">7d</button>
                    <button class="aui-segmented-item" type="button">30d</button>
                  </div>
                  <Button variant="secondary" size="sm">Export</Button>
                  <Button variant="primary" size="sm">New service</Button>
                </div>
              </div>
              <div class="aui-grid aui-grid-cols-4" style="gap:0.75rem;margin-bottom:1rem;">
                <StatCard value="99.98%" label="Uptime" description="rolling 30 days" />
                <StatCard value="42 ms" label="p99 latency" description="eu-west-1" />
                <StatCard value="1.2M" label="Requests / min" description="peak today" />
                <StatCard value="3" label="Open incidents" description="1 critical" />
              </div>
              <Alert variant="warning" title="Replica lag above threshold">ledger-db in us-east-1 is 240 ms behind the primary. Writes are unaffected.</Alert>
              <div class="aui-table-wrapper">
                <table class="aui-table">
                  <thead><tr><th>Service</th><th>Region</th><th>p99</th><th>Status</th><th></th></tr></thead>
                  <tbody>
                    <tr><td><strong>api-gateway</strong></td><td>eu-west-1</td><td>42 ms</td><td><span class="aui-badge aui-badge-green">Healthy</span></td><td style="text-align:right"><Button variant="ghost" size="sm">Open</Button></td></tr>
                    <tr><td><strong>ledger-db</strong></td><td>us-east-1</td><td>118 ms</td><td><span class="aui-badge aui-badge-amber">Degraded</span></td><td style="text-align:right"><Button variant="ghost" size="sm">Open</Button></td></tr>
                    <tr><td><strong>search-index</strong></td><td>ap-south-1</td><td>67 ms</td><td><span class="aui-badge aui-badge-green">Healthy</span></td><td style="text-align:right"><Button variant="ghost" size="sm">Open</Button></td></tr>
                    <tr><td><strong>payments-queue</strong></td><td>eu-west-1</td><td>—</td><td><span class="aui-badge aui-badge-red">Down</span></td><td style="text-align:right"><Button variant="ghost" size="sm">Open</Button></td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </Specimen>
        </div>

        <!-- Foundations -->
        <h2 class="docs-h2">Foundations</h2>
        <div class="spec-grid">
          <Specimen id="colors" name="Colors" description="Semantic tokens. Toggle the theme to watch them swap." span={2}>
            <div class="swatches">
              {colorTokens.map((t) => (
                <div class="swatch">
                  <span class="swatch-chip" style={`background: var(${t.v});`}></span>
                  <div>
                    <div class="swatch-name">{t.name}</div>
                    <code class="swatch-var">{t.v}</code>
                  </div>
                </div>
              ))}
            </div>
          </Specimen>

          <Specimen id="typography" name="Typography" description="Space Grotesk headings, Assistant body, system mono for data.">
            <div class="spec-col" style="gap:0.4rem;">
              <div style="font-size:2rem;font-family:var(--aui-font-heading);font-weight:700;letter-spacing:-0.03em;line-height:1.15;color:var(--aui-text-secondary);">Heading 1 · 30</div>
              <div style="font-family:var(--aui-font-heading);font-size:1.45rem;font-weight:700;letter-spacing:-0.025em;color:var(--aui-text-secondary);">Heading 2 · 22</div>
              <div style="font-family:var(--aui-font-heading);font-size:1.1rem;font-weight:700;color:var(--aui-text-secondary);">Heading 3 · 16</div>
              <div>Body · 15 — The quick brown fox jumps over the lazy dog.</div>
              <div style="font-size:0.86rem;color:var(--aui-text-muted);">Small · 13 — secondary and helper text</div>
              <div style="font-family:var(--aui-font-mono);font-size:0.9rem;">Mono · 13.5 — SELECT * FROM users;</div>
              <div style="font-family:var(--aui-font-serif);font-style:italic;font-size:1.1rem;">Lora italic — kept for pull quotes</div>
            </div>
          </Specimen>

          <Specimen id="elevation" name="Radius & elevation" description="Small radii, 1px borders, restrained shadows.">
            <div class="spec-label">Radius</div>
            <div class="spec-row" style="margin-bottom:1rem;">
              {[
                ["sm · 4", "--aui-radius-sm"],
                ["md · 8", "--aui-radius-md"],
                ["lg · 12", "--aui-radius-lg"],
              ].map(([label, v]) => (
                <div class="elev" style={`border-radius: var(${v});`}>{label}</div>
              ))}
            </div>
            <div class="spec-label">Shadow</div>
            <div class="spec-row">
              {[
                ["xs", "--aui-shadow-xs"],
                ["md", "--aui-box-shadow-hover"],
                ["lg", "--aui-box-shadow-lg"],
              ].map(([label, v]) => (
                <div class="elev" style={`box-shadow: var(${v});`}>{label}</div>
              ))}
            </div>
          </Specimen>
        </div>

        <!-- Actions -->
        <h2 class="docs-h2">Actions</h2>
        <div class="spec-grid">
          <Specimen id="buttons" name="Button" description="Five variants, three sizes." usage={`<Button variant="primary" size="md">Deploy</Button>`} span={2}>
            <div class="spec-label">Variants</div>
            <div class="aui-btn-group" style="margin-bottom:1rem;">
              <Button variant="primary">Primary</Button>
              <Button variant="secondary">Secondary</Button>
              <Button variant="light">Light</Button>
              <Button variant="outline">Outline</Button>
              <Button variant="ghost">Ghost</Button>
              <Button variant="primary" disabled>Disabled</Button>
            </div>
            <div class="spec-label">Sizes</div>
            <div class="aui-btn-group">
              <Button size="sm" variant="primary">Small</Button>
              <Button size="md" variant="primary">Medium</Button>
              <Button size="lg" variant="primary">Large</Button>
              <Button size="sm" variant="secondary"><Spinner size="sm" /> Loading</Button>
            </div>
          </Specimen>

          <Specimen id="segmented" name="Segmented control" description="Mutually exclusive view switcher." usage={`<SegmentedControl options={[…]} onChange={setView} />`}>
            <SegmentedDemo client:load />
          </Specimen>

          <Specimen id="kbd" name="Kbd" description="Keyboard shortcuts." usage={`<Kbd keys={["⌘", "K"]} />`}>
            <div class="spec-col">
              <div>Open command menu <Kbd keys={["⌘", "K"]} /></div>
              <div>Save <Kbd keys={["Ctrl", "S"]} /> · Close <Kbd>Esc</Kbd></div>
              <div>Navigate <Kbd keys={["↑", "↓"]} /> then <Kbd>Enter</Kbd></div>
            </div>
          </Specimen>

          <Specimen id="tooltip" name="Tooltip" description="CSS-only, shows on hover and focus." usage={`<Tooltip content="Copy to clipboard">…</Tooltip>`}>
            <div class="spec-row" style="padding-top:1.5rem;">
              <Tooltip content="Copy to clipboard"><Button variant="secondary" size="sm">Hover me</Button></Tooltip>
              <Tooltip content="Shown below" placement="bottom"><Button variant="secondary" size="sm">Bottom</Button></Tooltip>
              <Tooltip content="Keyboard focus works too"><Button variant="ghost" size="sm">Focus me</Button></Tooltip>
            </div>
          </Specimen>

          <Specimen id="theme-toggle" name="Theme toggle" description="Persists to localStorage." usage={`<ThemeToggle />`}>
            <div class="spec-row"><ThemeToggle /><span style="color:var(--aui-text-muted);font-size:0.93rem;">Click to switch light / dark</span></div>
          </Specimen>
        </div>

        <!-- Forms -->
        <h2 class="docs-h2">Forms</h2>
        <div class="spec-grid">
          <Specimen id="input" name="Input" description="Label, shortcut hint, helper and error text." usage={`<Input label="Search" shortcut="⌘K" />`}>
            <FormDemo client:load />
          </Specimen>

          <Specimen id="select" name="Select & textarea" usage={`<Select label="Region" options={[…]} />`}>
            <Select
              label="Region"
              options={[
                { label: "eu-west-1 (Ireland)", value: "eu" },
                { label: "us-east-1 (Virginia)", value: "us" },
                { label: "ap-south-1 (Mumbai)", value: "ap" },
              ]}
            />
            <Textarea label="Notes" placeholder="Rollout notes…" rows={3} />
          </Specimen>

          <Specimen id="switch" name="Switch & checkbox" usage={`<Switch label="Auto-deploy" defaultChecked />`} span={2}>
            <div class="spec-row" style="gap:1.5rem;">
              <Switch label="Auto-deploy" defaultChecked />
              <Switch label="Maintenance mode" />
              <Checkbox label="Run tests" defaultChecked />
              <Checkbox label="Lint" defaultChecked />
              <Checkbox label="Type-check" />
            </div>
          </Specimen>
        </div>

        <!-- Feedback -->
        <h2 class="docs-h2">Feedback</h2>
        <div class="spec-grid">
          <Specimen id="alert" name="Alert" description="Inline, status-tinted." usage={`<Alert variant="warning" title="…">…</Alert>`} span={2}>
            <div class="spec-grid" style="margin:0;gap:0.5rem 1rem;">
              <Alert variant="info" title="Heads up">Schema migration scheduled for 02:00 UTC.</Alert>
              <Alert variant="success" title="Deployed">build #4821 is live in all regions.</Alert>
              <Alert variant="warning" title="Degraded">Replica lag above 200 ms in eu-west-1.</Alert>
              <Alert variant="error" title="Failed">Health check timed out after 30 s.</Alert>
            </div>
          </Specimen>

          <Specimen id="toast" name="Toast" description="Transient, stackable messages." usage={`<Toast variant="success" title="Saved" onClose={…} />`}>
            <div class="spec-col">
              <Toast variant="success" title="Deployed to production" description="build #4821 · 38s" />
              <Toast variant="error" title="Build failed" description="exit code 137 (OOM)" />
              <ToastDemo client:load />
            </div>
          </Specimen>

          <Specimen id="progress" name="Progress" usage={`<Progress value={72} label="Upload" showValue />`}>
            <div class="spec-col">
              <Progress value={72} label="Uploading assets" showValue />
              <Progress value={100} label="Tests passed" showValue variant="success" size="sm" />
              <Progress value={38} label="Migration" showValue variant="info" />
              <Progress value={86} label="Disk usage" showValue variant="warning" size="lg" />
            </div>
          </Specimen>

          <Specimen id="spinner" name="Spinner & skeleton" description="Loading states." usage={`<Spinner size="lg" />   <Skeleton height={12} />`}>
            <div class="spec-row" style="margin-bottom:1rem;gap:1rem;">
              <Spinner size="sm" /><Spinner /><Spinner size="lg" />
              <span style="color:var(--aui-text-muted);font-size:0.93rem;">Fetching metrics…</span>
            </div>
            <div style="display:flex;gap:0.75rem;align-items:center;">
              <Skeleton width={40} height={40} circle />
              <div style="flex:1;display:flex;flex-direction:column;gap:0.45rem;">
                <Skeleton width="60%" height={12} />
                <Skeleton height={10} />
                <Skeleton width="80%" height={10} />
              </div>
            </div>
          </Specimen>

          <Specimen id="modal" name="Modal" description="Esc and backdrop close. Locks scroll." usage={`<Modal isOpen={open} onClose={…} title="…" footer={…} />`}>
            <ModalDemo client:load />
          </Specimen>

          <Specimen id="empty" name="Empty state" usage={`<EmptyState title="No deployments" description="…" />`} span={2}>
            <EmptyState title="No deployments yet" description="Connect a repository to ship your first build.">
              <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              <Button size="sm" variant="primary">Connect repo</Button>
            </EmptyState>
          </Specimen>
        </div>

        <!-- Data display -->
        <h2 class="docs-h2">Data display</h2>
