const colorTokens = [
  { name: "primary", v: "--aui-primary" },
  { name: "primary-soft", v: "--aui-primary-soft" },
  { name: "bg-primary", v: "--aui-bg-primary" },
  { name: "bg-secondary", v: "--aui-bg-secondary" },
  { name: "bg-tertiary", v: "--aui-bg-tertiary" },
  { name: "text-secondary", v: "--aui-text-secondary" },
  { name: "text-primary", v: "--aui-text-primary" },
  { name: "text-muted", v: "--aui-text-muted" },
  { name: "border-color", v: "--aui-border-color" },
  { name: "border-strong", v: "--aui-border-strong" },
  { name: "success", v: "--aui-success" },
  { name: "info", v: "--aui-info" },
  { name: "warning", v: "--aui-warning" },
