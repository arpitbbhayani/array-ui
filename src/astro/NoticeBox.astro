---
interface FormatItem {
  label: string;
  desc: string;
}

interface Props {
  title?: string;
  driveUrl?: string;
  driveLabel?: string;
  formats?: FormatItem[];
  className?: string;
}

const defaultFormats: FormatItem[] = [
  { label: "HTML files", desc: "View via npx deckrun <path>" },
  { label: "Markdown files", desc: "View presentation decks using npx deckrun <path.md>" },
  { label: "Google Slides", desc: "Open directly in Google Slides" },
  { label: "GoodNotes files", desc: "Load directly into the GoodNotes app" },
  { label: "PDF files", desc: "Open in any standard PDF reader" },
];

const {
  title = "Access the presentation decks and notes",
  driveUrl,
  driveLabel = "this Google Drive folder",
  formats = defaultFormats,
  className = "",
} = Astro.props;
---

<div class={`aui-notice-box ${className}`}>
  <div class="aui-notice-title">
    {title}{" "}
    {
      driveUrl && (
        <a
          href={driveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="aui-notice-link"
        >
          {driveLabel} ↗
        </a>
      )
    }
  </div>

  {
    formats && formats.length > 0 && (
      <ul class="aui-notice-list">
        {formats.map((f) => (
          <li>
            <strong>{f.label}:</strong> {f.desc}
          </li>
        ))}
      </ul>
    )
  }

  <slot />

  {
    Astro.slots.has("footer") && (
      <div class="aui-notice-footer">
        <slot name="footer" />
      </div>
    )
  }
</div>
