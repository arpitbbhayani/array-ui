---
export interface AccordionItem {
  id: string;
  title: string;
  content: string;
}

interface Props {
  items: AccordionItem[];
  className?: string;
}

const { items = [], className = "" } = Astro.props;
---

<div class={`aui-accordion ${className}`} data-aui-accordion>
  {
    items.map((item) => (
      <div class="aui-accordion-item" data-item-id={item.id}>
        <button
          type="button"
          class="aui-accordion-trigger"
          aria-expanded="false"
        >
          <span>{item.title}</span>
          <span class="aui-accordion-icon">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </span>
        </button>
        <div class="aui-accordion-content">
          <div class="aui-accordion-inner">
            <p>{item.content}</p>
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  function setupAccordions() {
    document.querySelectorAll("[data-aui-accordion]").forEach((acc) => {
      acc.querySelectorAll(".aui-accordion-trigger").forEach((btn) => {
        btn.addEventListener("click", () => {
          const item = btn.closest(".aui-accordion-item");
          if (!item) return;
          const isOpen = item.classList.toggle("is-open");
          btn.setAttribute("aria-expanded", String(isOpen));
        });
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupAccordions);
  } else {
    setupAccordions();
  }
  document.addEventListener("astro:page-load", setupAccordions);
</script>
