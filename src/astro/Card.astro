---
interface Props {
  as?: string;
  title?: string;
  description?: string;
  hoverable?: boolean;
  interactive?: boolean;
  className?: string;
  [key: string]: any;
}

const {
  as: Tag = "div",
  title,
  description,
  hoverable = false,
  interactive = false,
  className = "",
  ...rest
} = Astro.props;

const classNames = [
  "aui-card",
  hoverable && "aui-card-hover",
  interactive && "aui-card-interactive",
  className,
].filter(Boolean).join(" ");

const hasHeader = Boolean(title || description || Astro.slots.has("header"));
const hasFooter = Astro.slots.has("footer");
---

<Tag class={classNames} {...rest}>
  {hasHeader && (
    <div class="aui-card-header">
      {Astro.slots.has("header") ? (
        <slot name="header" />
      ) : (
        <>
          {title && <h3 class="aui-card-title">{title}</h3>}
          {description && <p class="aui-card-description">{description}</p>}
        </>
      )}
    </div>
  )}
  {Astro.slots.has("content") ? (
    <div class="aui-card-content">
      <slot name="content" />
    </div>
  ) : (
    <slot />
  )}
  {hasFooter && (
    <div class="aui-card-footer">
      <slot name="footer" />
    </div>
  )}
</Tag>
