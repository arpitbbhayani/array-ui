---
interface PropertyItem {
  label: string;
  value: string;
  copyable?: boolean;
}

interface Props {
  items: PropertyItem[];
  class?: string;
}

const { items, class: className = "", ...props } = Astro.props;
---

<div class:list={["aui-property-grid", className]} {...props}>
  {items.map((item) => (
    <div class="aui-property-row">
      <span class="aui-property-key">{item.label}</span>
      <div class="aui-property-val">
        <span>{item.value}</span>
        {item.copyable !== false && (
          <button
            type="button"
            class="aui-property-copy-btn"
            title="Copy value"
            data-copy={item.value}
            onclick="navigator.clipboard.writeText(this.dataset.copy); this.style.color='var(--aui-success)'; setTimeout(() => this.style.color='', 1500);"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
          </button>
        )}
      </div>
    </div>
  ))}
</div>
