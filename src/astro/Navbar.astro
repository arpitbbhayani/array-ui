---
import ThemeToggle from "./ThemeToggle.astro";

export interface NavLink {
  label: string;
  href: string;
  active?: boolean;
  external?: boolean;
  badge?: string;
}

interface Props {
  brandName?: string;
  brandHref?: string;
  links?: NavLink[];
  showThemeToggle?: boolean;
  className?: string;
}

const {
  brandName = "Arpit Bhayani",
  brandHref = "/",
  links = [],
  showThemeToggle = true,
  className = "",
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<header class={`aui-navbar aui-nav-wrapper ${className}`}>
  <div class="aui-container">
    <nav class="aui-nav" aria-label="Main Navigation">
      <div class="aui-nav-brand">
        <slot name="brand">
          <a href={brandHref} class="aui-nav-title">
            {brandName}
          </a>
        </slot>
      </div>

      <ul class="aui-nav-menu" id="aui-nav-menu">
        {
          links.map((link) => {
            const isActive =
              link.active ??
              (currentPath === link.href ||
                (link.href !== "/" && currentPath.startsWith(link.href)));

            return (
              <li>
                <a
                  href={link.href}
                  class={`aui-nav-item ${isActive ? "is-active" : ""}`}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                >
                  <span>{link.label}</span>
                  {link.badge && (
                    <span
                      class="aui-badge aui-badge-primary"
                      style="margin-left: 0.4rem; font-size: 0.68rem;"
                    >
                      {link.badge}
                    </span>
                  )}
                </a>
              </li>
            );
          })
        }
        <slot name="menu-items" />
      </ul>

      <div class="aui-nav-actions">
        <slot name="actions" />
        {showThemeToggle && <ThemeToggle />}
        <button
          type="button"
          class="aui-nav-burger"
          id="aui-nav-burger"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  function setupNavBurger() {
    document.querySelectorAll(".aui-navbar").forEach((navbar) => {
      const burger = navbar.querySelector(".aui-nav-burger");
      const menu = navbar.querySelector(".aui-nav-menu");
      if (!burger || !menu) return;

      if (burger.hasAttribute("data-aui-initialized")) return;
      burger.setAttribute("data-aui-initialized", "true");

      burger.addEventListener("click", () => {
        const isOpen = menu.classList.toggle("is-open");
        burger.setAttribute("aria-expanded", String(isOpen));
      });

      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menu.classList.remove("is-open");
          burger.setAttribute("aria-expanded", "false");
        });
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupNavBurger);
  } else {
    setupNavBurger();
  }

  document.addEventListener("astro:page-load", setupNavBurger);
</script>
