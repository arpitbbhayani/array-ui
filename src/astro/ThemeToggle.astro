---
interface Props {
  className?: string;
  size?: number;
}

const { className = "", size = 20 } = Astro.props;
---

<button
  type="button"
  class={`aui-theme-toggle ${className}`}
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <svg
    class="aui-sun-icon"
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  <svg
    class="aui-moon-icon"
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    style="display: none;"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  function setupThemeToggle() {
    const toggles = document.querySelectorAll(".aui-theme-toggle");
    if (!toggles.length) return;

    function syncAllIcons(theme: string) {
      document.querySelectorAll(".aui-theme-toggle").forEach((toggle) => {
        const sun = toggle.querySelector(".aui-sun-icon") as HTMLElement | null;
        const moon = toggle.querySelector(".aui-moon-icon") as HTMLElement | null;
        if (!sun || !moon) return;
        if (theme === "dark") {
          sun.style.display = "none";
          moon.style.display = "block";
        } else {
          sun.style.display = "block";
          moon.style.display = "none";
        }
      });
    }

    const currentTheme =
      document.documentElement.getAttribute("data-theme") ||
      localStorage.getItem("theme") ||
      "light";
    syncAllIcons(currentTheme);

    toggles.forEach((toggle) => {
      if (toggle.hasAttribute("data-aui-initialized")) return;
      toggle.setAttribute("data-aui-initialized", "true");

      toggle.addEventListener("click", () => {
        const activeTheme = document.documentElement.getAttribute("data-theme");
        const nextTheme = activeTheme === "dark" ? "light" : "dark";

        document.documentElement.setAttribute("data-theme", nextTheme);
        if (nextTheme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }

        localStorage.setItem("theme", nextTheme);
        syncAllIcons(nextTheme);
        window.dispatchEvent(new CustomEvent("aui:theme-change", { detail: { theme: nextTheme } }));
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupThemeToggle);
  } else {
    setupThemeToggle();
  }

  document.addEventListener("astro:page-load", setupThemeToggle);
</script>
