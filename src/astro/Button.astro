---
interface Props {
  variant?:
    | "primary"
    | "secondary"
    | "light"
    | "outline"
    | "ghost"
    | "danger"
    | "solid"
    | "red"
    | "green"
    | "blue"
    | "amber"
    | "yellow"
    | "violet"
    | "pink"
    | "cyan"
    | "success"
    | "warning"
    | "info";
  color?:
    | "red"
    | "green"
    | "blue"
    | "amber"
    | "yellow"
    | "violet"
    | "pink"
    | "cyan"
    | "success"
    | "warning"
    | "info"
    | "danger";
  size?: "sm" | "md" | "lg" | "icon";
  href?: string;
  target?: string;
  rel?: string;
  fullWidth?: boolean;
  className?: string;
  loading?: boolean;
  disabled?: boolean;
  [key: string]: any;
}

const {
  variant = "primary",
  color,
  size = "md",
  href,
  target,
  rel,
  fullWidth = false,
  className = "",
  loading = false,
  disabled = false,
  ...rest
} = Astro.props;

const isColorVariant = [
  "red",
  "green",
  "blue",
  "amber",
  "yellow",
  "violet",
  "pink",
  "cyan",
  "success",
  "warning",
  "info",
].includes(variant);

const effectiveColor = color || (isColorVariant ? variant : undefined);
const effectiveVariant = isColorVariant ? "solid" : variant;
const isDisabled = Boolean(disabled || loading);

const classNames = [
  "aui-btn",
  effectiveVariant ? `aui-btn-${effectiveVariant}` : "",
  effectiveColor ? `aui-btn-color-${effectiveColor}` : "",
  size === "icon" ? "aui-btn-icon-only" : `aui-btn-${size}`,
  fullWidth ? "aui-btn-full" : "",
  isDisabled ? "is-disabled" : "",
  loading ? "is-loading" : "",
  className,
].filter(Boolean).join(" ");
---

{
  href ? (
    <a
      href={href}
      target={target}
      rel={target === "_blank" && !rel ? "noopener noreferrer" : rel}
      class={classNames}
      aria-disabled={isDisabled}
      aria-busy={loading ? "true" : undefined}
      {...rest}
    >
      {loading ? (
        <span class="aui-spinner aui-spinner-sm aui-btn-spinner" role="status" aria-label="Loading" />
      ) : (
        <slot name="left-icon" />
        <slot name="icon" />
      )}
      <slot />
      {!loading && <slot name="right-icon" />}
    </a>
  ) : (
    <button
      type="button"
      class={classNames}
      disabled={isDisabled}
      aria-busy={loading ? "true" : undefined}
      {...rest}
    >
      {loading ? (
        <span class="aui-spinner aui-spinner-sm aui-btn-spinner" role="status" aria-label="Loading" />
      ) : (
        <slot name="left-icon" />
        <slot name="icon" />
      )}
      <slot />
      {!loading && <slot name="right-icon" />}
    </button>
  )
}

