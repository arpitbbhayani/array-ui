---
interface Props {
  variant?:
    | "primary"
    | "secondary"
    | "light"
    | "outline"
    | "ghost"
    | "danger"
    | "solid"
    | "red"
    | "green"
    | "blue"
    | "amber"
    | "violet"
    | "pink"
    | "cyan"
    | "success"
    | "warning"
    | "info";
  color?:
    | "red"
    | "green"
    | "blue"
    | "amber"
    | "violet"
    | "pink"
    | "cyan"
    | "success"
    | "warning"
    | "info"
    | "danger";
  size?: "sm" | "md" | "lg";
  href?: string;
  target?: string;
  rel?: string;
  fullWidth?: boolean;
  className?: string;
  [key: string]: any;
}

const {
  variant = "primary",
  color,
  size = "md",
  href,
  target,
  rel,
  fullWidth = false,
  className = "",
  ...rest
} = Astro.props;

const isColorVariant = [
  "red",
  "green",
  "blue",
  "amber",
  "violet",
  "pink",
  "cyan",
  "success",
  "warning",
  "info",
].includes(variant);

const effectiveColor = color || (isColorVariant ? variant : undefined);
const effectiveVariant = isColorVariant ? "solid" : variant;

const classNames = [
  "aui-btn",
  effectiveVariant ? `aui-btn-${effectiveVariant}` : "",
  effectiveColor ? `aui-btn-color-${effectiveColor}` : "",
  `aui-btn-${size}`,
  fullWidth ? "aui-btn-full" : "",
  className,
].filter(Boolean).join(" ");
---

{
  href ? (
    <a
      href={href}
      target={target}
      rel={target === "_blank" && !rel ? "noopener noreferrer" : rel}
      class={classNames}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button type="button" class={classNames} {...rest}>
      <slot />
    </button>
  )
}
