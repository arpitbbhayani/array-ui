---
interface Props {
  src?: string;
  title?: string;
  aspectRatio?: "16/9" | "4/3" | "1/1" | string;
  allowFullScreen?: boolean;
  className?: string;
  id?: string;
}

const {
  src,
  title = "Video player",
  aspectRatio = "16 / 9",
  allowFullScreen = true,
  className = "",
  id,
  ...props
} = Astro.props;
---

<div
  id={id}
  class={`aui-video-embed ${className}`}
  style={aspectRatio ? `aspect-ratio: ${aspectRatio};` : undefined}
  {...props}
>
  {src ? (
    <iframe
      src={src}
      title={title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen={allowFullScreen}
    />
  ) : (
    <slot />
  )}
</div>
