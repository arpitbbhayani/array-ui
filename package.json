{
  "name": "array-ui",
  "version": "0.1.6",
  "description": "Array UI (array-ui) - Typography-led, minimal design system inspired by arpitbhayani.me. Light/Dark themes, components, and tokens for Astro, Next.js, and any web project.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nextjs": {
      "types": "./dist/nextjs.d.ts",
      "import": "./dist/nextjs.js",
      "require": "./dist/nextjs.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/nextjs.js",
      "require": "./dist/nextjs.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./reactflow": {
      "types": "./dist/reactflow.d.ts",
      "import": "./dist/reactflow.js",
      "require": "./dist/reactflow.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind/index.d.ts",
      "import": "./dist/tailwind.js",
      "require": "./dist/tailwind.cjs"
    },
    "./shadcn": {
      "types": "./dist/shadcn/index.d.ts",
      "import": "./dist/shadcn.js",
      "require": "./dist/shadcn.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./lib/utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js",
      "require": "./dist/lib/utils.cjs"
    },
    "./astro/*": "./dist/astro/*",
    "./styles.css": "./dist/styles.css",
    "./shadcn.css": "./dist/shadcn.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./components.css": "./dist/components.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:registry": "tsx scripts/build-registry.ts",
    "build": "tsup && tsc --emitDeclarationOnly && npm run build:registry",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "dev": "npm run build:registry && astro dev --root demo --port 6145",
    "demo:build": "npm run build:registry && astro build --root demo",
    "demo:preview": "astro preview --root demo",
    "vercel-build": "npm run build && npm run demo:build",
    "cf:build": "npm run build && npm run demo:build",
    "cf:deploy": "npx wrangler pages deploy demo/dist"
  },
  "keywords": [
    "design-system",
    "react",
    "astro",
    "nextjs",
    "dark-mode",
    "arpitbhayani",
    "ui-components"
  ],
  "author": "Arpit Bhayani",
  "license": "MIT",
  "homepage": "https://ui.arpitbhayani.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpitbbhayani/aui.git"
  },
  "bugs": {
    "url": "https://github.com/arpitbbhayani/aui/issues"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@xyflow/react": "^12.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@xyflow/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/react": "^4.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@xyflow/react": "^12.12.0",
    "astro": "^5.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  }
}
